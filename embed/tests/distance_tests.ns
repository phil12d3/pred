[test]
cosine_similarity = func(t) {
    embed = import("./embed.ns");

    emb1 = embed.core.create(4, null);
    emb2 = embed.core.create(4, null);
    for (i = 0; i < 4; i = i + 1) {
        emb1 = embed.core.set(emb1, i, 1);
        emb2 = embed.core.set(emb2, i, 2);
    }
    emb1 = embed.core.normalize(emb1);
    emb2 = embed.core.normalize(emb2);

    sim = embed.distance.cosineSimilarity(emb1, emb2);
    t.truthy(sim > 0.9, "similar vectors have high cosine similarity");
};

[test]
euclidean_distance = func(t) {
    embed = import("./embed.ns");

    emb1 = embed.core.create(4, null);
    emb2 = embed.core.create(4, null);
    emb3 = embed.core.create(4, null);
    for (i = 0; i < 4; i = i + 1) {
        emb1 = embed.core.set(emb1, i, 1);
        emb2 = embed.core.set(emb2, i, 2);
    }
    for (i = 0; i < 2; i = i + 1) emb3 = embed.core.set(emb3, i, 0.1);
    for (i = 2; i < 4; i = i + 1) emb3 = embed.core.set(emb3, i, 5);
    emb1 = embed.core.normalize(emb1);
    emb2 = embed.core.normalize(emb2);
    emb3 = embed.core.normalize(emb3);

    dist1 = embed.distance.euclideanDistance(emb1, emb2);
    dist2 = embed.distance.euclideanDistance(emb1, emb3);
    t.truthy(dist2 > dist1, "more different vectors have larger distance");
};

[test]
manhattan_distance = func(t) {
    embed = import("./embed.ns");

    emb1 = embed.core.create(4, null);
    emb2 = embed.core.create(4, null);
    for (i = 0; i < 4; i = i + 1) {
        emb1 = embed.core.set(emb1, i, 1);
        emb2 = embed.core.set(emb2, i, 2);
    }
    emb1 = embed.core.normalize(emb1);
    emb2 = embed.core.normalize(emb2);

    dist = embed.distance.manhattanDistance(emb1, emb2);
    t.truthy(dist >= 0, "manhattan distance is non-negative");
};

