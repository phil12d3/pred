[test]
create_embedding = func(t) {
    embed = import("./embed.ns");

    emb = embed.core.create(8, null);
    t.equal(emb.dims, 8, "embedding has requested dimensions");
    t.equal(emb.values.count(), 8, "embedding has one value per dimension");
};

[test]
magnitude_calculation = func(t) {
    embed = import("./embed.ns");

    emb = embed.core.create(3, null);
    emb = embed.core.set(emb, 0, 3);
    emb = embed.core.set(emb, 1, 4);
    emb = embed.core.set(emb, 2, 0);

    mag = embed.core.magnitude(emb);
    diff = mag - 5;
    if (diff < 0) diff = 0 - diff;
    t.truthy(diff < 0.01, "magnitude of [3,4,0] is close to 5");
};

[test]
normalization = func(t) {
    embed = import("./embed.ns");

    emb = embed.core.create(4, null);
    for (i = 0; i < 4; i = i + 1) {
        emb = embed.core.set(emb, i, 1);
    }

    normalized = embed.core.normalize(emb);
    mag = embed.core.magnitude(normalized);
    diff = mag - 1;
    if (diff < 0) diff = 0 - diff;
    t.truthy(diff < 0.0001, "normalized vector has magnitude 1");
};

[test]
rescaling_normalization = func(t) {
    embed = import("./embed.ns");

    emb = embed.core.create(5, null);
    for (i = 0; i < 5; i = i + 1) {
        emb = embed.core.set(emb, i, i);
    }

    rescaled = embed.core.rescaleNorm(emb);
    stats = embed.core.stats(rescaled);
    t.truthy(stats.min >= -1.1, "rescaled min is within lower bound");
    t.truthy(stats.max <= 1.1, "rescaled max is within upper bound");
};

[test]
embedding_statistics = func(t) {
    embed = import("./embed.ns");

    emb = embed.core.create(5, null);
    for (i = 0; i < 5; i = i + 1) {
        emb = embed.core.set(emb, i, i);
    }

    stats = embed.core.stats(emb);
    meanDiff = stats.mean - 2;
    if (meanDiff < 0) meanDiff = 0 - meanDiff;
    t.equal(stats.count, 5, "stats includes count");
    t.truthy(meanDiff < 0.001, "stats includes mean");
};

[test]
embedding_copy = func(t) {
    embed = import("./embed.ns");

    emb1 = embed.core.create(4, null);
    emb1 = embed.core.set(emb1, 0, 0.5);
    emb2 = embed.core.copy(emb1);

    t.equal(emb2.values[0], 0.5, "copied value matches");
    t.equal(emb2.dims, emb1.dims, "copied dimensions match");
};

[test]
metadata_handling = func(t) {
    embed = import("./embed.ns");

    emb = embed.core.create(4, null);
    emb = embed.core.withMetadata(emb, "label", "test");

    t.equal(emb.metadata["label"], "test", "metadata is set");
};

[test]
zero_embedding = func(t) {
    embed = import("./embed.ns");

    emb = embed.core.zero(6);
    sum = 0;
    for (i = 0; i < 6; i = i + 1) {
        sum = sum + emb.values[i];
    }

    t.equal(emb.dims, 6, "zero embedding has requested dimensions");
    t.equal(sum, 0, "zero embedding values sum to zero");
};
