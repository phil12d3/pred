// distance.ns - Distance and similarity metrics using native matrices

core = import("./src/core.ns");

// Cosine similarity using native matrice
cosineSimilarity = func(emb1, emb2) {
    if (emb1.dims != emb2.dims) return 0;
    if (emb1.dims == 0) return 1;
    
    m1 = matrice_fromArray([emb1.values]);
    m2 = matrice_fromArray([emb2.values]);
    
    return m1.dotScalar(m2);
};

// Euclidean distance using native matrice
euclideanDistance = func(emb1, emb2) {
    if (emb1.dims != emb2.dims) return 999999;
    
    m1 = matrice_fromArray([emb1.values]);
    m2 = matrice_fromArray([emb2.values]);
    
    diff = m1.subtract(m2);
    return diff.norm();
};

// Manhattan distance using native matrice
manhattanDistance = func(emb1, emb2) {
    if (emb1.dims != emb2.dims) return 999999;
    
    m1 = matrice_fromArray([emb1.values]);
    m2 = matrice_fromArray([emb2.values]);
    
    diff = m1.subtract(m2);
    arr = diff.toArray()[0];
    
    sum = 0;
    for (i = 0; i < arr.count(); i = i + 1) {
        v = arr[i];
        if (v < 0) v = 0 - v;
        sum = sum + v;
    }
    
    return sum;
};

// Chebyshev distance: maximum absolute difference.
chebyshevDistance = func(emb1, emb2) {
    if (emb1.dims != emb2.dims) return 999999;
    
    maxDiff = 0;
    for (i = 0; i < emb1.dims; i = i + 1) {
        diff = emb1.values[i] - emb2.values[i];
        if (diff < 0) diff = 0 - diff;
        if (diff > maxDiff) maxDiff = diff;
    }
    
    return maxDiff;
};

// Minkowski distance: generalized distance metric.
minkowskiDistance = func(emb1, emb2, p) {
    if (emb1.dims != emb2.dims) return 999999;
    
    power = defined(p) ? p : 2;
    if (power < 1) power = 1;
    
    sum = 0;
    for (i = 0; i < emb1.dims; i = i + 1) {
        diff = emb1.values[i] - emb2.values[i];
        if (diff < 0) diff = 0 - diff;
        
        val = diff;
        for (j = 1; j < power; j = j + 1) {
            val = val * diff;
        }
        sum = sum + val;
    }
    
    // Compute p-th root
    result = sum;
    for (j = 1; j < power; j = j + 1) {
        result = core.sqrt(result);
    }
    
    return result;
};

// Hamming-like distance: count of significant differences.
// Uses threshold-based difference counting.
hammingDistance = func(emb1, emb2, threshold) {
    if (emb1.dims != emb2.dims) return 0;
    
    thresh = defined(threshold) ? threshold : 0.5;
    count = 0;
    
    for (i = 0; i < emb1.dims; i = i + 1) {
        diff = emb1.values[i] - emb2.values[i];
        if (diff < 0) diff = 0 - diff;
        if (diff > thresh) count = count + 1;
    }
    
    return count;
};

// Wasserstein distance: sliced optimal transport approximation.
wassersteinDistance = func(emb1, emb2) {
    if (emb1.dims != emb2.dims) return 0;
    
    // Sort both embeddings
    vals1 = [];
    vals2 = [];
    
    for (i = 0; i < emb1.dims; i = i + 1) {
        vals1.add(emb1.values[i]);
        vals2.add(emb2.values[i]);
    }
    
    vals1.sort(func(ai, av, bi, bv) => av - bv);
    vals2.sort(func(ai, av, bi, bv) => av - bv);
    
    // Sum of absolute differences of sorted values
    sum = 0;
    for (i = 0; i < vals1.count(); i = i + 1) {
        diff = vals1[i] - vals2[i];
        if (diff < 0) diff = 0 - diff;
        sum = sum + diff;
    }
    
    return sum / vals1.count();
};

// Determine similarity. Cosine returns raw cosine [-1, 1]; distance metrics return [0, 1].
similarity = func(emb1, emb2, metric) {
    method = defined(metric) ? metric : "cosine";
    
    if (method == "cosine") {
        return this.cosineSimilarity(emb1, emb2);
    } else if (method == "euclidean") {
        dist = this.euclideanDistance(emb1, emb2);
        // Convert distance to similarity: 1 / (1 + distance)
        return 1 / (1 + dist);
    } else if (method == "manhattan") {
        dist = this.manhattanDistance(emb1, emb2);
        return 1 / (1 + dist);
    } else {
        // Default to cosine
        return this.cosineSimilarity(emb1, emb2);
    }
};

// Find most similar embeddings from a list.
findMostSimilar = func(queryEmbedding, embeddingList, topK, metric) {
    method = defined(metric) ? metric : "cosine";
    k = defined(topK) ? topK : 5;
    
    if (embeddingList.count() == 0) return [];
    
    scores = [];
    for (i = 0; i < embeddingList.count(); i = i + 1) {
        emb = embeddingList[i];
        sim = this.similarity(queryEmbedding, emb, method);
        scores.add({index: i, embedding: emb, similarity: sim});
    }
    
    // Sort by similarity descending. Use a simple in-place pass because some
    // runtimes keep object arrays in insertion order with comparator sort.
    for (i = 0; i < scores.count(); i = i + 1) {
        best = i;
        for (j = i + 1; j < scores.count(); j = j + 1) {
            if (scores[j].similarity > scores[best].similarity) best = j;
        }
        if (best != i) {
            tmp = scores[i];
            scores[i] = scores[best];
            scores[best] = tmp;
        }
    }

    // Return top K
    result = [];
    for (i = 0; i < k && i < scores.count(); i = i + 1) {
        result.add(scores[i]);
    }
    
    return result;
};
