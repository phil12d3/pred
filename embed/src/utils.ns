// utils.ns - Utility functions for embeddings
// Note: All logic is fully inlined due to NS function scoping limitations.

// Batch normalize a list of embeddings
normalizeAll = func(embeddings) {
    result = [];
    for (i = 0; i < embeddings.count(); i = i + 1) {
        emb = embeddings[i];
        m = matrice_fromArray([emb.values]);
        mnorm = m.normalize();
        normed = mnorm.toArray()[0];
        
        clamped = [];
        for (k = 0; k < emb.dims; k = k + 1) {
            v = normed[k];
            if (v < -1) v = -1;
            if (v > 1) v = 1;
            clamped.add(v);
        }
        result.add({dims: emb.dims, values: clamped, id: emb.id, metadata: emb.metadata});
    }
    return result;
};

// Create embedding dictionary for fast lookup
createIndex = func(embeddings, keyField) {
    index = {};
    for (i = 0; i < embeddings.count(); i = i + 1) {
        emb = embeddings[i];
        key = defined(keyField) ? emb.metadata[keyField] : emb.id;
        if (defined(key)) {
            index[stringify(key)] = emb;
        }
    }
    return index;
};

// Find approximate nearest neighbors
approximateNearestNeighbor = func(queryEmbedding, embeddingList, k, metric) {
    results = [];
    for (i = 0; i < embeddingList.count(); i = i + 1) {
        // Inline cosine similarity
        dot = 0;
        n1 = 0;
        n2 = 0;
        for (d = 0; d < queryEmbedding.dims; d = d + 1) {
            a = queryEmbedding.values[d];
            b = embeddingList[i].values[d];
            dot = dot + a * b;
            n1 = n1 + a * a;
            n2 = n2 + b * b;
        }
        sim = 0;
        if (n1 > 0 && n2 > 0) {
            g1 = n1 / 2;
            for (iter = 0; iter < 15; iter = iter + 1) {
                nx = (g1 + n1 / g1) / 2;
                df = nx - g1;
                if (df < 0) df = 0 - df;
                g1 = nx;
                if (df < 0.001) iter = 15;
            }
            g2 = n2 / 2;
            for (iter = 0; iter < 15; iter = iter + 1) {
                nx = (g2 + n2 / g2) / 2;
                df = nx - g2;
                if (df < 0) df = 0 - df;
                g2 = nx;
                if (df < 0.001) iter = 15;
            }
            if (g1 > 0 && g2 > 0) sim = dot / (g1 * g2);
        }
        results.add({embedding: embeddingList[i], similarity: sim, index: i});
    }
    results.sort(func(ai, av, bi, bv) => bv.similarity - av.similarity);
    
    topK = defined(k) ? k : 1;
    output = [];
    for (i = 0; i < topK && i < results.count(); i = i + 1) {
        output.add(results[i]);
    }
    return output;
};

// Summarize a group of embeddings into one
summarize = func(embeddings) {
    if (embeddings.count() == 0) {
        zv = [];
        for (i = 0; i < 8; i = i + 1) {
            zv.add(0);
        }
        return {dims: 8, values: zv, id: "zero_sum", metadata: {}};
    }
    
    dims = embeddings[0].dims;
    totalWeight = 0;
    weights = [];
    for (i = 0; i < embeddings.count(); i = i + 1) {
        weight = (i + 1) / embeddings.count();
        weights.add(weight);
        totalWeight = totalWeight + weight;
    }
    
    resultValues = [];
    for (i = 0; i < dims; i = i + 1) {
        sum = 0;
        for (j = 0; j < embeddings.count(); j = j + 1) {
            sum = sum + (embeddings[j].values[i] * weights[j]);
        }
        resultValues.add(sum / totalWeight);
    }
    
    // Inline normalize
    m = matrice_fromArray([resultValues]);
    mnorm = m.normalize();
    normed = mnorm.toArray()[0];
    clamped = [];
    for (i = 0; i < dims; i = i + 1) {
        v = normed[i];
        if (v < -1) v = -1;
        if (v > 1) v = 1;
        clamped.add(v);
    }
    return {dims: dims, values: clamped, id: "summary", metadata: {}};
};

// Measure diversity/spread in a population of embeddings
diversity = func(embeddings) {
    if (embeddings.count() < 2) return 0;
    
    totalDist = 0;
    pairCount = 0;
    
    for (i = 0; i < embeddings.count() - 1; i = i + 1) {
        for (j = i + 1; j < embeddings.count(); j = j + 1) {
            // Inline euclidean distance
            sumSq = 0;
            for (d = 0; d < embeddings[i].dims; d = d + 1) {
                dv = embeddings[i].values[d] - embeddings[j].values[d];
                sumSq = sumSq + dv * dv;
            }
            dist = 0;
            if (sumSq > 0) {
                g = sumSq / 2;
                for (iter = 0; iter < 15; iter = iter + 1) {
                    nx = (g + sumSq / g) / 2;
                    df = nx - g;
                    if (df < 0) df = 0 - df;
                    g = nx;
                    if (df < 0.001) iter = 15;
                }
                dist = g;
            }
            totalDist = totalDist + dist;
            pairCount = pairCount + 1;
        }
    }
    
    return totalDist / (pairCount + 1);
};

// Cluster embeddings using simple distance-based clustering
cluster = func(embeddings, maxDist, metric) {
    if (embeddings.count() == 0) return [];
    
    threshold = defined(maxDist) ? maxDist : 0.5;
    
    clusters = [];
    assigned = [];
    for (k = 0; k < embeddings.count(); k = k + 1) {
        assigned.add(false);
    }
    
    for (i = 0; i < embeddings.count(); i = i + 1) {
        if (assigned[i]) continue;
        
        clust = [embeddings[i]];
        assigned[i] = true;
        
        for (j = i + 1; j < embeddings.count(); j = j + 1) {
            if (assigned[j]) continue;
            
            // Inline cosine similarity
            dot = 0;
            n1 = 0;
            n2 = 0;
            for (d = 0; d < embeddings[i].dims; d = d + 1) {
                a = embeddings[i].values[d];
                b = embeddings[j].values[d];
                dot = dot + a * b;
                n1 = n1 + a * a;
                n2 = n2 + b * b;
            }
            sim = 0;
            if (n1 > 0 && n2 > 0) {
                g1 = n1 / 2;
                for (iter = 0; iter < 15; iter = iter + 1) {
                    nx = (g1 + n1 / g1) / 2;
                    df = nx - g1;
                    if (df < 0) df = 0 - df;
                    g1 = nx;
                    if (df < 0.001) iter = 15;
                }
                g2 = n2 / 2;
                for (iter = 0; iter < 15; iter = iter + 1) {
                    nx = (g2 + n2 / g2) / 2;
                    df = nx - g2;
                    if (df < 0) df = 0 - df;
                    g2 = nx;
                    if (df < 0.001) iter = 15;
                }
                if (g1 > 0 && g2 > 0) sim = dot / (g1 * g2);
            }
            
            if (sim > (1 - threshold)) {
                clust.add(embeddings[j]);
                assigned[j] = true;
            }
        }
        
        clusters.add(clust);
    }
    
    return clusters;
};

// Compute centroid of a cluster
centroid = func(embeddingCluster) {
    if (embeddingCluster.count() == 0) {
        zv = [];
        for (i = 0; i < 8; i = i + 1) {
            zv.add(0);
        }
        return {dims: 8, values: zv, id: "zero_centroid", metadata: {}};
    }
    
    dims = embeddingCluster[0].dims;
    resultValues = [];
    
    for (d = 0; d < dims; d = d + 1) {
        sum = 0;
        for (i = 0; i < embeddingCluster.count(); i = i + 1) {
            sum = sum + embeddingCluster[i].values[d];
        }
        resultValues.add(sum / embeddingCluster.count());
    }
    
    // Inline normalize
    m = matrice_fromArray([resultValues]);
    mnorm = m.normalize();
    normed = mnorm.toArray()[0];
    clamped = [];
    for (i = 0; i < dims; i = i + 1) {
        v = normed[i];
        if (v < -1) v = -1;
        if (v > 1) v = 1;
        clamped.add(v);
    }
    return {dims: dims, values: clamped, id: "centroid", metadata: {}};
};

// Filter embeddings by similarity to a query
filterBySimilarity = func(embeddings, queryEmbedding, minSimilarity, metric) {
    threshold = defined(minSimilarity) ? minSimilarity : 0.7;
    
    result = [];
    for (i = 0; i < embeddings.count(); i = i + 1) {
        // Inline cosine similarity
        dot = 0;
        n1 = 0;
        n2 = 0;
        for (d = 0; d < queryEmbedding.dims; d = d + 1) {
            a = queryEmbedding.values[d];
            b = embeddings[i].values[d];
            dot = dot + a * b;
            n1 = n1 + a * a;
            n2 = n2 + b * b;
        }
        sim = 0;
        if (n1 > 0 && n2 > 0) {
            g1 = n1 / 2;
            for (iter = 0; iter < 15; iter = iter + 1) {
                nx = (g1 + n1 / g1) / 2;
                df = nx - g1;
                if (df < 0) df = 0 - df;
                g1 = nx;
                if (df < 0.001) iter = 15;
            }
            g2 = n2 / 2;
            for (iter = 0; iter < 15; iter = iter + 1) {
                nx = (g2 + n2 / g2) / 2;
                df = nx - g2;
                if (df < 0) df = 0 - df;
                g2 = nx;
                if (df < 0.001) iter = 15;
            }
            if (g1 > 0 && g2 > 0) sim = dot / (g1 * g2);
        }
        if (sim >= threshold) {
            result.add(embeddings[i]);
        }
    }
    return result;
};

// Transform all embeddings in batch
batchTransform = func(embeddings, transformFunc) {
    result = [];
    for (i = 0; i < embeddings.count(); i = i + 1) {
        transformed = transformFunc(embeddings[i]);
        result.add(transformed);
    }
    return result;
};

// Convert embeddings to a matrix representation
toMatrix = func(embeddings) {
    if (embeddings.count() == 0) return [];
    
    matrix = [];
    for (i = 0; i < embeddings.count(); i = i + 1) {
        matrix.add(embeddings[i].values);
    }
    return matrix;
};

// Compare two embedding populations
comparePopulations = func(pop1, pop2) {
    if (pop1.count() == 0 || pop2.count() == 0) {
        return {similarity: 0, diversity1: 0, diversity2: 0};
    }
    
    dims = pop1[0].dims;
    
    // Average embeddings from pop1
    avg1Values = [];
    for (i = 0; i < dims; i = i + 1) {
        sum = 0;
        for (j = 0; j < pop1.count(); j = j + 1) {
            sum = sum + pop1[j].values[i];
        }
        avg1Values.add(sum / pop1.count());
    }
    m1 = matrice_fromArray([avg1Values]);
    mn1 = m1.normalize();
    avg1 = {dims: dims, values: mn1.toArray()[0], id: "avg1", metadata: {}};
    
    // Average embeddings from pop2
    avg2Values = [];
    for (i = 0; i < dims; i = i + 1) {
        sum = 0;
        for (j = 0; j < pop2.count(); j = j + 1) {
            sum = sum + pop2[j].values[i];
        }
        avg2Values.add(sum / pop2.count());
    }
    m2 = matrice_fromArray([avg2Values]);
    mn2 = m2.normalize();
    avg2 = {dims: dims, values: mn2.toArray()[0], id: "avg2", metadata: {}};
    
    // Compare centroids - inline cosine
    dot = 0;
    n1 = 0;
    n2 = 0;
    for (d = 0; d < dims; d = d + 1) {
        a = avg1.values[d];
        b = avg2.values[d];
        dot = dot + a * b;
        n1 = n1 + a * a;
        n2 = n2 + b * b;
    }
    simScore = 0;
    if (n1 > 0 && n2 > 0) {
        g1 = n1 / 2;
        for (iter = 0; iter < 15; iter = iter + 1) {
            nx = (g1 + n1 / g1) / 2;
            df = nx - g1;
            if (df < 0) df = 0 - df;
            g1 = nx;
            if (df < 0.001) iter = 15;
        }
        g2 = n2 / 2;
        for (iter = 0; iter < 15; iter = iter + 1) {
            nx = (g2 + n2 / g2) / 2;
            df = nx - g2;
            if (df < 0) df = 0 - df;
            g2 = nx;
            if (df < 0.001) iter = 15;
        }
        if (g1 > 0 && g2 > 0) simScore = dot / (g1 * g2);
    }
    
    // Diversity pop1
    totalDist1 = 0;
    pairCount1 = 0;
    for (i = 0; i < pop1.count() - 1; i = i + 1) {
        for (j = i + 1; j < pop1.count(); j = j + 1) {
            sumSq = 0;
            for (d = 0; d < dims; d = d + 1) {
                dv = pop1[i].values[d] - pop1[j].values[d];
                sumSq = sumSq + dv * dv;
            }
            dist = 0;
            if (sumSq > 0) {
                g = sumSq / 2;
                for (iter = 0; iter < 15; iter = iter + 1) {
                    nx = (g + sumSq / g) / 2;
                    df = nx - g;
                    if (df < 0) df = 0 - df;
                    g = nx;
                    if (df < 0.001) iter = 15;
                }
                dist = g;
            }
            totalDist1 = totalDist1 + dist;
            pairCount1 = pairCount1 + 1;
        }
    }
    div1 = pairCount1 > 0 ? totalDist1 / pairCount1 : 0;
    
    // Diversity pop2
    totalDist2 = 0;
    pairCount2 = 0;
    for (i = 0; i < pop2.count() - 1; i = i + 1) {
        for (j = i + 1; j < pop2.count(); j = j + 1) {
            sumSq = 0;
            for (d = 0; d < dims; d = d + 1) {
                dv = pop2[i].values[d] - pop2[j].values[d];
                sumSq = sumSq + dv * dv;
            }
            dist = 0;
            if (sumSq > 0) {
                g = sumSq / 2;
                for (iter = 0; iter < 15; iter = iter + 1) {
                    nx = (g + sumSq / g) / 2;
                    df = nx - g;
                    if (df < 0) df = 0 - df;
                    g = nx;
                    if (df < 0.001) iter = 15;
                }
                dist = g;
            }
            totalDist2 = totalDist2 + dist;
            pairCount2 = pairCount2 + 1;
        }
    }
    div2 = pairCount2 > 0 ? totalDist2 / pairCount2 : 0;
    
    return {similarity: simScore, diversity1: div1, diversity2: div2};
};
