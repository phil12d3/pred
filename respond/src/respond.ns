defaultConfig = func() {
    return {
        dimensions: 12,
        semanticWindow: 2,
        vocabLimit: 128,
        segmentLimit: 5,
        evidenceLimit: 5,
        topicLimit: 3,
        parentTopicLimit: 4,
        parentDepth: 2,
        answerEvidenceLimit: 2,
        fuzzyThreshold: 0.82,
        intentRules: [],
        scoreWeights: {
            evidence: 0.45,
            embedding: 0.3,
            lexical: 0.15,
            topic: 0.1
        },
        intentLabels: {
            capability_of: "capability_check",
            attribute_of: "attribute_query",
            category_of: "define",
            compare_topics: "compare",
            related_to: "relation_query",
            explain_topic: "explain"
        }
    };
}

asText = func(value) {
    if (!defined(value) || value == null) return "";
    if (type(value).typename == "String") return value;
    return stringify(value);
}

copyArray = func(values) {
    out = [];
    if (!defined(values) || values == null) return out;
    for (i = 0; i < values.count(); i = i + 1) out.add(values[i]);
    return out;
}

sortRowsDesc = func(rows, keyName) {
    out = this.copyArray(rows);
    for (i = 0; i < out.count(); i = i + 1) {
        best = i;
        for (j = i + 1; j < out.count(); j = j + 1) {
            if (out[j][keyName] > out[best][keyName]) best = j;
        }
        if (best != i) {
            tmp = out[i];
            out[i] = out[best];
            out[best] = tmp;
        }
    }
    return out;
}

normalize = func(text) {
    if (!defined(text) || text == null) return "";
    if (type(text).typename == "String") return text;
    return stringify(text);
}

splitPath = func(path) {
    parts = [];
    current = "";
    value = this.asText(path);
    for (i = 0; i < value.length; i = i + 1) {
        ch = value[i];
        if (ch == "/") {
            parts.add(current);
            current = "";
        } else {
            current = current + ch;
        }
    }
    parts.add(current);
    return parts;
}

ensureDirectory = func(path) {
    if (!defined(path) || path == null || path == "" || path == ".") return true;
    parts = this.splitPath(path);
    current = "";
    isAbsolute = this.asText(path).length > 0 && this.asText(path)[0] == "/";
    if (isAbsolute) current = "/";
    for (i = 0; i < parts.count(); i = i + 1) {
        part = parts[i];
        if (!defined(part) || part == "" || part == ".") continue;
        if (current == "") current = "./" + part;
        else if (current == "/") current = "/" + part;
        else current = current + "/" + part;
        if (!exists(current)) mkdir(current);
    }
    return true;
}

ensureParentDirectory = func(path) {
    parts = this.splitPath(path);
    if (parts.count() <= 1) return true;
    dir = "";
    value = this.asText(path);
    isAbsolute = value.length > 0 && value[0] == "/";
    if (isAbsolute) dir = "/";
    for (i = 0; i < parts.count() - 1; i = i + 1) {
        part = parts[i];
        if (!defined(part) || part == "" || part == ".") continue;
        if (dir == "") dir = "./" + part;
        else if (dir == "/") dir = "/" + part;
        else dir = dir + "/" + part;
    }
    return this.ensureDirectory(dir);
}

lines = func(text) {
    s = this.normalize(text);
    rows = [];
    line = "";
    for (i = 0; i < s.length; i = i + 1) {
        ch = s[i];
        if (ch == "\n") {
            rows.add(line);
            line = "";
        } else {
            line = line + ch;
        }
    }
    rows.add(line);
    return rows;
}

toLowerText = func(text) {
    s = this.normalize(text);
    out = "";
    for (i = 0; i < s.length; i = i + 1) {
        ch = s[i];
        if (ch == "A") ch = "a";
        else if (ch == "B") ch = "b";
        else if (ch == "C") ch = "c";
        else if (ch == "D") ch = "d";
        else if (ch == "E") ch = "e";
        else if (ch == "F") ch = "f";
        else if (ch == "G") ch = "g";
        else if (ch == "H") ch = "h";
        else if (ch == "I") ch = "i";
        else if (ch == "J") ch = "j";
        else if (ch == "K") ch = "k";
        else if (ch == "L") ch = "l";
        else if (ch == "M") ch = "m";
        else if (ch == "N") ch = "n";
        else if (ch == "O") ch = "o";
        else if (ch == "P") ch = "p";
        else if (ch == "Q") ch = "q";
        else if (ch == "R") ch = "r";
        else if (ch == "S") ch = "s";
        else if (ch == "T") ch = "t";
        else if (ch == "U") ch = "u";
        else if (ch == "V") ch = "v";
        else if (ch == "W") ch = "w";
        else if (ch == "X") ch = "x";
        else if (ch == "Y") ch = "y";
        else if (ch == "Z") ch = "z";
        out = out + ch;
    }
    return out;
}

tokens = func(text) {
    s = this.toLowerText(text);
    out = [];
    word = "";
    for (i = 0; i < s.length; i = i + 1) {
        ch = s[i];
        isAsciiAlphaNum = (ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9");
        isSeparator = ch == " " || ch == "\n" || ch == "\t" || ch == "\r" ||
                      ch == "." || ch == "," || ch == "!" || ch == "?" ||
                      ch == ";" || ch == ":" || ch == "(" || ch == ")" ||
                      ch == "[" || ch == "]" || ch == "{" || ch == "}" ||
                      ch == "\"" || ch == "'" || ch == "/" || ch == "\\" ||
                      ch == "|" || ch == "-" || ch == "_" || ch == "+" ||
                      ch == "=" || ch == "*" || ch == "&" || ch == "^" ||
                      ch == "%" || ch == "$" || ch == "#" || ch == "@" ||
                      ch == "<" || ch == ">" || ch == "~" || ch == "`" ||
                      ch == "。" || ch == "、" || ch == "！" || ch == "？" || ch == "・";
        if (isAsciiAlphaNum || !isSeparator) {
            word = word + ch;
        } else {
            if (word != "") {
                out.add(word);
                word = "";
            }
        }
    }
    if (word != "") out.add(word);
    return out;
}

normalizeToken = func(token) {
    word = this.toLowerText(token);
    if (word.length > 3 && word[word.length - 1] == "s") {
        stem = "";
        for (i = 0; i < word.length - 1; i = i + 1) stem = stem + word[i];
        return stem;
    }
    return word;
}

normalizeTokens = func(tokens) {
    out = [];
    for (i = 0; i < tokens.count(); i = i + 1) out.add(this.normalizeToken(tokens[i]));
    return out;
}

uniqueTokens = func(tokens) {
    out = [];
    seen = {};
    for (i = 0; i < tokens.count(); i = i + 1) {
        token = tokens[i];
        if (defined(seen[token])) continue;
        seen[token] = true;
        out.add(token);
    }
    return out;
}

joinTokens = func(tokens, startIndex) {
    start = defined(startIndex) ? startIndex : 0;
    text = "";
    for (i = start; i < tokens.count(); i = i + 1) {
        if (text != "") text = text + " ";
        text = text + tokens[i];
    }
    return text;
}

normalizeDocs = func(corpusInput) {
    docs = [];
    if (!defined(corpusInput) || corpusInput == null) return docs;

    if (defined(corpusInput.count) && type(corpusInput).typename != "String") {
        for (i = 0; i < corpusInput.count(); i = i + 1) {
            text = this.asText(corpusInput[i]);
            if (this.tokens(text).count() > 0) docs.add(text);
        }
        return docs;
    }

    text = this.asText(corpusInput);
    rawLines = this.lines(text);
    nonEmpty = [];
    for (i = 0; i < rawLines.count(); i = i + 1) {
        line = this.asText(rawLines[i]);
        if (this.tokens(line).count() == 0) continue;
        nonEmpty.add(line);
    }
    if (nonEmpty.count() > 1) return nonEmpty;
    if (this.tokens(text).count() > 0) docs.add(text);
    return docs;
}

buildSegments = func(docs) {
    rows = [];
    for (di = 0; di < docs.count(); di = di + 1) {
        text = this.asText(docs[di]);
        current = "";
        localIndex = 0;
        for (i = 0; i < text.length; i = i + 1) {
            ch = text[i];
            isBoundary = ch == "." || ch == "!" || ch == "?" || ch == ";" || ch == "\n";
            if (isBoundary) {
                toks = this.tokens(current);
                if (toks.count() > 0) {
                    rows.add({
                        docIndex: di,
                        segmentIndex: localIndex,
                        text: current,
                        tokens: toks,
                        normalizedTokens: this.normalizeTokens(toks)
                    });
                    localIndex = localIndex + 1;
                }
                current = "";
            } else {
                current = current + ch;
            }
        }

        tail = this.tokens(current);
        if (tail.count() > 0) {
            rows.add({
                docIndex: di,
                segmentIndex: localIndex,
                text: current,
                tokens: tail,
                normalizedTokens: this.normalizeTokens(tail)
            });
        }
    }
    return rows;
}

containsToken = func(tokens, target) {
    for (i = 0; i < tokens.count(); i = i + 1) {
        if (tokens[i] == target) return true;
    }
    return false;
}

splitSegments = func(text) {
    segments = [];
    current = "";
    s = this.asText(text);
    for (i = 0; i < s.length; i = i + 1) {
        ch = s[i];
        boundary = ch == "." || ch == "!" || ch == "?" || ch == ";" || ch == "\n";
        if (boundary) {
            toks = this.tokens(current);
            if (toks.count() > 0) segments.add(current);
            current = "";
        } else {
            current = current + ch;
        }
    }
    tailToks = this.tokens(current);
    if (tailToks.count() > 0) segments.add(current);
    return segments;
}

semanticCoOccurrence = func(docs, windowSize) {
    win = defined(windowSize) ? windowSize : 2;
    if (win < 1) win = 1;

    matrix = {};
    for (di = 0; di < docs.count(); di = di + 1) {
        segments = this.splitSegments(docs[di]);
        if (segments.count() == 0) segments.add(docs[di]);

        for (si = 0; si < segments.count(); si = si + 1) {
            toks = this.normalizeTokens(this.tokens(segments[si]));
            for (i = 0; i < toks.count(); i = i + 1) {
                w = toks[i];
                if (!defined(matrix[w])) matrix[w] = {};
                start = i - win;
                if (start < 0) start = 0;
                finish = i + win;
                if (finish > toks.count() - 1) finish = toks.count() - 1;
                for (j = start; j <= finish; j = j + 1) {
                    if (j == i) continue;
                    other = toks[j];
                    if (!defined(matrix[w][other])) matrix[w][other] = 0;
                    matrix[w][other] = matrix[w][other] + 1;
                }
            }
        }
    }
    return matrix;
}

wordCounts = func(docs) {
    counts = {};
    total = 0;
    for (di = 0; di < docs.count(); di = di + 1) {
        toks = this.normalizeTokens(this.tokens(docs[di]));
        for (ti = 0; ti < toks.count(); ti = ti + 1) {
            word = toks[ti];
            if (!defined(counts[word])) counts[word] = 0;
            counts[word] = counts[word] + 1;
            total = total + 1;
        }
    }
    return {counts: counts, total: total};
}

buildVocabulary = func(docs, cooc, limit) {
    counts = this.wordCounts(docs);
    rows = [];
    foreach(word in counts.counts.props) {
        if (!defined(cooc[word])) continue;
        rows.add({word: word, count: counts.counts[word]});
    }
    rows = this.sortRowsDesc(rows, "count");

    maxItems = defined(limit) ? limit : rows.count();
    vocab = [];
    for (i = 0; i < rows.count() && i < maxItems; i = i + 1) vocab.add(rows[i].word);
    return vocab;
}

createEmbedding = func(dimensions, seedId) {
    dims = dimensions < 1 ? 1 : dimensions;
    values = [];
    for (i = 0; i < dims; i = i + 1) values.add(0);
    return {dims: dims, values: values, id: defined(seedId) ? seedId : "emb", metadata: {}};
}

normalizeEmbedding = func(embedding) {
    if (!defined(embedding) || embedding == null || embedding.values.count() == 0) return embedding;
    m = matrice_fromArray([embedding.values]);
    normed = m.normalize().toArray()[0];
    values = [];
    for (i = 0; i < normed.count(); i = i + 1) values.add(normed[i]);
    return {dims: embedding.dims, values: values, id: embedding.id, metadata: embedding.metadata};
}

embeddingFromFrequencies = func(freqMap, dimensions) {
    emb = this.createEmbedding(dimensions, "freq_emb");
    rows = [];
    total = 0;
    foreach(key in freqMap.props) {
        rows.add({key: key, freq: freqMap[key]});
        total = total + freqMap[key];
    }
    if (rows.count() == 0) return emb;
    rows = this.sortRowsDesc(rows, "freq");
    for (d = 0; d < dimensions; d = d + 1) {
        value = 0;
        for (i = 0; i < rows.count(); i = i + 1) {
            weight = total == 0 ? 0 : rows[i].freq / total;
            seed = (d + 1 + i) * 1103515245 + 12345;
            hashValue = (seed % 2147483648) / 2147483648;
            value = value + (weight * hashValue);
        }
        emb.values[d] = rows.count() == 0 ? 0 : value / rows.count();
    }
    return this.normalizeEmbedding(emb);
}

embeddingFromCoOccurrence = func(cooc, term, dimensions) {
    emb = this.createEmbedding(dimensions, "cooc_emb");
    if (!defined(cooc[term])) return emb;

    contextPairs = [];
    total = 0;
    foreach(contextTerm in cooc[term].props) {
        count = cooc[term][contextTerm];
        contextPairs.add({term: contextTerm, count: count});
        total = total + count;
    }
    if (contextPairs.count() == 0) return emb;
    contextPairs = this.sortRowsDesc(contextPairs, "count");

    limit = dimensions * 2;
    for (i = 0; i < contextPairs.count() && i < limit; i = i + 1) {
        pair = contextPairs[i];
        weight = total == 0 ? 0 : pair.count / total;
        seed = 0;
        for (j = 0; j < pair.term.length; j = j + 1) {
            ch = pair.term[j];
            charValue = (ch >= "a" && ch <= "z") ? ((ch - "a") + 1) : 1;
            seed = seed + (charValue * (j + 1));
        }
        idx1 = seed % dimensions;
        idx2 = ((seed * 7) + pair.term.length) % dimensions;
        emb.values[idx1] = emb.values[idx1] + weight;
        emb.values[idx2] = emb.values[idx2] + (weight * 0.5);
    }
    return this.normalizeEmbedding(emb);
}

cosineSimilarity = func(emb1, emb2) {
    if (emb1.dims != emb2.dims) return 0;
    if (emb1.dims == 0) return 1;
    m1 = matrice_fromArray([emb1.values]);
    m2 = matrice_fromArray([emb2.values]);
    return m1.dotScalar(m2);
}

averageEmbeddings = func(embeddings, dimensions, idValue) {
    emb = this.createEmbedding(dimensions, idValue);
    if (!defined(embeddings) || embeddings == null || embeddings.count() == 0) return emb;
    count = 0;
    for (i = 0; i < embeddings.count(); i = i + 1) {
        item = embeddings[i];
        if (!defined(item) || item == null) continue;
        count = count + 1;
        for (j = 0; j < dimensions; j = j + 1) emb.values[j] = emb.values[j] + item.values[j];
    }
    if (count == 0) return emb;
    for (i = 0; i < dimensions; i = i + 1) emb.values[i] = emb.values[i] / count;
    return this.normalizeEmbedding(emb);
}

buildTermEmbeddings = func(vocab, cooc, dimensions) {
    map = {};
    for (i = 0; i < vocab.count(); i = i + 1) map[vocab[i]] = this.embeddingFromCoOccurrence(cooc, vocab[i], dimensions);
    return map;
}

embeddingForTokens = func(system, tokens, idValue) {
    normalized = this.uniqueTokens(this.normalizeTokens(tokens));
    parts = [];
    for (i = 0; i < normalized.count(); i = i + 1) {
        token = normalized[i];
        if (defined(system.termEmbeddings[token])) parts.add(system.termEmbeddings[token]);
        else if (defined(system.cooc[token])) parts.add(this.embeddingFromCoOccurrence(system.cooc, token, system.config.dimensions));
    }
    if (parts.count() > 0) return this.averageEmbeddings(parts, system.config.dimensions, idValue);

    freqMap = {};
    for (i = 0; i < normalized.count(); i = i + 1) freqMap[normalized[i]] = 1;
    return this.embeddingFromFrequencies(freqMap, system.config.dimensions);
}

buildSegmentRows = func(segments, system) {
    rows = [];
    for (i = 0; i < segments.count(); i = i + 1) {
        row = segments[i];
        rows.add({
            docIndex: row.docIndex,
            segmentIndex: row.segmentIndex,
            text: this.asText(row.text),
            tokens: row.tokens,
            normalizedTokens: row.normalizedTokens,
            embedding: this.embeddingForTokens(system, row.tokens, "segment_" + stringify(i))
        });
    }
    return rows;
}

pairRows = func(segmentRows) {
    rows = [];
    for (i = 0; i < segmentRows.count(); i = i + 1) {
        tokens = segmentRows[i].normalizedTokens;
        if (tokens.count() < 2) continue;
        left = tokens[0];
        right = tokens[tokens.count() - 1];
        bridgeTokens = [];
        for (j = 1; j < tokens.count() - 1; j = j + 1) bridgeTokens.add(tokens[j]);
        rows.add({
            left: left,
            right: right,
            bridge: this.joinTokens(bridgeTokens, 0),
            bridgeTokens: bridgeTokens,
            text: this.asText(segmentRows[i].text),
            docIndex: segmentRows[i].docIndex,
            segmentIndex: segmentRows[i].segmentIndex
        });
    }
    return rows;
}

arrayContains = func(values, target) {
    for (i = 0; i < values.count(); i = i + 1) {
        if (values[i] == target) return true;
    }
    return false;
}

bridgeKind = func(bridgeRow, leftCounts) {
    rightAsLeft = 0;
    for (i = 0; i < bridgeRow.rightSet.count(); i = i + 1) {
        word = bridgeRow.rightSet[i];
        if (defined(leftCounts[word])) rightAsLeft = rightAsLeft + 1;
    }
    pairCount = bridgeRow.pairs.count();
    uniqueLeft = bridgeRow.leftSet.count();
    uniqueRight = bridgeRow.rightSet.count();
    subjectReuse = uniqueRight > 0 ? rightAsLeft / uniqueRight : 0;
    leftDiversity = pairCount > 0 ? uniqueLeft / pairCount : 0;
    rightDiversity = pairCount > 0 ? uniqueRight / pairCount : 0;

    if (subjectReuse >= 0.34) return "category_of";
    if (pairCount >= 2 && leftDiversity >= 0.75 && rightDiversity >= 0.5) return "capability_of";
    if (pairCount >= 2 && leftDiversity <= 0.5 && rightDiversity >= 0.5 && subjectReuse < 0.2) return "explain_topic";
    if (pairCount == 1 && bridgeRow.bridgeTokens.count() >= 1) return "attribute_of";
    return "related_to";
}

buildBridgeProfiles = func(pairRows) {
    profiles = {};
    leftCounts = {};

    for (i = 0; i < pairRows.count(); i = i + 1) {
        row = pairRows[i];
        if (!defined(leftCounts[row.left])) leftCounts[row.left] = 0;
        leftCounts[row.left] = leftCounts[row.left] + 1;

        key = row.bridge;
        if (!defined(profiles[key])) {
            profiles[key] = {
                bridge: row.bridge,
                bridgeTokens: row.bridgeTokens,
                pairs: [],
                leftSet: [],
                rightSet: []
            };
        }
        profiles[key].pairs.add(row);
        if (!this.arrayContains(profiles[key].leftSet, row.left)) profiles[key].leftSet.add(row.left);
        if (!this.arrayContains(profiles[key].rightSet, row.right)) profiles[key].rightSet.add(row.right);
    }

    rows = [];
    foreach(key in profiles.props) {
        profile = profiles[key];
        rows.add({
            bridge: profile.bridge,
            bridgeTokens: profile.bridgeTokens,
            pairs: profile.pairs,
            leftSet: profile.leftSet,
            rightSet: profile.rightSet,
            kind: this.bridgeKind(profile, leftCounts),
            pairCount: profile.pairs.count()
        });
    }
    return rows;
}

deriveRelations = func(pairRows, bridgeProfiles, bridgeMap) {
    categoryRows = [];
    capabilityRows = [];
    attributeRows = [];
    explainRows = [];
    for (i = 0; i < pairRows.count(); i = i + 1) {
        row = pairRows[i];
        profile = bridgeMap[row.bridge];
        if (!defined(profile)) continue;
        if (profile.kind == "category_of") {
            categoryRows.add({topic: row.left, parent: row.right, text: row.text, bridge: row.bridge});
        } else if (profile.kind == "capability_of") {
            capabilityRows.add({topic: row.left, action: row.right, text: row.text, bridge: row.bridge});
        } else if (profile.kind == "attribute_of") {
            attributeRows.add({topic: row.left, attribute: row.right, text: row.text, bridge: row.bridge});
        } else if (profile.kind == "explain_topic") {
            explainRows.add({topic: row.left, detail: row.right, text: row.text, bridge: row.bridge});
        }
    }
    return {
        categoryRows: categoryRows,
        capabilityRows: capabilityRows,
        attributeRows: attributeRows,
        explainRows: explainRows
    };
}

levenshteinDistance = func(a, b) {
    s1 = stringify(a);
    s2 = stringify(b);
    m = s1.length;
    n = s2.length;
    if (m == 0) return n;
    if (n == 0) return m;

    prev = [];
    curr = [];
    for (j = 0; j <= n; j = j + 1) prev.add(j);

    for (i = 1; i <= m; i = i + 1) {
        curr = [i];
        c1 = s1[i - 1];
        for (j = 1; j <= n; j = j + 1) {
            c2 = s2[j - 1];
            cost = c1 == c2 ? 0 : 1;
            del = prev[j] + 1;
            ins = curr[j - 1] + 1;
            sub = prev[j - 1] + cost;
            best = del;
            if (ins < best) best = ins;
            if (sub < best) best = sub;
            curr.add(best);
        }
        prev = curr;
    }
    return prev[n];
}

tokenSimilarity = func(a, b, threshold) {
    if (a == b) return 1;
    s1 = stringify(a);
    s2 = stringify(b);
    maxLen = s1.length > s2.length ? s1.length : s2.length;
    if (maxLen == 0) return 1;
    d = this.levenshteinDistance(s1, s2);
    score = 1 - (d / maxLen);
    if (score < 0) score = 0;
    if (score > 1) score = 1;
    return score >= threshold ? score : 0;
}

filterNonTopicTokens = func(tokens, topics, threshold) {
    out = [];
    for (i = 0; i < tokens.count(); i = i + 1) {
        tok = tokens[i];
        matched = false;
        for (j = 0; j < topics.count(); j = j + 1) {
            if (tok == topics[j].word || tok == topics[j].corpusWord) matched = true;
            else if (this.tokenSimilarity(tok, topics[j].corpusWord, threshold) > 0) matched = true;
        }
        if (!matched) out.add(tok);
    }
    return out;
}

relationMatchRows = func(inputTokens, relationRows, threshold) {
    matches = [];
    for (i = 0; i < relationRows.count(); i = i + 1) {
        best = 0;
        for (j = 0; j < inputTokens.count(); j = j + 1) {
            sim = this.tokenSimilarity(inputTokens[j], relationRows[i].word, threshold);
            if (sim > best) best = sim;
        }
        if (best > 0) {
            matches.add({
                word: relationRows[i].word,
                relationScore: defined(relationRows[i].score) ? relationRows[i].score : 0,
                matchScore: best
            });
        }
    }
    return matches;
}

scoreTopics = func(system, inputTokens) {
    normalized = this.uniqueTokens(this.normalizeTokens(inputTokens));
    rows = [];
    foreach(word in system.topicIndex.props) {
        score = 0;
        if (this.containsToken(normalized, word)) score = score + 1.2;
        if (defined(system.cooc[word])) {
            foreach(other in system.cooc[word].props) {
                if (this.containsToken(normalized, other)) score = score + 0.2;
            }
        }
        if (score > 0) rows.add({word: word, corpusWord: word, score: score});
    }

    if (rows.count() == 0) {
        for (i = 0; i < normalized.count(); i = i + 1) {
            token = normalized[i];
            if (!defined(system.termEmbeddings[token])) continue;
            rows.add({word: token, corpusWord: token, score: 0.4});
        }
    }

    rows = this.sortRowsDesc(rows, "score");
    return this.sliceRows(rows, system.config.topicLimit);
}

parentTopics = func(system, topics) {
    rows = [];
    seen = {};
    for (i = 0; i < topics.count(); i = i + 1) {
        topic = topics[i].word;
        if (!defined(system.parentIndex[topic])) continue;
        parent = system.parentIndex[topic];
        key = topic + "|" + parent;
        if (defined(seen[key])) continue;
        seen[key] = true;
        rows.add({word: parent, fromTopic: topic, score: topics[i].score * 0.8});
    }
    return rows;
}

topTopicRelations = func(system, topicWord) {
    rows = [];
    for (i = 0; i < system.pairRows.count(); i = i + 1) {
        if (system.pairRows[i].left == topicWord || system.pairRows[i].right == topicWord) rows.add(system.pairRows[i]);
    }
    return rows;
}

buildRelationRequests = func(system, inputTokens, topics) {
    if (topics.count() == 0) return [];
    tokens = this.uniqueTokens(this.normalizeTokens(inputTokens));
    nonTopicTokens = this.filterNonTopicTokens(tokens, topics, system.config.fuzzyThreshold);
    requests = [];
    selectedWords = [];
    for (i = 0; i < topics.count(); i = i + 1) selectedWords.add(topics[i].corpusWord);

    for (i = 0; i < system.bridgeProfiles.count(); i = i + 1) {
        profile = system.bridgeProfiles[i];
        bridgeRows = [];
        for (bi = 0; bi < profile.bridgeTokens.count(); bi = bi + 1) bridgeRows.add({word: profile.bridgeTokens[bi], score: 1});
        bridgeMatches = this.relationMatchRows(nonTopicTokens, bridgeRows, system.config.fuzzyThreshold);
        if (bridgeMatches.count() == 0) continue;

        for (j = 0; j < profile.pairs.count(); j = j + 1) {
            pair = profile.pairs[j];
            if (!this.arrayContains(selectedWords, pair.left) && !this.arrayContains(selectedWords, pair.right)) continue;
            topicWord = this.arrayContains(selectedWords, pair.left) ? pair.left : pair.right;
            requests.add({
                relation: profile.kind,
                topics: [topicWord],
                score: bridgeMatches[0].matchScore + profile.pairCount + (this.arrayContains(selectedWords, pair.left) ? 0.5 : 0),
                evidence: [{word: profile.bridge, relationScore: profile.pairCount, matchScore: bridgeMatches[0].matchScore}]
            });
        }
    }

    if (requests.count() == 0 && topics.count() >= 2) {
        for (i = 0; i < system.pairRows.count(); i = i + 1) {
            pair = system.pairRows[i];
            if (!this.arrayContains(selectedWords, pair.left)) continue;
            if (!this.arrayContains(selectedWords, pair.right)) continue;
            profile = system.bridgeMap[pair.bridge];
            requests.add({
                relation: defined(profile) ? profile.kind : "related_to",
                topics: [pair.left],
                score: topics[0].score + topics[1].score + 1,
                evidence: [{word: pair.bridge, relationScore: 1, matchScore: 1}]
            });
        }
    }

    if (requests.count() == 0 && topics.count() >= 2) {
        requests.add({
            relation: "compare_topics",
            topics: [topics[0].word, topics[1].word],
            score: (topics[0].score + topics[1].score) * 0.5,
            evidence: []
        });
    }

    if (requests.count() == 0 && topics.count() == 1) {
        rels = this.topTopicRelations(system, topics[0].corpusWord);
        categoryPairs = [];
        explainPairs = [];
        for (i = 0; i < rels.count(); i = i + 1) {
            profile = system.bridgeMap[rels[i].bridge];
            if (defined(profile) && profile.kind == "category_of" && rels[i].left == topics[0].corpusWord) categoryPairs.add(rels[i]);
            if (defined(profile) && profile.kind == "explain_topic" && rels[i].left == topics[0].corpusWord) explainPairs.add(rels[i]);
        }
        if (categoryPairs.count() > 0) {
            requests.add({relation: "category_of", topics: [topics[0].word], score: topics[0].score, evidence: [{word: categoryPairs[0].bridge, relationScore: 1, matchScore: 1}]});
        } else if (explainPairs.count() > 0) {
            requests.add({relation: "explain_topic", topics: [topics[0].word], score: topics[0].score, evidence: [{word: explainPairs[0].bridge, relationScore: 1, matchScore: 1}]});
        } else {
            requests.add({relation: "related_to", topics: [topics[0].word], score: topics[0].score, evidence: []});
        }
    }

    requests = this.sortRowsDesc(requests, "score");
    return requests;
}

intentFromRelations = func(relationRequests) {
    if (relationRequests.count() == 0) return "explore";
    return relationRequests[0].relation;
}

ruleValueList = func(value) {
    out = [];
    if (!defined(value) || value == null) return out;
    if (type(value).typename == "String") {
        out.add(value);
        return out;
    }
    if (!defined(value.count)) return out;
    for (i = 0; i < value.count(); i = i + 1) out.add(value[i]);
    return out;
}

ruleWordSet = func(rows) {
    set = {};
    for (i = 0; i < rows.count(); i = i + 1) {
        if (defined(rows[i].word)) set[rows[i].word] = true;
        if (defined(rows[i].corpusWord)) set[rows[i].corpusWord] = true;
    }
    return set;
}

normalizeRuleItem = func(item) {
    if (type(item).typename == "String") return {kind: "word", value: item};
    return item;
}

matchRuleItem = func(item, token, context) {
    rule = this.normalizeRuleItem(item);
    if (!defined(rule.kind)) {
        if (defined(rule.value)) return token == rule.value;
        return false;
    }
    if (rule.kind == "any") return true;
    if (rule.kind == "word") return token == rule.value;
    if (rule.kind == "oneOf") {
        words = this.ruleValueList(rule.words);
        for (i = 0; i < words.count(); i = i + 1) {
            if (token == words[i]) return true;
        }
        return false;
    }
    if (rule.kind == "topic") return defined(context.topicSet[token]);
    if (rule.kind == "parentTopic") return defined(context.parentTopicSet[token]);
    return false;
}

matchRuleSequenceAt = func(tokens, pattern, tokenIndex, patternIndex, context) {
    if (patternIndex >= pattern.count()) return true;
    item = this.normalizeRuleItem(pattern[patternIndex]);

    if (defined(item.kind) && item.kind == "wildcard") {
        for (i = tokenIndex; i <= tokens.count(); i = i + 1) {
            if (this.matchRuleSequenceAt(tokens, pattern, i, patternIndex + 1, context)) return true;
        }
        return false;
    }

    if (defined(item.kind) && item.kind == "optional") {
        if (this.matchRuleSequenceAt(tokens, pattern, tokenIndex, patternIndex + 1, context)) return true;
        if (tokenIndex < tokens.count() && this.matchRuleItem(item.item, tokens[tokenIndex], context)) {
            return this.matchRuleSequenceAt(tokens, pattern, tokenIndex + 1, patternIndex + 1, context);
        }
        return false;
    }

    for (i = tokenIndex; i < tokens.count(); i = i + 1) {
        if (this.matchRuleItem(item, tokens[i], context)) {
            return this.matchRuleSequenceAt(tokens, pattern, i + 1, patternIndex + 1, context);
        }
    }
    return false;
}

matchRuleSequence = func(tokens, pattern, context) {
    if (!defined(pattern) || pattern == null) return true;
    if (pattern.count() == 0) return true;
    return this.matchRuleSequenceAt(tokens, pattern, 0, 0, context);
}

matchIntentRule = func(rule, inputTokens, topics, parentTopics, relationRequests) {
    if (!defined(rule)) return null;
    if (!defined(rule.label) && !defined(rule.relation)) return null;

    context = {
        topicSet: this.ruleWordSet(topics),
        parentTopicSet: this.ruleWordSet(parentTopics)
    };

    if (defined(rule.containsAny) && rule.containsAny != null) {
        ok = false;
        words = this.ruleValueList(rule.containsAny);
        for (i = 0; i < words.count(); i = i + 1) {
            if (this.arrayContains(inputTokens, words[i])) ok = true;
        }
        if (!ok) return null;
    }

    if (defined(rule.containsAll) && rule.containsAll != null) {
        words = this.ruleValueList(rule.containsAll);
        for (i = 0; i < words.count(); i = i + 1) {
            if (!this.arrayContains(inputTokens, words[i])) return null;
        }
    }

    if (defined(rule.containsNone) && rule.containsNone != null) {
        words = this.ruleValueList(rule.containsNone);
        for (i = 0; i < words.count(); i = i + 1) {
            if (this.arrayContains(inputTokens, words[i])) return null;
        }
    }

    if (defined(rule.sequence) && rule.sequence != null) {
        if (!this.matchRuleSequence(inputTokens, rule.sequence, context)) return null;
    }

    if (defined(rule.relationAny) && rule.relationAny != null) {
        relOk = false;
        rels = this.ruleValueList(rule.relationAny);
        for (i = 0; i < relationRequests.count(); i = i + 1) {
            for (j = 0; j < rels.count(); j = j + 1) {
                if (relationRequests[i].relation == rels[j]) relOk = true;
            }
        }
        if (!relOk) return null;
    }

    if (defined(rule.relationAll) && rule.relationAll != null) {
        rels = this.ruleValueList(rule.relationAll);
        for (i = 0; i < rels.count(); i = i + 1) {
            relFound = false;
            for (j = 0; j < relationRequests.count(); j = j + 1) {
                if (relationRequests[j].relation == rels[i]) relFound = true;
            }
            if (!relFound) return null;
        }
    }

    return {
        label: defined(rule.label) ? rule.label : "",
        relation: defined(rule.relation) ? rule.relation : "",
        priority: defined(rule.priority) ? rule.priority : 0,
        rule: rule
    };
}

matchIntentRules = func(system, inputTokens, topics, parentTopics, relationRequests) {
    matches = [];
    rules = defined(system.config.intentRules) && system.config.intentRules != null ? system.config.intentRules : [];
    for (i = 0; i < rules.count(); i = i + 1) {
        matched = this.matchIntentRule(rules[i], inputTokens, topics, parentTopics, relationRequests);
        if (defined(matched) && matched != null) matches.add(matched);
    }
    matches = this.sortRowsDesc(matches, "priority");
    return matches;
}

applyRuleRelationOverride = func(ruleMatch, relationRequests, topics) {
    if (!defined(ruleMatch) || ruleMatch == null || !defined(ruleMatch.relation) || ruleMatch.relation == "") return relationRequests;
    topicLabels = [];
    if (topics.count() > 0) topicLabels.add(topics[0].word);
    out = [{
        relation: ruleMatch.relation,
        topics: topicLabels,
        score: relationRequests.count() > 0 ? relationRequests[0].score + 0.001 : 1,
        evidence: []
    }];
    for (i = 0; i < relationRequests.count(); i = i + 1) out.add(relationRequests[i]);
    return out;
}

topicWordMap = func(rows) {
    out = {};
    for (i = 0; i < rows.count(); i = i + 1) {
        if (defined(rows[i].word)) out[rows[i].word] = true;
    }
    return out;
}

tokenOverlap = func(queryTokens, segmentTokens) {
    if (!defined(queryTokens) || queryTokens.count() == 0) return 0;
    query = this.uniqueTokens(this.normalizeTokens(queryTokens));
    segment = this.uniqueTokens(this.normalizeTokens(segmentTokens));
    hits = 0;
    for (i = 0; i < query.count(); i = i + 1) {
        if (this.containsToken(segment, query[i])) hits = hits + 1;
    }
    return query.count() == 0 ? 0 : hits / query.count();
}

topicHitScore = func(segmentTokens, topicWords, parentWords) {
    segment = this.uniqueTokens(this.normalizeTokens(segmentTokens));
    hits = 0;
    for (i = 0; i < segment.count(); i = i + 1) {
        token = segment[i];
        if (defined(topicWords[token])) hits = hits + 1;
        else if (defined(parentWords[token])) hits = hits + 0.5;
    }
    return hits > 1 ? 1 : hits;
}

sliceRows = func(rows, limit) {
    out = [];
    maxItems = defined(limit) ? limit : rows.count();
    for (i = 0; i < rows.count() && i < maxItems; i = i + 1) out.add(rows[i]);
    return out;
}

buildEvidence = func(system, topics, queryTokens, limit) {
    topicWords = this.topicWordMap(topics);
    rows = [];
    for (i = 0; i < system.segments.count(); i = i + 1) {
        segment = system.segments[i];
        overlap = this.tokenOverlap(queryTokens, segment.tokens);
        topicScore = this.topicHitScore(segment.tokens, topicWords, {});
        score = (overlap * 0.6) + (topicScore * 0.4);
        if (score <= 0) continue;
        rows.add({
            text: segment.text,
            score: score,
            overlap: overlap,
            topicScore: topicScore
        });
    }
    rows = this.sortRowsDesc(rows, "score");
    return this.sliceRows(rows, limit);
}

analyze = func(system, inputText, limit) {
    maxTopics = defined(limit) ? limit : system.config.topicLimit;
    inputTokens = this.tokens(inputText);
    normalizedInputTokens = this.uniqueTokens(this.normalizeTokens(inputTokens));
    topics = this.scoreTopics(system, inputTokens);
    topics = this.sliceRows(topics, maxTopics);
    parents = this.parentTopics(system, topics);
    relationRequests = this.buildRelationRequests(system, inputTokens, topics);
    ruleMatches = this.matchIntentRules(system, normalizedInputTokens, topics, parents, relationRequests);
    matchedRule = ruleMatches.count() > 0 ? ruleMatches[0] : null;
    relationRequests = this.applyRuleRelationOverride(matchedRule, relationRequests, topics);
    relationKind = this.intentFromRelations(relationRequests);
    finalIntent = defined(system.config.intentLabels[relationKind]) ? system.config.intentLabels[relationKind] : "explore";
    if (defined(matchedRule) && matchedRule != null && defined(matchedRule.label) && matchedRule.label != "") finalIntent = matchedRule.label;
    evidence = this.buildEvidence(system, topics, inputTokens, system.config.evidenceLimit);
    return {
        input: inputText,
        topics: topics,
        parentTopics: parents,
        relationsRequested: relationRequests,
        rulesMatched: ruleMatches,
        matchedRule: matchedRule,
        intent: finalIntent,
        intentSource: defined(matchedRule) && matchedRule != null ? "rule" : "relation",
        evidence: {
            inputKeywords: normalizedInputTokens,
            matchingSegments: evidence,
            parentSegments: []
        }
    };
}

evidenceScoreMap = func(rows) {
    out = {};
    for (i = 0; i < rows.count(); i = i + 1) out[this.asText(rows[i].text)] = rows[i].score;
    return out;
}

clamp01 = func(value) {
    if (value < 0) return 0;
    if (value > 1) return 1;
    return value;
}

rankSegments = func(system, analysis, queryTokens, queryEmbedding, limit) {
    weights = system.config.scoreWeights;
    topicWords = this.topicWordMap(analysis.topics);
    parentWords = this.topicWordMap(analysis.parentTopics);
    evidenceScores = this.evidenceScoreMap(analysis.evidence.matchingSegments);

    ranked = [];
    for (i = 0; i < system.segments.count(); i = i + 1) {
        segment = system.segments[i];
        lexical = this.tokenOverlap(queryTokens, segment.tokens);
        topicScore = this.topicHitScore(segment.tokens, topicWords, parentWords);
        embedScore = (this.cosineSimilarity(queryEmbedding, segment.embedding) + 1) / 2;
        embedScore = this.clamp01(embedScore);
        evidenceScore = defined(evidenceScores[segment.text]) ? evidenceScores[segment.text] : 0;
        finalScore = (weights.evidence * evidenceScore) +
                     (weights.embedding * embedScore) +
                     (weights.lexical * lexical) +
                     (weights.topic * topicScore);

        ranked.add({
            text: segment.text,
            score: finalScore,
            lexicalScore: lexical,
            embeddingScore: embedScore,
            evidenceScore: evidenceScore,
            topicScore: topicScore,
            docIndex: segment.docIndex,
            segmentIndex: segment.segmentIndex
        });
    }

    ranked = this.sortRowsDesc(ranked, "score");
    out = [];
    for (i = 0; i < ranked.count() && i < limit; i = i + 1) {
        row = ranked[i];
        row.rank = i + 1;
        out.add(row);
    }
    return out;
}

ensureSentence = func(text) {
    value = this.asText(text);
    if (value == "") return value;
    last = value[value.length - 1];
    if (last == "." || last == "!" || last == "?") return value;
    return value + ".";
}

joinCandidateTexts = func(candidates, limit) {
    maxItems = defined(limit) ? limit : candidates.count();
    text = "";
    for (i = 0; i < candidates.count() && i < maxItems; i = i + 1) {
        if (text != "") text = text + " ";
        text = text + this.ensureSentence(candidates[i].text);
    }
    return text;
}

topicLabel = func(analysis) {
    if (!defined(analysis) || !defined(analysis.topics) || analysis.topics.count() == 0) return "";
    return this.asText(analysis.topics[0].word);
}

findRelationAnswer = func(system, analysis) {
    topic = this.topicLabel(analysis);
    if (topic == "") return "";

    if (analysis.intent == "define") {
        for (i = 0; i < system.relations.categoryRows.count(); i = i + 1) {
            row = system.relations.categoryRows[i];
            if (row.topic == topic) return this.ensureSentence(row.text);
        }
    }

    if (analysis.intent == "capability_check") {
        for (i = 0; i < system.relations.capabilityRows.count(); i = i + 1) {
            row = system.relations.capabilityRows[i];
            if (row.topic == topic) return this.ensureSentence(row.text);
        }
    }

    if (analysis.intent == "attribute_query") {
        for (i = 0; i < system.relations.attributeRows.count(); i = i + 1) {
            row = system.relations.attributeRows[i];
            if (row.topic == topic) return this.ensureSentence(row.text);
        }
    }

    return "";
}

composeAnswer = func(system, result) {
    analysis = result.analysis;
    candidates = result.candidates;
    topic = this.topicLabel(analysis);
    relationAnswer = this.findRelationAnswer(system, analysis);

    if (!defined(candidates) || candidates.count() == 0) {
        return "I could not ground a response for \"" + result.input + "\" in the current corpus.";
    }

    if (analysis.intent == "compare") {
        if (candidates.count() > 1) return "Closest comparison evidence: " + this.ensureSentence(candidates[0].text) + " " + this.ensureSentence(candidates[1].text);
        return "Closest comparison evidence: " + this.ensureSentence(candidates[0].text);
    }

    if (analysis.intent == "explore") return "Closest evidence I found: " + this.ensureSentence(candidates[0].text);

    if (analysis.intent == "explain") {
        if (topic != "") return topic + ": " + this.joinCandidateTexts(candidates, 2);
        return this.joinCandidateTexts(candidates, 2);
    }

    if (analysis.intent == "define" || analysis.intent == "capability_check" ||
        analysis.intent == "attribute_query" || analysis.intent == "relation_query") {
        if (relationAnswer != "") {
            if (candidates.count() > 0 && this.ensureSentence(candidates[0].text) != relationAnswer && candidates[0].score > 0.35) {
                return relationAnswer + " " + this.ensureSentence(candidates[0].text);
            }
            return relationAnswer;
        }
        if (candidates.count() > 1 && candidates[1].score > 0.35) return this.ensureSentence(candidates[0].text) + " " + this.ensureSentence(candidates[1].text);
        return this.ensureSentence(candidates[0].text);
    }

    return this.ensureSentence(candidates[0].text);
}

train = func(corpusInput, config) {
    cfg = defined(config) && config != null ? config : this.defaultConfig();
    docs = this.normalizeDocs(corpusInput);
    rawSegments = this.buildSegments(docs);
    pairRows = this.pairRows(rawSegments);
    bridgeProfiles = this.buildBridgeProfiles(pairRows);
    bridgeMap = {};
    for (i = 0; i < bridgeProfiles.count(); i = i + 1) bridgeMap[bridgeProfiles[i].bridge] = bridgeProfiles[i];
    relations = this.deriveRelations(pairRows, bridgeProfiles, bridgeMap);
    cooc = this.semanticCoOccurrence(docs, cfg.semanticWindow);
    vocab = this.buildVocabulary(docs, cooc, cfg.vocabLimit);
    termEmbeddings = this.buildTermEmbeddings(vocab, cooc, cfg.dimensions);

    topicIndex = {};
    parentIndex = {};
    for (i = 0; i < relations.categoryRows.count(); i = i + 1) {
        row = relations.categoryRows[i];
        topicIndex[row.topic] = true;
        if (defined(row.parent)) topicIndex[row.parent] = true;
        if (defined(row.parent)) parentIndex[row.topic] = row.parent;
    }
    for (i = 0; i < relations.capabilityRows.count(); i = i + 1) topicIndex[relations.capabilityRows[i].topic] = true;
    for (i = 0; i < relations.attributeRows.count(); i = i + 1) topicIndex[relations.attributeRows[i].topic] = true;

    system = {
        config: cfg,
        docs: docs,
        cooc: cooc,
        vocab: vocab,
        termEmbeddings: termEmbeddings,
        pairRows: pairRows,
        bridgeProfiles: bridgeProfiles,
        bridgeMap: bridgeMap,
        relations: relations,
        topicIndex: topicIndex,
        parentIndex: parentIndex,
        segments: []
    };
    system.segments = this.buildSegmentRows(rawSegments, system);
    return system;
}

saveSystem = func(system, path) {
    if (!defined(system) || system == null) throw("respond.saveSystem requires a trained system");
    this.ensureParentDirectory(path);
    model = {
        kind: "respond.system",
        version: 1,
        payload: system,
        metadata: {
            documents: defined(system.docs) ? system.docs.count() : 0,
            segments: defined(system.segments) ? system.segments.count() : 0,
            vocabTerms: defined(system.vocab) ? system.vocab.count() : 0,
            bridgeProfiles: defined(system.bridgeProfiles) ? system.bridgeProfiles.count() : 0
        }
    };
    compress_to_file(model, path);
    return {
        path: path,
        saved: true,
        kind: model.kind,
        version: model.version,
        metadata: model.metadata
    };
}

loadSystem = func(path) {
    model = decompress_from_file(path);
    if (!defined(model) || model == null) throw("respond.loadSystem could not load model from " + this.asText(path));
    if (defined(model.kind) && model.kind == "respond.system") {
        if (!defined(model.version) || model.version != 1) {
            throw("respond.loadSystem does not support model version " + stringify(model.version));
        }
        if (!defined(model.payload) || model.payload == null) throw("respond.loadSystem found no payload in " + this.asText(path));
        return model.payload;
    }
    return model;
}

answer = func(system, inputText, limit) {
    maxItems = defined(limit) ? limit : system.config.segmentLimit;
    analysis = this.analyze(system, inputText, system.config.topicLimit);
    queryTokens = this.tokens(inputText);
    queryEmbedding = this.embeddingForTokens(system, queryTokens, "query");
    candidates = this.rankSegments(system, analysis, queryTokens, queryEmbedding, maxItems);

    result = {
        input: inputText,
        intent: analysis.intent,
        analysis: analysis,
        queryTokens: queryTokens,
        candidates: candidates,
        answer: ""
    };
    result.answer = this.composeAnswer(system, result);
    return result;
}

reply = func(system, inputText, limit) {
    return this.answer(system, inputText, limit);
}

render = func(result) {
    lines = [];
    lines.add("Input: " + this.asText(result.input));
    lines.add("Intent: " + this.asText(result.intent));
    lines.add("Answer: " + this.asText(result.answer));
    lines.add("");
    lines.add("Top evidence:");
    for (i = 0; i < result.candidates.count(); i = i + 1) {
        row = result.candidates[i];
        lines.add(stringify(row.rank) + ". score=" + stringify(row.score) + " text=" + this.asText(row.text));
    }
    return lines;
}
