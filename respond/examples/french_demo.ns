respond = import("./respond.ns").respond;

corpus = "
caniche est chien
chien est animal
caniche a pelage bouclé
chien peut nager
oiseau peut voler
facture est document de facturation
page de facturation permet télécharger facture
";

system = respond.train(corpus, respond.defaultConfig());

queries = [
    "caniche est quoi",
    "chien peut nager",
    "facture est quoi"
];

printline("=== respond french demo ===");
printline("");

for (i = 0; i < queries.count(); i = i + 1) {
    result = respond.answer(system, queries[i], 3);
    printline("Query: ", queries[i]);
    printline("Intent: ", result.intent);
    printline("Answer: ", result.answer);
    printline("Topics: ", result.analysis.topics);
    printline("");
}
