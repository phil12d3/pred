respond = import("./respond.ns").respond;

corpus = "
poodles are dogs
dogs are animals
poodles have curly coats
poodles are known for intelligence
dogs can swim
invoices belong to billing
billing pages let users download invoices
";

system = respond.train(corpus, respond.defaultConfig());

queries = [
    "what is a poodle",
    "can dogs swim",
    "tell me about invoices"
];

for (i = 0; i < queries.count(); i = i + 1) {
    result = respond.answer(system, queries[i], 3);
    lines = respond.render(result);
    for (j = 0; j < lines.count(); j = j + 1) printline(lines[j]);
    printline("");
}
