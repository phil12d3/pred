// Role: query, entity, action, modifier, connector
// Type: person, object, place, time, action, attribute, concept, unknown

language = import("english.ns");

processWord = func(word) {
    if (length(word) == 0) return;
    lowerWord = toLower(word);

    result = language.words.first(func(i,v) => v.word == lowerWord);
    return result;
}

parse = func(text) {
    seperator = [" ", ",", ".", "?"];
    word = "";
    results = [];

    for(i=0; i < length(text); i++) {
        c = text[i]
        if (seperator.contains(func(i,v) => v == c)) {
            result = processWord(word);
            if (result != null) results.add(result);
            word = "";
            continue;
        }
        word = word + text[i];
    }
    if (length(word)) {
        result = processWord(word);
        if (result != null) results.add(result);
    }

    return results;
}

getIntent = func(words) {
    foreach( rule in language.rules) {
        patterns = getRulePatterns(rule);
        values = matchPatternValues(words, patterns, 0, 0);
        if (values != null) {
            return {
                match: rule,
                values: values
            };
        }
    }

    return null;
}

refineIntent = func(intent) {
    if (!defined(intent) || intent == null) return null;

    refined = matchIntentRule(intent);
    if (refined != null) {
        return refined;
    }

    return intent;
}

matchIntentRule = func(intent) {
    if (!defined(intent) || intent == null) return null;
    if (!defined(language.intentRules) || language.intentRules == null) return null;
    if (!defined(intent.match) || intent.match == null) return null;

    foreach (rule in language.intentRules) {
        if (defined(rule.match) && rule.match != null && rule.match != intent.match.intent) {
            continue;
        }

        patterns = getIntentRulePatterns(rule);
        if (!defined(patterns) || patterns == null) {
            continue;
        }

        if (matchPatternValues(intent.values, patterns, 0, 0) != null) {
            return {
                intent: rule.intent,
                base: intent,
                match: intent.match,
                rule: rule,
                values: intent.values
            };
        }
    }

    return null;
}

findIntentValue = func(intent, source) {
    if (!defined(intent) || intent == null) return null;
    if (!defined(intent.values) || intent.values == null) return null;

    for (i = 0; i < intent.values.count(); i = i + 1) {
        value = intent.values[i];
        if (matchesPatternObject(value, source, false)) {
            return value;
        }
    }

    return null;
}

resolveIntent = func(intent) {
    if (!defined(intent) || intent == null) return null;
    if (!defined(language.resolver) || language.resolver == null) return null;

    refined = intent;
    if (!defined(refined.intent) || refined.intent == null) {
        refined = refineIntent(intent);
    }
    if (!defined(refined) || refined == null) return null;

    foreach (resolver in language.resolver) {
        if (defined(resolver.intent) && resolver.intent == refined.intent) {
            data = resolveIntentData(refined, resolver);
            return {
                tool: resolver.tool,
                data: data,
                intent: refined
            };
        }
    }

    return null;
}

getIntentRulePatterns = func(rule) {
    if (!defined(rule) || rule == null) return null;
    if (defined(rule.pattern) && rule.pattern != null) return rule.pattern;
    return null;
}

resolveIntentData = func(intent, resolver) {
    if (!defined(intent) || intent == null) return null;
    if (!defined(intent.values) || intent.values == null) return null;
    if (!defined(resolver) || resolver == null) return null;

    if (defined(resolver.sources) && resolver.sources != null) {
        data = [];
        for (i = 0; i < resolver.sources.count(); i = i + 1) {
            source = resolver.sources[i];
            value = findIntentValue(intent, source);
            data.add(value);
        }
        return data;
    }

    return null;
}

matchesRule = func(words, rule) {
    if (!defined(words) || words == null) return false;
    if (!defined(rule) || rule == null) return false;
    patterns = getRulePatterns(rule);
    if (!defined(patterns) || patterns == null) return false;
    return matchPatternValues(words, patterns, 0, 0) != null;
}

getRulePatterns = func(rule) {
    if (defined(rule.pattern) && rule.pattern != null) return rule.pattern;
    return null;
}

matchesPatternPosition = func(word, position) {
    if (!defined(word) || word == null) return false;
    if (!defined(position) || position == null) return false;

    items = getPatternItems(position);
    positionLowercase = isLowercasePosition(position);

    // An empty array is a wildcard for this position.
    if (items.count() == 0) return true;

    for (i = 0; i < items.count(); i = i + 1) {
        if (matchesPatternObject(word, items[i], positionLowercase)) {
            return true;
        }
    }

    return false;
}

matchPatternValues = func(words, patterns, wordIndex, patternIndex) {
    if (!defined(patterns) || patterns == null) return null;

    if (patternIndex == patterns.count()) {
        if (defined(words) && words != null && wordIndex != words.count()) return null;
        return [];
    }

    position = patterns[patternIndex];
    optional = defined(position.optional) && position.optional == true;

    if (optional) {
        if (defined(words) && words != null && wordIndex < words.count() && matchesPatternPosition(words[wordIndex], position)) {
            consumed = matchPatternValues(words, patterns, wordIndex + 1, patternIndex + 1);
            if (consumed != null) {
                values = [];
                values.add(words[wordIndex]);
                for (i = 0; i < consumed.count(); i = i + 1) {
                    values.add(consumed[i]);
                }
                return values;
            }
        }

        skipped = matchPatternValues(words, patterns, wordIndex, patternIndex + 1);
        if (skipped != null) {
            values = [];
            values.add(null);
            for (i = 0; i < skipped.count(); i = i + 1) {
                values.add(skipped[i]);
            }
            return values;
        }
    }

    if (!defined(words) || words == null) return null;
    if (wordIndex >= words.count()) return null;
    if (!matchesPatternPosition(words[wordIndex], position)) return null;

    rest = matchPatternValues(words, patterns, wordIndex + 1, patternIndex + 1);
    if (rest == null) return null;

    values = [];
    values.add(words[wordIndex]);
    for (i = 0; i < rest.count(); i = i + 1) {
        values.add(rest[i]);
    }
    return values;
}

getPatternItems = func(position) {
    if (!defined(position) || position == null) return [];

    if (defined(position.items) && position.items != null) {
        return position.items;
    }

    if (defined(position.count)) {
        return position;
    }

    return [position];
}

isLowercasePosition = func(position) {
    if (!defined(position) || position == null) return false;
    if (defined(position.lowercase) && position.lowercase == true) return true;
    return false;
}

matchesPatternObject = func(word, slot, positionLowercase) {
    if (!defined(word) || word == null) return false;
    if (!defined(slot) || slot == null) return false;

    hasWord = (defined(slot.word) && slot.word != null) || (defined(slot.words) && slot.words != null);
    hasRole = (defined(slot.role) && slot.role != null) || (defined(slot.roles) && slot.roles != null);
    hasType = (defined(slot.type) && slot.type != null) || (defined(slot.types) && slot.types != null);
    hasQualifier = (defined(slot.qualifier) && slot.qualifier != null) || (defined(slot.qualifiers) && slot.qualifiers != null);
    lowercase = defined(slot.lowercase) ? (slot.lowercase == true) : positionLowercase;

    if (!hasWord && !hasRole && !hasType && !hasQualifier) return true;

    if (hasWord && !matchesAnyValue(word.word, slot.word, slot.words, lowercase)) {
        return false;
    }

    if (hasRole && !matchesAnyValue(word.role, slot.role, slot.roles, false)) {
        return false;
    }

    if (hasType && !matchesAnyValue(word.type, slot.type, slot.types, false)) {
        return false;
    }

    if (hasQualifier && !matchesAnyValue(word.qualifier, slot.qualifier, slot.qualifiers, false)) {
        return false;
    }

    return true;
}

matchesAnyValue = func(value, singleValue, values, lowercase) {
    if (!defined(value) || value == null) return false;

    compareValue = value;
    if (defined(lowercase) && lowercase == true) {
        compareValue = toLower(compareValue);
    }

    if (defined(singleValue) && singleValue != null) {
        if (defined(lowercase) && lowercase == true) {
            return compareValue == toLower(singleValue);
        }
        return compareValue == singleValue;
    }

    if (!defined(values) || values == null) return false;
    if (defined(lowercase) && lowercase == true) {
        return values.contains(func(i, v) => compareValue == toLower(v));
    }
    return values.contains(func(i, v) => v == value);
}

text = "what are dogs"

words = parse(text);
intent = getIntent(words);
refinedIntent = refineIntent(intent);
resolved = resolveIntent(refinedIntent);

printraw(resolved);
