tokenize = import("./src/tokenize.ns");
utils = import("./src/utils.ns");

isCorpus = func(value) {
    return defined(value) && value != null && defined(value.docs) && defined(value.docs.count);
}

asCorpus = func(value) {
    if (this.isCorpus(value)) return value;
    return this.from(value);
}

tokenRows = func(corpus) {
    rows = [];
    source = this.asCorpus(corpus);
    for (di = 0; di < source.docs.count(); di = di + 1) {
        rows.add(this.tokenize.tokens(source.docs[di]));
    }
    return rows;
}

documentFrequencies = func(corpus) {
    source = this.asCorpus(corpus);
    freqs = {};
    for (di = 0; di < source.docs.count(); di = di + 1) {
        toks = this.tokenize.uniqueTokens(source.docs[di]);
        for (ti = 0; ti < toks.count(); ti = ti + 1) {
            word = toks[ti];
            if (!defined(freqs[word])) freqs[word] = 0;
            freqs[word] = freqs[word] + 1;
        }
    }
    return freqs;
}

countsFromTokens = func(tokens) {
    counts = {};
    total = 0;
    for (i = 0; i < tokens.count(); i = i + 1) {
        word = tokens[i];
        if (!defined(counts[word])) counts[word] = 0;
        counts[word] = counts[word] + 1;
        total = total + 1;
    }
    return {counts: counts, total: total};
}

scoreRows = func(rows, keyName) {
    return this.utils.sortByNumberDesc(rows, keyName);
}

sortRowsByText = func(rows, keyName) {
    copy = this.utils.copyArray(rows);
    copy.sort(func(ai, av, bi, bv) => av[keyName] < bv[keyName]);
    return copy;
}

topRows = func(rows, limit) {
    maxItems = defined(limit) ? limit : rows.count();
    if (maxItems < 0) maxItems = 0;
    out = [];
    for (i = 0; i < rows.count() && i < maxItems; i = i + 1) out.add(rows[i]);
    return out;
}

joinWords = func(tokens) {
    text = "";
    for (i = 0; i < tokens.count(); i = i + 1) {
        if (i > 0) text = text + " ";
        text = text + tokens[i];
    }
    return text;
}

uniqueWords = func(tokens) {
    out = [];
    seen = {};
    for (i = 0; i < tokens.count(); i = i + 1) {
        word = tokens[i];
        if (defined(seen[word])) continue;
        seen[word] = true;
        out.add(word);
    }
    return out;
}

kwicRows = func(corpus, word, windowSize) {
    source = this.asCorpus(corpus);
    target = this.tokenize.toLowerText(word);
    win = defined(windowSize) ? windowSize : 4;
    if (win < 0) win = 0;

    rows = [];
    for (di = 0; di < source.docs.count(); di = di + 1) {
        toks = this.tokenize.tokens(source.docs[di]);
        for (i = 0; i < toks.count(); i = i + 1) {
            if (toks[i] != target) continue;
            start = i - win;
            if (start < 0) start = 0;
            end = i + win;
            if (end > toks.count() - 1) end = toks.count() - 1;

            left = [];
            for (j = start; j < i; j = j + 1) left.add(toks[j]);
            right = [];
            for (j = i + 1; j <= end; j = j + 1) right.add(toks[j]);

            context = "[" + toks[i] + "]";
            leftText = this.joinWords(left);
            rightText = this.joinWords(right);
            if (left.count() > 0) context = leftText + " " + context;
            if (right.count() > 0) context = context + " " + rightText;

            leftImmediate = left.count() > 0 ? left[left.count() - 1] : "";
            rightImmediate = right.count() > 0 ? right[0] : "";
            rows.add({
                docIndex: di,
                position: i,
                left: leftText,
                match: toks[i],
                right: rightText,
                context: context,
                leftTokens: left,
                rightTokens: right,
                leftImmediate: leftImmediate,
                rightImmediate: rightImmediate
            });
        }
    }
    return rows;
}

contextTokensFromKwicRow = func(row) {
    tokens = [];
    for (i = 0; i < row.leftTokens.count(); i = i + 1) tokens.add(row.leftTokens[i]);
    for (i = 0; i < row.rightTokens.count(); i = i + 1) tokens.add(row.rightTokens[i]);
    return tokens;
}

groupKwicRows = func(rows, keyName) {
    groups = {};
    for (i = 0; i < rows.count(); i = i + 1) {
        row = rows[i];
        key = row[keyName];
        if (!defined(groups[key])) {
            groups[key] = {
                key: key,
                count: 0,
                docCount: 0,
                docs: {},
                examples: []
            };
        }
        groups[key].count = groups[key].count + 1;
        docKey = stringify(row.docIndex);
        if (!defined(groups[key].docs[docKey])) {
            groups[key].docs[docKey] = true;
            groups[key].docCount = groups[key].docCount + 1;
        }
        if (groups[key].examples.count() < 3) groups[key].examples.add(row);
    }

    out = [];
    foreach(key in groups.props) {
        out.add({
            key: key,
            count: groups[key].count,
            docCount: groups[key].docCount,
            examples: groups[key].examples
        });
    }
    return this.scoreRows(out, "count");
}

featureRowsFromCounts = func(counts) {
    rows = [];
    foreach(word in counts.props) rows.add({word: word, count: counts[word]});
    return this.scoreRows(rows, "count");
}

segments = func(textOrList) {
    source = this.asCorpus(textOrList);
    rows = [];
    for (di = 0; di < source.docs.count(); di = di + 1) {
        text = stringify(source.docs[di]);
        current = "";
        localIndex = 0;
        for (i = 0; i < text.length; i = i + 1) {
            ch = text[i];
            isBoundary = ch == "." || ch == "!" || ch == "?" || ch == ";" || ch == "\n" ||
                         ch == "。" || ch == "！" || ch == "？" || ch == "；";
            if (isBoundary) {
                toks = this.tokenize.tokens(current);
                if (toks.count() > 0) {
                    rows.add({docIndex: di, segmentIndex: localIndex, text: current, tokens: toks});
                    localIndex = localIndex + 1;
                }
                current = "";
            } else {
                current = current + ch;
            }
        }

        tail = this.tokenize.tokens(current);
        if (tail.count() > 0) rows.add({docIndex: di, segmentIndex: localIndex, text: current, tokens: tail});
    }
    return rows;
}

keywordRowsForTokens = func(tokens, docFreq, corpusDocs) {
    countsInfo = this.countsFromTokens(tokens);
    rows = [];
    foreach(word in countsInfo.counts.props) {
        count = countsInfo.counts[word];
        tf = countsInfo.total > 0 ? count / countsInfo.total : 0;
        df = defined(docFreq[word]) ? docFreq[word] : 0;
        idf = (corpusDocs + 1) / (df + 1);
        score = tf * idf;
        rows.add({word: word, count: count, tf: tf, df: df, idf: idf, score: score});
    }
    return this.scoreRows(rows, "score");
}

// Build a corpus from one string or list of strings.
from = func(textOrList) {
    docs = [];
    if (!defined(textOrList) || textOrList == null) return {docs: docs};
    if (defined(textOrList.count)) {
        for (i = 0; i < textOrList.count(); i = i + 1) docs.add(stringify(textOrList[i]));
    } else {
        docs.add(stringify(textOrList));
    }
    return {docs: docs};
}

// Token counts over the whole corpus.
wordCounts = func(corpus) {
    source = this.asCorpus(corpus);
    counts = {};
    total = 0;
    for (di = 0; di < source.docs.count(); di = di + 1) {
        toks = this.tokenize.tokens(source.docs[di]);
        for (ti = 0; ti < toks.count(); ti = ti + 1) {
            w = toks[ti];
            if (!defined(counts[w])) counts[w] = 0;
            counts[w] = counts[w] + 1;
            total = total + 1;
        }
    }
    return {counts: counts, total: total};
}

tfidf = func(corpus) {
    source = this.asCorpus(corpus);
    docFreq = this.documentFrequencies(source);
    tokenLists = this.tokenRows(source);
    aggregate = {};
    perDoc = [];

    for (di = 0; di < tokenLists.count(); di = di + 1) {
        keywordRows = this.keywordRowsForTokens(tokenLists[di], docFreq, source.docs.count());
        perDoc.add({docIndex: di, totalTerms: tokenLists[di].count(), keywords: keywordRows});

        for (ki = 0; ki < keywordRows.count(); ki = ki + 1) {
            row = keywordRows[ki];
            if (!defined(aggregate[row.word])) {
                aggregate[row.word] = {
                    word: row.word,
                    docFrequency: row.df,
                    idf: row.idf,
                    totalCount: 0,
                    totalScore: 0,
                    maxScore: 0,
                    docCount: 0
                };
            }

            aggregate[row.word].totalCount = aggregate[row.word].totalCount + row.count;
            aggregate[row.word].totalScore = aggregate[row.word].totalScore + row.score;
            aggregate[row.word].docCount = aggregate[row.word].docCount + 1;
            if (row.score > aggregate[row.word].maxScore) aggregate[row.word].maxScore = row.score;
        }
    }

    words = [];
    foreach(word in aggregate.props) {
        item = aggregate[word];
        avgScore = item.docCount > 0 ? item.totalScore / item.docCount : 0;
        words.add({
            word: item.word,
            docFrequency: item.docFrequency,
            idf: item.idf,
            totalCount: item.totalCount,
            avgScore: avgScore,
            maxScore: item.maxScore
        });
    }

    return {
        docs: source.docs.count(),
        vocabulary: words.count(),
        words: this.scoreRows(words, "avgScore"),
        perDoc: perDoc
    };
}

keywords = func(docOrIndex, corpusOrTextList, limit) {
    source = this.asCorpus(corpusOrTextList);
    docFreq = this.documentFrequencies(source);
    tokens = [];

    if (defined(docOrIndex) && type(docOrIndex).typename == "Number") {
        index = docOrIndex;
        if (index < 0 || index >= source.docs.count()) return [];
        tokens = this.tokenize.tokens(source.docs[index]);
    } else {
        tokens = this.tokenize.tokens(docOrIndex);
    }

    ranked = this.keywordRowsForTokens(tokens, docFreq, source.docs.count());
    return this.topRows(ranked, defined(limit) ? limit : 10);
}

// Sorted list of [{word, count, ratio}] descending by frequency.
rankedWords = func(corpus) {
    wc = this.wordCounts(corpus);
    rows = [];
    foreach(word in wc.counts.props) {
        c = wc.counts[word];
        ratio = wc.total > 0 ? c / wc.total : 0;
        rows.add({word: word, count: c, ratio: ratio});
    }
    return this.utils.sortByNumberDesc(rows, "count");
}

leadingWords = func(corpus, n) {
    limit = defined(n) ? n : 10;
    ranked = this.rankedWords(corpus);
    out = [];
    for (i = 0; i < ranked.count() && i < limit; i = i + 1) out.add(ranked[i]);
    return out;
}

tailWords = func(corpus, n) {
    limit = defined(n) ? n : 10;
    ranked = this.rankedWords(corpus);
    // Ascending by count for tail extraction.
    ranked = ranked.sort(func(ai, av, bi, bv) => av.count - bv.count);
    out = [];
    for (i = 0; i < ranked.count() && i < limit; i = i + 1) out.add(ranked[i]);
    return out;
}

// Bigram counts: pairs of adjacent words.
bigrams = func(corpus) {
    return this.ngrams(corpus, 2);
}

ngrams = func(corpus, n) {
    source = this.asCorpus(corpus);
    size = defined(n) ? n : 2;
    if (size < 1) size = 1;

    counts = {};
    for (di = 0; di < source.docs.count(); di = di + 1) {
        toks = this.tokenize.tokens(source.docs[di]);
        if (toks.count() < size) continue;
        for (i = 0; i + size - 1 < toks.count(); i = i + 1) {
            parts = [];
            j = 0;
            while (j < size) {
                parts.add(toks[i + j]);
                j = j + 1;
            }
            key = this.joinWords(parts);
            if (!defined(counts[key])) counts[key] = 0;
            counts[key] = counts[key] + 1;
        }
    }

    out = [];
    foreach(k in counts.props) {
        if (size == 2) out.add({pair: k, phrase: k, count: counts[k], n: size});
        else out.add({phrase: k, count: counts[k], n: size});
    }
    return this.scoreRows(out, "count");
}

collocations = func(corpus, n, limit, minCount) {
    source = this.asCorpus(corpus);
    size = defined(n) ? n : 2;
    minN = defined(minCount) ? minCount : 2;
    counts = this.ngrams(source, size);
    wc = this.wordCounts(source);
    totalWindows = 0;
    for (di = 0; di < source.docs.count(); di = di + 1) {
        toks = this.tokenize.tokens(source.docs[di]);
        if (toks.count() >= size) totalWindows = totalWindows + (toks.count() - size + 1);
    }

    rows = [];
    for (i = 0; i < counts.count(); i = i + 1) {
        row = counts[i];
        if (row.count < minN) continue;
        words = this.tokenize.tokens(row.phrase);
        expected = totalWindows;
        for (wi = 0; wi < words.count(); wi = wi + 1) {
            tokenCount = defined(wc.counts[words[wi]]) ? wc.counts[words[wi]] : 0;
            tokenProb = wc.total > 0 ? tokenCount / wc.total : 0;
            expected = expected * tokenProb;
        }
        association = expected > 0 ? row.count / expected : row.count;
        rows.add({
            phrase: row.phrase,
            count: row.count,
            n: size,
            expected: expected,
            score: association
        });
    }

    ranked = this.scoreRows(rows, "score");
    return this.topRows(ranked, defined(limit) ? limit : 10);
}

// Convenience: accept raw text or list and return bigrams directly.
bigramsFrom = func(textOrList) {
    corpus = this.from(textOrList);
    return this.bigrams(corpus);
}

ngramsFrom = func(textOrList, n) {
    corpus = this.from(textOrList);
    return this.ngrams(corpus, n);
}

// Co-occurrence across a context window.
// For each token, count how often another token appears within +/- window.
coOccurrence = func(corpus, windowSize) {
    win = defined(windowSize) ? windowSize : 2;
    if (win < 1) win = 1;

    matrix = {};
    for (di = 0; di < corpus.docs.count(); di = di + 1) {
        toks = this.tokenize.tokens(corpus.docs[di]);
        for (i = 0; i < toks.count(); i = i + 1) {
            w = toks[i];
            if (!defined(matrix[w])) matrix[w] = {};
            start = i - win;
            if (start < 0) start = 0;
            end = i + win;
            if (end > toks.count() - 1) end = toks.count() - 1;

            for (j = start; j <= end; j = j + 1) {
                if (j == i) continue;
                c = toks[j];
                if (!defined(matrix[w][c])) matrix[w][c] = 0;
                matrix[w][c] = matrix[w][c] + 1;
            }
        }
    }

    return matrix;
}

// Ranked co-occurrence neighbors for a target word.
neighbors = func(corpus, word, limit, windowSize) {
    n = defined(limit) ? limit : 10;
    w = this.tokenize.toLowerText(word);
    matrix = this.coOccurrence(corpus, windowSize);
    if (!defined(matrix[w])) return [];

    out = [];
    foreach(other in matrix[w].props) {
        out.add({word: other, count: matrix[w][other]});
    }
    out = this.utils.sortByNumberDesc(out, "count");

    top = [];
    for (i = 0; i < out.count() && i < n; i = i + 1) top.add(out[i]);
    return top;
}

kwic = func(corpus, word, windowSize, limit) {
    maxRows = defined(limit) ? limit : 20;
    rows = this.kwicRows(corpus, word, windowSize);
    return this.topRows(rows, maxRows);
}

kwicSorted = func(corpus, word, windowSize, limit, side) {
    key = defined(side) && side != null ? side : "left";
    rows = this.kwicRows(corpus, word, windowSize);
    if (key != "right" && key != "context") key = "left";
    sorted = this.sortRowsByText(rows, key);
    return this.topRows(sorted, defined(limit) ? limit : 20);
}

kwicGroups = func(corpus, word, windowSize, limit, side) {
    key = defined(side) && side != null ? side : "context";
    if (key != "left" && key != "right" && key != "context") key = "context";
    rows = this.kwicRows(corpus, word, windowSize);
    grouped = this.groupKwicRows(rows, key);
    return this.topRows(grouped, defined(limit) ? limit : 10);
}

concordance = func(corpus, word, windowSize, limit) {
    rows = this.kwicRows(corpus, word, windowSize);
    groupedContext = this.groupKwicRows(rows, "context");
    groupedLeft = this.groupKwicRows(rows, "left");
    groupedRight = this.groupKwicRows(rows, "right");

    return {
        word: this.tokenize.toLowerText(word),
        totalMatches: rows.count(),
        contexts: this.topRows(groupedContext, defined(limit) ? limit : 10),
        leftContexts: this.topRows(groupedLeft, defined(limit) ? limit : 10),
        rightContexts: this.topRows(groupedRight, defined(limit) ? limit : 10)
    };
}

collocates = func(corpus, word, windowSize, limit) {
    rows = this.kwicRows(corpus, word, windowSize);
    leftCounts = {};
    leftWeighted = {};
    rightCounts = {};
    rightWeighted = {};
    bothCounts = {};
    bothWeighted = {};

    for (ri = 0; ri < rows.count(); ri = ri + 1) {
        row = rows[ri];

        for (i = 0; i < row.leftTokens.count(); i = i + 1) {
            tok = row.leftTokens[i];
            dist = row.leftTokens.count() - i;
            if (!defined(leftCounts[tok])) leftCounts[tok] = 0;
            if (!defined(leftWeighted[tok])) leftWeighted[tok] = 0;
            if (!defined(bothCounts[tok])) bothCounts[tok] = 0;
            if (!defined(bothWeighted[tok])) bothWeighted[tok] = 0;
            leftCounts[tok] = leftCounts[tok] + 1;
            leftWeighted[tok] = leftWeighted[tok] + (1 / dist);
            bothCounts[tok] = bothCounts[tok] + 1;
            bothWeighted[tok] = bothWeighted[tok] + (1 / dist);
        }

        for (i = 0; i < row.rightTokens.count(); i = i + 1) {
            tok = row.rightTokens[i];
            dist = i + 1;
            if (!defined(rightCounts[tok])) rightCounts[tok] = 0;
            if (!defined(rightWeighted[tok])) rightWeighted[tok] = 0;
            if (!defined(bothCounts[tok])) bothCounts[tok] = 0;
            if (!defined(bothWeighted[tok])) bothWeighted[tok] = 0;
            rightCounts[tok] = rightCounts[tok] + 1;
            rightWeighted[tok] = rightWeighted[tok] + (1 / dist);
            bothCounts[tok] = bothCounts[tok] + 1;
            bothWeighted[tok] = bothWeighted[tok] + (1 / dist);
        }
    }

    toRows = func(counts, weighted) {
        out = [];
        foreach(tok in counts.props) {
            out.add({word: tok, count: counts[tok], score: weighted[tok]});
        }
        return this.scoreRows(out, "score");
    };

    maxRows = defined(limit) ? limit : 10;
    return {
        word: this.tokenize.toLowerText(word),
        totalMatches: rows.count(),
        left: this.topRows(toRows(leftCounts, leftWeighted), maxRows),
        right: this.topRows(toRows(rightCounts, rightWeighted), maxRows),
        both: this.topRows(toRows(bothCounts, bothWeighted), maxRows)
    };
}

contextClusters = func(corpus, word, windowSize, limit) {
    rows = this.kwicRows(corpus, word, windowSize);
    clusters = [];

    for (ri = 0; ri < rows.count(); ri = ri + 1) {
        row = rows[ri];
        tokens = this.uniqueWords(this.contextTokensFromKwicRow(row));
        bestIndex = -1;
        bestScore = 0;

        for (ci = 0; ci < clusters.count(); ci = ci + 1) {
            shared = 0;
            for (ti = 0; ti < tokens.count(); ti = ti + 1) {
                tok = tokens[ti];
                if (defined(clusters[ci].tokenCounts[tok])) shared = shared + 1;
            }
            overlap = tokens.count() > 0 ? shared / tokens.count() : 0;
            if (overlap > bestScore) {
                bestScore = overlap;
                bestIndex = ci;
            }
        }

        if (bestIndex < 0 || bestScore < 0.5) {
            clusters.add({members: [], tokenCounts: {}});
            bestIndex = clusters.count() - 1;
        }

        clusters[bestIndex].members.add(row);
        for (ti = 0; ti < tokens.count(); ti = ti + 1) {
            tok = tokens[ti];
            if (!defined(clusters[bestIndex].tokenCounts[tok])) clusters[bestIndex].tokenCounts[tok] = 0;
            clusters[bestIndex].tokenCounts[tok] = clusters[bestIndex].tokenCounts[tok] + 1;
        }
    }

    out = [];
    for (ci = 0; ci < clusters.count(); ci = ci + 1) {
        features = this.featureRowsFromCounts(clusters[ci].tokenCounts);
        labelTokens = [];
        for (fi = 0; fi < features.count() && fi < 3; fi = fi + 1) labelTokens.add(features[fi].word);
        out.add({
            cluster: ci,
            label: this.joinWords(labelTokens),
            count: clusters[ci].members.count(),
            features: this.topRows(features, 5),
            examples: this.topRows(clusters[ci].members, 3)
        });
    }

    ranked = this.scoreRows(out, "count");
    return this.topRows(ranked, defined(limit) ? limit : 10);
}

// Simple string similarity (normalized Levenshtein, range [0, 1]).
levenshteinDistance = func(a, b) {
    s1 = this.tokenize.toLowerText(a);
    s2 = this.tokenize.toLowerText(b);
    m = s1.length;
    n = s2.length;

    if (m == 0) return n;
    if (n == 0) return m;

    prev = [];
    curr = [];
    for (j = 0; j <= n; j = j + 1) prev.add(j);

    for (i = 1; i <= m; i = i + 1) {
        curr = [i];
        c1 = s1[i - 1];
        for (j = 1; j <= n; j = j + 1) {
            c2 = s2[j - 1];
            cost = c1 == c2 ? 0 : 1;
            del = prev[j] + 1;
            ins = curr[j - 1] + 1;
            sub = prev[j - 1] + cost;
            best = del;
            if (ins < best) best = ins;
            if (sub < best) best = sub;
            curr.add(best);
        }
        prev = curr;
    }

    return prev[n];
}

similarity = func(a, b) {
    s1 = stringify(a);
    s2 = stringify(b);
    maxLen = this.utils.max(s1.length, s2.length);
    if (maxLen == 0) return 1;
    d = this.levenshteinDistance(s1, s2);
    score = 1 - (d / maxLen);
    if (score < 0) score = 0;
    if (score > 1) score = 1;
    return score;
}

// Group words by stem-like prefix (simple heuristic).
// Example: analysis, analyst -> analy
prefixGroups = func(corpus, prefixLen, minGroupSize) {
    pLen = defined(prefixLen) ? prefixLen : 4;
    minN = defined(minGroupSize) ? minGroupSize : 2;
    wc = this.wordCounts(corpus);

    groups = {};
    foreach(word in wc.counts.props) {
        if (word.length < pLen) continue;
        stem = substring(word, 0, pLen);
        if (!defined(groups[stem])) groups[stem] = [];
        groups[stem].add({word: word, count: wc.counts[word]});
    }

    out = [];
    foreach(stem in groups.props) {
        if (groups[stem].count() < minN) continue;
        members = this.utils.sortByNumberDesc(groups[stem], "count");
        total = 0;
        for (i = 0; i < members.count(); i = i + 1) total = total + members[i].count;
        out.add({group: stem, total: total, words: members});
    }

    out = this.utils.sortByNumberDesc(out, "total");
    return out;
}

// Convenience: accept raw text or list and return prefix-based stubs directly.
stubsFrom = func(textOrList, prefixLen, minGroupSize) {
    corpus = this.from(textOrList);
    pLen = defined(prefixLen) ? prefixLen : 4;
    minN = defined(minGroupSize) ? minGroupSize : 2;
    return this.prefixGroups(corpus, pLen, minN);
}

compare = func(leftTextOrCorpus, rightTextOrCorpus, limit) {
    leftCorpus = this.asCorpus(leftTextOrCorpus);
    rightCorpus = this.asCorpus(rightTextOrCorpus);
    leftCounts = this.wordCounts(leftCorpus);
    rightCounts = this.wordCounts(rightCorpus);
    maxRows = defined(limit) ? limit : 10;

    vocab = {};
    foreach(word in leftCounts.counts.props) vocab[word] = true;
    foreach(word in rightCounts.counts.props) vocab[word] = true;
    vocabSize = vocab.props.count();

    leftRows = [];
    rightRows = [];
    shared = [];
    foreach(word in vocab.props) {
        countA = defined(leftCounts.counts[word]) ? leftCounts.counts[word] : 0;
        countB = defined(rightCounts.counts[word]) ? rightCounts.counts[word] : 0;
        ratioA = (countA + 1) / (leftCounts.total + vocabSize);
        ratioB = (countB + 1) / (rightCounts.total + vocabSize);

        if (countA > 0) {
            leftRows.add({
                word: word,
                countA: countA,
                countB: countB,
                ratioA: ratioA,
                ratioB: ratioB,
                score: ratioA / ratioB
            });
        }
        if (countB > 0) {
            rightRows.add({
                word: word,
                countA: countA,
                countB: countB,
                ratioA: ratioA,
                ratioB: ratioB,
                score: ratioB / ratioA
            });
        }
        if (countA > 0 && countB > 0) {
            shared.add({word: word, countA: countA, countB: countB, sharedCount: this.utils.min(countA, countB)});
        }
    }

    return {
        left: {tokens: leftCounts.total, uniqueWords: leftCounts.counts.props.count()},
        right: {tokens: rightCounts.total, uniqueWords: rightCounts.counts.props.count()},
        distinctiveLeft: this.topRows(this.scoreRows(leftRows, "score"), maxRows),
        distinctiveRight: this.topRows(this.scoreRows(rightRows, "score"), maxRows),
        shared: this.topRows(this.scoreRows(shared, "sharedCount"), maxRows)
    };
}

dispersion = func(corpus, word) {
    source = this.asCorpus(corpus);
    target = this.tokenize.toLowerText(word);
    docRows = [];
    totalCount = 0;
    docsWithWord = 0;
    maxDocCount = 0;

    for (di = 0; di < source.docs.count(); di = di + 1) {
        toks = this.tokenize.tokens(source.docs[di]);
        count = 0;
        for (ti = 0; ti < toks.count(); ti = ti + 1) if (toks[ti] == target) count = count + 1;
        if (count > 0) docsWithWord = docsWithWord + 1;
        if (count > maxDocCount) maxDocCount = count;
        totalCount = totalCount + count;
        docRows.add({docIndex: di, count: count, ratio: toks.count() > 0 ? count / toks.count() : 0});
    }

    segmentRows = [];
    segs = this.segments(source);
    segmentsWithWord = 0;
    for (si = 0; si < segs.count(); si = si + 1) {
        count = 0;
        toks = segs[si].tokens;
        for (ti = 0; ti < toks.count(); ti = ti + 1) if (toks[ti] == target) count = count + 1;
        if (count > 0) segmentsWithWord = segmentsWithWord + 1;
        segmentRows.add({
            docIndex: segs[si].docIndex,
            segmentIndex: segs[si].segmentIndex,
            count: count,
            ratio: toks.count() > 0 ? count / toks.count() : 0
        });
    }

    return {
        word: target,
        totalCount: totalCount,
        docs: source.docs.count(),
        docsWithWord: docsWithWord,
        docRatio: source.docs.count() > 0 ? docsWithWord / source.docs.count() : 0,
        concentration: totalCount > 0 ? maxDocCount / totalCount : 0,
        segments: segs.count(),
        segmentsWithWord: segmentsWithWord,
        segmentRatio: segs.count() > 0 ? segmentsWithWord / segs.count() : 0,
        byDoc: docRows,
        bySegment: segmentRows
    };
}

// Full report bundling core metrics.
report = func(textOrList, config) {
    cfg = defined(config) && config != null ? config : {};
    topN = defined(cfg.topN) ? cfg.topN : 10;
    tailN = defined(cfg.tailN) ? cfg.tailN : 10;
    windowSize = defined(cfg.windowSize) ? cfg.windowSize : 2;
    prefixLen = defined(cfg.prefixLen) ? cfg.prefixLen : 4;
    keywordN = defined(cfg.keywordN) ? cfg.keywordN : topN;
    ngramSize = defined(cfg.ngramSize) ? cfg.ngramSize : 3;

    corpus = this.from(textOrList);
    wc = this.wordCounts(corpus);
    tfidfRows = this.tfidf(corpus);

    return {
        docs: corpus.docs.count(),
        tokens: wc.total,
        uniqueWords: wc.counts.props.count(),
        leadingWords: this.leadingWords(corpus, topN),
        tailWords: this.tailWords(corpus, tailN),
        bigrams: this.bigrams(corpus),
        ngrams: this.ngrams(corpus, ngramSize),
        collocations: this.collocations(corpus, 2, topN, 2),
        coOccurrence: this.coOccurrence(corpus, windowSize),
        groups: this.prefixGroups(corpus, prefixLen, 2),
        tfidf: tfidfRows,
        keywords: tfidfRows.perDoc.count() > 0 ? this.topRows(tfidfRows.perDoc[0].keywords, keywordN) : []
    };
}
