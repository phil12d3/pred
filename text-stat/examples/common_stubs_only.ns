ts = import("./text-stat.ns");

// Focused example: pass text in, get a list of stubs out.
// In text-stat this is done with stubsFrom(text, prefixLen, minGroupSize).
// Example: analysis, analyst, analytics share stub "anal" with prefixLen=4.

text = [
    "analysis analyst analytics analyze",
    "report reports reporting reporter",
    "validation validate validator"
];

// prefixLen controls how many leading characters define the stub.
// minGroupSize requires at least this many words in a stub group.
stubs = ts.stats.stubsFrom(text, 4, 2);

printline("=== Common Stubs Only Example ===");
printline("Note: each group is a common prefix and its member words.");
printline("Raw list output:");
printraw(stubs);

printline("");
printline("Readable detail:");
for (i = 0; i < stubs.count(); i = i + 1) {
    g = stubs[i];
    printline("  stub=", g.group, " total=", g.total, " members=", g.words.count());
    for (j = 0; j < g.words.count(); j = j + 1) {
        w = g.words[j];
        printline("    - ", w.word, " (", w.count, ")");
    }
}

printline("");
printline("Note: increase prefixLen for stricter stubs, decrease for broader grouping.");
