genetic = import("./genetic.ns");

// Calibrate a compact demand forecast:
// forecast = base + trend*week + promoLift*promo + priceSensitivity*(price - 10)
//
// The optimiser finds parameters that minimize mean absolute error against
// observed weekly sales. This is the kind of calibration loop you can wrap
// around a simulator, forecast model, trading rule, controller, or policy.

rows = [
    {week: 1, price: 10.0, promo: 0, sales: 121},
    {week: 2, price: 10.2, promo: 0, sales: 123},
    {week: 3, price: 9.8,  promo: 1, sales: 148},
    {week: 4, price: 10.4, promo: 0, sales: 124},
    {week: 5, price: 10.0, promo: 1, sales: 154},
    {week: 6, price: 10.5, promo: 0, sales: 126},
    {week: 7, price: 9.7,  promo: 1, sales: 163},
    {week: 8, price: 10.8, promo: 0, sales: 126},
    {week: 9, price: 10.1, promo: 0, sales: 135},
    {week: 10, price: 9.9, promo: 1, sales: 171}
];

predictSales = func(params, row) {
    base = params[0];
    trend = params[1];
    promoLift = params[2];
    priceSensitivity = params[3];
    return base + (trend * row.week) + (promoLift * row.promo) + (priceSensitivity * (row.price - 10));
};

fitness = func(values, ctx) {
    totalAbsError = 0;
    for (i = 0; i < rows.count(); i = i + 1) {
        predicted = predictSales(values, rows[i]);
        diff = predicted - rows[i].sales;
        if (diff < 0) diff = 0 - diff;
        totalAbsError = totalAbsError + diff;
    }
    return totalAbsError / rows.count();
};

result = genetic.de.optimize(fitness, [
    {min: 80, max: 160},    // base demand
    {min: -2, max: 6},      // weekly trend
    {min: 0, max: 60},      // promo lift
    {min: -80, max: 20}     // price sensitivity
], {
    populationSize: 48,
    generations: 120,
    mutationFactor: 0.75,
    crossoverRate: 0.9,
    seed: 23,
    threads: 4
});

best = result.best.values;

printline("Mean absolute error: ", stringify(result.best.score));
printline("base demand: ", stringify(best[0]));
printline("weekly trend: ", stringify(best[1]));
printline("promo lift: ", stringify(best[2]));
printline("price sensitivity: ", stringify(best[3]));
printline("");
printline("Observed vs calibrated forecast");
for (i = 0; i < rows.count(); i = i + 1) {
    forecast = predictSales(best, rows[i]);
    printline("week ", stringify(rows[i].week), " actual=", stringify(rows[i].sales), " forecast=", stringify(forecast), " promo=", stringify(rows[i].promo), " price=", stringify(rows[i].price));
}
