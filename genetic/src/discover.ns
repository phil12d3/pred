// Symbolic algorithm discovery for mathematical and logical expression trees.
// Fitness functions receive a program plus a tool object that can run and render it.

utils = import("./src/utils.ns");

defaultConfig = func() {
    return {
        mode: "minimize",
        populationSize: 32,
        generations: 80,
        maxDepth: 4,
        mutationRate: 0.35,
        crossoverRate: 0.5,
        tournamentSize: 3,
        elitism: true,
        seed: 42,
        variables: ["x"],
        constants: [-2, -1, 0, 1, 2],
        operatorPreset: "all",
        operators: null,
        seedPrograms: [],
        seedCombinationOperators: [],
        threads: 1,
        keepHistory: true
    };
};

operatorPresets = func() {
    return {
        math: ["add", "sub", "mul", "div", "min", "max", "abs", "neg"],
        compare: ["gt", "lt", "eq", "min", "max"],
        logic: ["gt", "lt", "eq", "and", "or", "not", "if"],
        rules: ["gt", "lt", "eq", "and", "or", "if"],
        arithmeticRules: ["add", "sub", "mul", "div", "gt", "lt", "eq", "and", "or", "if"],
        all: ["add", "sub", "mul", "div", "min", "max", "abs", "neg", "gt", "lt", "eq", "and", "or", "not", "if"]
    };
};

copyOperators = func(values) {
    out = [];
    if (!defined(values) || values == null) return out;
    for (i = 0; i < values.count(); i = i + 1) out.add(values[i]);
    return out;
};

resolveOperators = func(config) {
    if (defined(config.operators)) {
        if (config.operators != null) return this.copyOperators(config.operators);
    }
    presets = this.operatorPresets();
    name = defined(config.operatorPreset) ? config.operatorPreset : "all";
    if (defined(presets[name])) return this.copyOperators(presets[name]);
    return this.copyOperators(presets.all);
};

prepareConfig = func(config) {
    cfg = this.utils.mergeConfig(this.defaultConfig(), config);
    cfg.operators = this.resolveOperators(cfg);
    return cfg;
};

arity = func(op) {
    if (op == "abs" || op == "neg" || op == "not") return 1;
    if (op == "if") return 3;
    return 2;
};

isTruthy = func(value) {
    if (type(value).typename == "Number") return value != 0;
    return value ? true : false;
};

safeDiv = func(a, b) {
    if (b > -0.000001 && b < 0.000001) return 0;
    return a / b;
};

evalNode = func(node, vars) {
    if (!defined(node) || node == null) return 0;
    if (node.kind == "const") return node.value;
    if (node.kind == "var") {
        if (defined(vars[node.name])) return vars[node.name];
        return 0;
    }

    op = node.op;
    args = node.args;
    a = args.count() > 0 ? this.evalNode(args[0], vars) : 0;
    b = args.count() > 1 ? this.evalNode(args[1], vars) : 0;
    c = args.count() > 2 ? this.evalNode(args[2], vars) : 0;

    if (op == "add") return a + b;
    if (op == "sub") return a - b;
    if (op == "mul") return a * b;
    if (op == "div") return this.safeDiv(a, b);
    if (op == "min") return a < b ? a : b;
    if (op == "max") return a > b ? a : b;
    if (op == "abs") return this.utils.abs(a);
    if (op == "neg") return 0 - a;
    if (op == "gt") return a > b ? 1 : 0;
    if (op == "lt") return a < b ? 1 : 0;
    if (op == "eq") return this.utils.abs(a - b) < 0.000001 ? 1 : 0;
    if (op == "and") return this.isTruthy(a) && this.isTruthy(b) ? 1 : 0;
    if (op == "or") return this.isTruthy(a) || this.isTruthy(b) ? 1 : 0;
    if (op == "not") return this.isTruthy(a) ? 0 : 1;
    if (op == "if") return this.isTruthy(a) ? b : c;
    return 0;
};

run = func(program, vars) {
    return this.evalNode(program, vars);
};

programToText = func(node) {
    if (!defined(node) || node == null) return "0";
    if (node.kind == "const") return stringify(node.value);
    if (node.kind == "var") return node.name;
    op = node.op;
    args = node.args;
    if (op == "abs" || op == "neg" || op == "not") return op + "(" + this.programToText(args[0]) + ")";
    if (op == "if") return "if(" + this.programToText(args[0]) + ", " + this.programToText(args[1]) + ", " + this.programToText(args[2]) + ")";
    return "(" + this.programToText(args[0]) + " " + op + " " + this.programToText(args[1]) + ")";
};

programFrom = func(value) {
    if (!defined(value) || value == null) return null;
    if (defined(value.kind)) return value;
    if (defined(value.best) && value.best != null && defined(value.best["program"])) return value.best["program"];
    if (defined(value["program"])) return value["program"];
    return value;
};

operatorSymbol = func(op) {
    if (op == "add") return "+";
    if (op == "sub") return "-";
    if (op == "mul") return "*";
    if (op == "div") return "/";
    if (op == "gt") return ">";
    if (op == "lt") return "<";
    if (op == "eq") return "==";
    if (op == "and") return "and";
    if (op == "or") return "or";
    return op;
};

constantValue = func(node) {
    node = this.programFrom(node);
    unknown = {known: false, value: 0};
    if (!defined(node) || node == null) return {known: true, value: 0};
    if (node.kind == "const") return {known: true, value: node.value};
    if (node.kind == "var") return unknown;

    op = node.op;
    args = node.args;
    a = args.count() > 0 ? this.constantValue(args[0]) : {known: true, value: 0};
    b = args.count() > 1 ? this.constantValue(args[1]) : {known: true, value: 0};
    c = args.count() > 2 ? this.constantValue(args[2]) : {known: true, value: 0};

    if (op == "or") {
        if (a.known && this.isTruthy(a.value)) return {known: true, value: 1};
        if (b.known && this.isTruthy(b.value)) return {known: true, value: 1};
        if (a.known && b.known) return {known: true, value: 0};
        return unknown;
    }
    if (op == "and") {
        if (a.known && !this.isTruthy(a.value)) return {known: true, value: 0};
        if (b.known && !this.isTruthy(b.value)) return {known: true, value: 0};
        if (a.known && b.known) return {known: true, value: 1};
        return unknown;
    }
    if (op == "not") {
        if (a.known) return {known: true, value: this.isTruthy(a.value) ? 0 : 1};
        return unknown;
    }
    if (op == "if") {
        if (a.known) return this.isTruthy(a.value) ? b : c;
        return unknown;
    }
    if (!a.known || (this.arity(op) > 1 && !b.known)) return unknown;

    if (op == "add") return {known: true, value: a.value + b.value};
    if (op == "sub") return {known: true, value: a.value - b.value};
    if (op == "mul") return {known: true, value: a.value * b.value};
    if (op == "div") return {known: true, value: this.safeDiv(a.value, b.value)};
    if (op == "min") return {known: true, value: a.value < b.value ? a.value : b.value};
    if (op == "max") return {known: true, value: a.value > b.value ? a.value : b.value};
    if (op == "abs") return {known: true, value: this.utils.abs(a.value)};
    if (op == "neg") return {known: true, value: 0 - a.value};
    if (op == "gt") return {known: true, value: a.value > b.value ? 1 : 0};
    if (op == "lt") return {known: true, value: a.value < b.value ? 1 : 0};
    if (op == "eq") return {known: true, value: this.utils.abs(a.value - b.value) < 0.000001 ? 1 : 0};
    return unknown;
};

programToHumanExpression = func(node) {
    node = this.programFrom(node);
    folded = this.constantValue(node);
    if (folded.known) return stringify(folded.value);
    if (!defined(node) || node == null) return "0";
    if (node.kind == "const") return stringify(node.value);
    if (node.kind == "var") return node.name;

    op = node.op;
    args = node.args;
    if (op == "abs") return "absolute value of " + this.programToHumanExpression(args[0]);
    if (op == "neg") return "negative " + this.programToHumanExpression(args[0]);
    if (op == "not") return "not (" + this.programToHumanExpression(args[0]) + ")";
    if (op == "min") return "the smaller of " + this.programToHumanExpression(args[0]) + " and " + this.programToHumanExpression(args[1]);
    if (op == "max") return "the larger of " + this.programToHumanExpression(args[0]) + " and " + this.programToHumanExpression(args[1]);
    if (op == "if") return "if " + this.programToHumanExpression(args[0]) + " then " + this.programToHumanExpression(args[1]) + " else " + this.programToHumanExpression(args[2]);
    if (op == "gt" || op == "lt") {
        left = this.constantValue(args[0]);
        right = this.constantValue(args[1]);
        if (left.known && !right.known) {
            flipped = op == "gt" ? "<" : ">";
            return "(" + this.programToHumanExpression(args[1]) + " " + flipped + " " + stringify(left.value) + ")";
        }
        if (!left.known && right.known) {
            return "(" + this.programToHumanExpression(args[0]) + " " + this.operatorSymbol(op) + " " + stringify(right.value) + ")";
        }
    }
    return "(" + this.programToHumanExpression(args[0]) + " " + this.operatorSymbol(op) + " " + this.programToHumanExpression(args[1]) + ")";
};

formatAlgorithm = func(value) {
    return "return " + this.programToHumanExpression(value);
};

nodeCount = func(node) {
    if (!defined(node) || node == null) return 0;
    if (node.kind != "op") return 1;
    total = 1;
    for (i = 0; i < node.args.count(); i = i + 1) total = total + this.nodeCount(node.args[i]);
    return total;
};

cloneNode = func(node) {
    if (node.kind == "const") return {kind: "const", value: node.value};
    if (node.kind == "var") return {kind: "var", name: node.name};
    args = [];
    for (i = 0; i < node.args.count(); i = i + 1) args.add(this.cloneNode(node.args[i]));
    return {kind: "op", op: node.op, args: args};
};

randomLeaf = func(config, seed) {
    rnd = this.utils.nextRandom(seed);
    seed = rnd.seed;
    if (rnd.value < 0.5 && config.variables.count() > 0) {
        pick = this.utils.randomIndex(seed, config.variables.count());
        return {seed: pick.seed, node: {kind: "var", name: config.variables[pick.index]}};
    }
    pickConst = this.utils.randomIndex(seed, config.constants.count());
    return {seed: pickConst.seed, node: {kind: "const", value: config.constants[pickConst.index]}};
};

randomProgram = func(config, depth, seed) {
    if (depth <= 0) return this.randomLeaf(config, seed);
    rnd = this.utils.nextRandom(seed);
    seed = rnd.seed;
    if (rnd.value < 0.35) return this.randomLeaf(config, seed);

    pickOp = this.utils.randomIndex(seed, config.operators.count());
    seed = pickOp.seed;
    op = config.operators[pickOp.index];
    args = [];
    count = this.arity(op);
    for (i = 0; i < count; i = i + 1) {
        child = this.randomProgram(config, depth - 1, seed);
        seed = child.seed;
        args.add(child.node);
    }
    return {seed: seed, node: {kind: "op", op: op, args: args}};
};

mutateNode = func(node, config, depth, seed) {
    rnd = this.utils.nextRandom(seed);
    seed = rnd.seed;
    if (rnd.value < config.mutationRate) return this.randomProgram(config, depth, seed);

    if (node.kind != "op" || node.args.count() == 0) return {seed: seed, node: this.cloneNode(node)};
    copy = this.cloneNode(node);
    pick = this.utils.randomIndex(seed, copy.args.count());
    seed = pick.seed;
    mutated = this.mutateNode(copy.args[pick.index], config, depth - 1, seed);
    seed = mutated.seed;
    copy.args[pick.index] = mutated.node;
    return {seed: seed, node: copy};
};

crossover = func(a, b, config, seed) {
    rnd = this.utils.nextRandom(seed);
    seed = rnd.seed;
    if (rnd.value > config.crossoverRate) return {seed: seed, node: this.cloneNode(a)};
    if (a.kind != "op" || a.args.count() == 0) return {seed: seed, node: this.cloneNode(b)};

    copy = this.cloneNode(a);
    pick = this.utils.randomIndex(seed, copy.args.count());
    seed = pick.seed;
    copy.args[pick.index] = this.cloneNode(b);
    return {seed: seed, node: copy};
};

toolkit = func() {
    self = this;
    return {
        run: func(program, vars) { return self.evalNode(program, vars); },
        text: func(program) { return self.programToText(program); },
        human: func(program) { return self.formatAlgorithm(program); },
        nodeCount: func(program) { return self.nodeCount(program); }
    };
};

scoreProgram = func(program, fitness, config, generation) {
    self = this;
    tools = {
        run: func(p, vars) { return self.evalNode(p, vars); },
        text: func(p) { return self.programToText(p); },
        human: func(p) { return self.formatAlgorithm(p); },
        nodeCount: func(p) { return self.nodeCount(p); }
    };
    result = fitness(program, tools, {generation: generation, threads: config.threads});
    return this.utils.scoreValue(result);
};

bestOf = func(population, mode) {
    best = null;
    for (i = 0; i < population.count(); i = i + 1) {
        row = population[i];
        if (best == null || this.utils.isBetter(row.score, best.score, mode)) {
            best = {program: this.cloneNode(row.program), score: row.score, text: this.programToText(row.program)};
        }
    }
    return best;
};

selectParent = func(population, mode, tournamentSize, seed) {
    size = tournamentSize;
    if (!defined(size) || size < 1) size = 1;
    best = null;
    currentSeed = seed;
    for (i = 0; i < size; i = i + 1) {
        pick = this.utils.randomIndex(currentSeed, population.count());
        currentSeed = pick.seed;
        row = population[pick.index];
        if (best == null || this.utils.isBetter(row.score, best.score, mode)) best = row;
    }
    return {seed: currentSeed, parent: best};
};

evolve = func(fitness, config) {
    cfg = this.prepareConfig(config);
    population = [];
    seed = cfg.seed;
    if (defined(cfg.seedPrograms) && cfg.seedPrograms != null) {
        for (i = 0; i < cfg.seedPrograms.count() && population.count() < cfg.populationSize; i = i + 1) {
            seeded = this.cloneNode(cfg.seedPrograms[i]);
            score = this.scoreProgram(seeded, fitness, cfg, 0);
            population.add({program: seeded, score: score});
        }
        if (defined(cfg.seedCombinationOperators) && cfg.seedCombinationOperators != null) {
            for (opIndex = 0; opIndex < cfg.seedCombinationOperators.count() && population.count() < cfg.populationSize; opIndex = opIndex + 1) {
                op = cfg.seedCombinationOperators[opIndex];
                for (leftIndex = 0; leftIndex < cfg.seedPrograms.count() && population.count() < cfg.populationSize; leftIndex = leftIndex + 1) {
                    for (rightIndex = leftIndex + 1; rightIndex < cfg.seedPrograms.count() && population.count() < cfg.populationSize; rightIndex = rightIndex + 1) {
                        combined = {kind: "op", op: op, args: [this.cloneNode(cfg.seedPrograms[leftIndex]), this.cloneNode(cfg.seedPrograms[rightIndex])]};
                        score = this.scoreProgram(combined, fitness, cfg, 0);
                        population.add({program: combined, score: score});
                    }
                }
            }
        }
    }
    while (population.count() < cfg.populationSize) {
        generated = this.randomProgram(cfg, cfg.maxDepth, seed);
        seed = generated.seed;
        score = this.scoreProgram(generated.node, fitness, cfg, 0);
        population.add({program: generated.node, score: score});
    }

    best = this.bestOf(population, cfg.mode);
    history = [];
    if (cfg.keepHistory) history.add({generation: 0, score: best.score, text: best.text});

    for (g = 1; g <= cfg.generations; g = g + 1) {
        next = [];
        if (cfg.elitism) next.add({program: this.cloneNode(best.program), score: best.score});
        while (next.count() < cfg.populationSize) {
            aPick = this.selectParent(population, cfg.mode, cfg.tournamentSize, seed);
            seed = aPick.seed;
            bPick = this.selectParent(population, cfg.mode, cfg.tournamentSize, seed);
            seed = bPick.seed;
            crossed = this.crossover(aPick.parent.program, bPick.parent.program, cfg, seed);
            seed = crossed.seed;
            mutated = this.mutateNode(crossed.node, cfg, cfg.maxDepth, seed);
            seed = mutated.seed;
            score = this.scoreProgram(mutated.node, fitness, cfg, g);
            parent = aPick.parent;
            if (this.utils.isBetter(score, parent.score, cfg.mode)) next.add({program: mutated.node, score: score});
            else next.add(parent);
        }
        population = next;
        currentBest = this.bestOf(population, cfg.mode);
        if (this.utils.isBetter(currentBest.score, best.score, cfg.mode)) best = currentBest;
        if (cfg.keepHistory) history.add({generation: g, score: best.score, text: best.text});
    }

    return {
        mode: "discovery",
        best: best,
        population: population,
        history: history,
        config: cfg,
        seed: seed
    };
};

discover = func(fitness, config) {
    return this.evolve(fitness, config);
};
