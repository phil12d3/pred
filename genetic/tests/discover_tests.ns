[test]
expression_runtime_handles_math_and_logic = func(t) {
    discovery = import("./src/discover.ns");
    program = {
        kind: "op",
        op: "if",
        args: [
            {kind: "op", op: "gt", args: [{kind: "var", name: "x"}, {kind: "const", value: 0}]},
            {kind: "op", op: "mul", args: [{kind: "var", name: "x"}, {kind: "var", name: "x"}]},
            {kind: "const", value: 0}
        ]
    };

    t.equal(discovery.run(program, {x: 3}), 9, "positive branch evaluates math expression");
    t.equal(discovery.run(program, {x: -3}), 0, "negative branch evaluates logic expression");
    t.truthy(discovery.programToText(program).length > 0, "program renders to text");
    t.equal(discovery.formatAlgorithm(program), "return if (x > 0) then (x * x) else 0", "program renders in human readable form");
    t.equal(discovery.toolkit().human(program), "return if (x > 0) then (x * x) else 0", "toolkit exposes human readable rendering");
    t.equal(discovery.nodeCount(program), 8, "program node count includes ops and leaves");
};

[test]
algorithm_discovery_returns_executable_program = func(t) {
    discovery = import("./src/discover.ns");
    rows = [
        {x: -2, y: 4},
        {x: -1, y: 1},
        {x: 0, y: 0},
        {x: 1, y: 1},
        {x: 2, y: 4}
    ];

    fitness = func(program, tools, ctx) {
        err = 0;
        for (rowIndex = 0; rowIndex < rows.count(); rowIndex = rowIndex + 1) {
            pred = tools.run(program, {x: rows[rowIndex].x});
            diff = pred - rows[rowIndex].y;
            if (diff < 0) diff = 0 - diff;
            err = err + diff;
        }
        return err;
    };

    result = discovery.evolve(fitness, {
        populationSize: 24,
        generations: 20,
        maxDepth: 3,
        seed: 4,
        variables: ["x"],
        constants: [-2, -1, 0, 1, 2],
        operators: ["add", "sub", "mul", "abs", "neg", "min", "max"]
    });

    value = discovery.run(result.best.program, {x: 2});
    t.truthy(type(value).typename == "Number", "discovered program is executable");
    t.truthy(result.best.text.length > 0, "discovered program renders to text");
    t.truthy(discovery.formatAlgorithm(result).length > 0, "discovered result renders in human readable form");
    t.truthy(result.history.count() == 21, "discovery tracks best history");
};

[test]
rule_beam_composes_predicates_beyond_atomic_plateaus = func(t) {
    discovery = import("./src/discover.ns");
    rows = [
        {tickets: 0, daysIdle: 1, escalated: 0},
        {tickets: 1, daysIdle: 2, escalated: 0},
        {tickets: 2, daysIdle: 3, escalated: 0},
        {tickets: 3, daysIdle: 8, escalated: 1},
        {tickets: 1, daysIdle: 9, escalated: 1},
        {tickets: 2, daysIdle: 10, escalated: 1},
        {tickets: 0, daysIdle: 12, escalated: 0}
    ];

    fitness = func(program, tools, ctx) {
        mistakes = 0;
        for (rowIndex = 0; rowIndex < rows.count(); rowIndex = rowIndex + 1) {
            predicted = tools.run(program, rows[rowIndex]) >= 0.5 ? 1 : 0;
            if (predicted != rows[rowIndex].escalated) mistakes = mistakes + 1;
        }
        return mistakes;
    };

    result = discovery.evolve(fitness, {
        searchStrategy: "beam",
        beamWidth: 4,
        maxDepth: 3,
        variables: ["tickets", "daysIdle"],
        comparisonOperators: ["gt"],
        constants: [0, 1, 2, 7],
        operatorPreset: "rules"
    });

    t.equal(result.best.score, 0, "beam rule discovery composes predicates to clear the plateau");
    t.truthy(discovery.nodeCount(result.best.program) > 3, "best beam rule is composed, not only an atomic predicate");
};

[test]
umbrella_run_supports_discovery_mode = func(t) {
    genetic = import("./genetic.ns");
    fitness = func(program, tools, ctx) {
        return tools.run(program, {x: 1}) == 1 ? 0 : 1;
    };

    result = genetic.run(fitness, {
        variables: ["x"],
        constants: [0, 1],
        comparisonOperators: ["gt"]
    }, {
        searchMode: "discovery",
        searchStrategy: "beam",
        beamWidth: 2,
        maxDepth: 1,
        operatorPreset: "rules"
    });

    t.equal(result.mode, "discovery", "umbrella run dispatches discovery mode");
    t.truthy(defined(genetic.discovery), "umbrella exports discovery module without builtin name collision");
};
