tokenize = import("./src/tokenize.ns");
stats = import("./src/stats.ns");
semantic = import("./src/semantic.ns");

defaultConfig = func() {
    return {
        topicLimit: 3,
        parentTopicLimit: 4,
        parentDepth: 2,
        relationLimit: 4,
        evidenceLimit: 4,
        vocabLimit: 200,
        fuzzyThreshold: 0.82,
        intentRules: [],
        intentLabels: {
            capability_of: "capability_check",
            attribute_of: "attribute_query",
            category_of: "define",
            compare_topics: "compare",
            related_to: "relation_query",
            explain_topic: "explain"
        }
    };
}

asText = func(value) {
    if (!defined(value) || value == null) return "";
    if (type(value).typename == "String") return value;
    return stringify(value);
}

cleanText = func(text) {
    s = this.asText(text);
    if (s.length >= 2 && s[0] == "\"" && s[s.length - 1] == "\"") {
        out = "";
        for (i = 1; i < s.length - 1; i = i + 1) out = out + s[i];
        return out;
    }
    return s;
}

joinTokens = func(tokens, limit, separator) {
    sep = defined(separator) ? separator : " ";
    maxItems = defined(limit) ? limit : tokens.count();
    text = "";
    for (i = 0; i < tokens.count() && i < maxItems; i = i + 1) {
        if (i > 0) text = text + sep;
        text = text + tokens[i];
    }
    return text;
}

copyArray = func(values) {
    out = [];
    if (!defined(values) || values == null) return out;
    for (i = 0; i < values.count(); i = i + 1) out.add(values[i]);
    return out;
}

normalizeCorpusInput = func(corpusInput) {
    docs = [];
    if (!defined(corpusInput) || corpusInput == null) return docs;
    if (defined(corpusInput.count) && type(corpusInput).typename != "String") {
        for (i = 0; i < corpusInput.count(); i = i + 1) docs.add(this.cleanText(corpusInput[i]));
        return docs;
    }

    text = this.cleanText(corpusInput);
    lines = this.tokenize.lines(text);
    nonEmpty = [];
    for (i = 0; i < lines.count(); i = i + 1) {
        line = this.cleanText(lines[i]);
        if (this.tokenize.tokens(line).count() == 0) continue;
        nonEmpty.add(line);
    }
    if (nonEmpty.count() > 1) return nonEmpty;
    docs.add(text);
    return docs;
}

segmentRows = func(docs) {
    corpus = this.stats.from(docs);
    rows = this.stats.segments(corpus);
    if (rows.count() > 0) return rows;

    fallback = [];
    for (i = 0; i < docs.count(); i = i + 1) {
        toks = this.tokenize.tokens(docs[i]);
        if (toks.count() == 0) continue;
        fallback.add({docIndex: i, segmentIndex: 0, text: this.cleanText(docs[i]), tokens: toks});
    }
    return fallback;
}

addWeight = func(map, key, amount) {
    if (!defined(key) || key == "") return false;
    if (!defined(map[key])) map[key] = 0;
    map[key] = map[key] + amount;
    return true;
}

arrayContains = func(values, target) {
    for (i = 0; i < values.count(); i = i + 1) {
        if (values[i] == target) return true;
    }
    return false;
}

keywordMap = func(keywordRows) {
    map = {};
    for (i = 0; i < keywordRows.count(); i = i + 1) map[keywordRows[i].word] = keywordRows[i].score;
    return map;
}

topWordsFromMap = func(weights, limit) {
    rows = [];
    foreach(word in weights.props) rows.add({word: word, score: weights[word]});
    rows = rows.sort(func(indexA, itemA, indexB, itemB) => itemB.score - itemA.score);
    out = [];
    for (i = 0; i < rows.count() && i < limit; i = i + 1) out.add(rows[i].word);
    return out;
}

countMap = func(values) {
    map = {};
    for (i = 0; i < values.count(); i = i + 1) {
        key = values[i];
        if (!defined(map[key])) map[key] = 0;
        map[key] = map[key] + 1;
    }
    return map;
}

ruleValueList = func(value) {
    out = [];
    if (!defined(value) || value == null) return out;
    if (type(value).typename == "String") {
        out.add(value);
        return out;
    }
    if (!defined(value.count)) return out;
    for (i = 0; i < value.count(); i = i + 1) out.add(value[i]);
    return out;
}

ruleWordSet = func(rows) {
    set = {};
    for (i = 0; i < rows.count(); i = i + 1) {
        if (defined(rows[i].word)) set[rows[i].word] = true;
        if (defined(rows[i].corpusWord)) set[rows[i].corpusWord] = true;
    }
    return set;
}

normalizeRuleItem = func(item) {
    if (type(item).typename == "String") {
        return {kind: "word", value: item};
    }
    return item;
}

matchRuleItem = func(item, token, context) {
    rule = this.normalizeRuleItem(item);
    if (!defined(rule.kind)) {
        if (defined(rule.value)) return token == rule.value;
        return false;
    }
    if (rule.kind == "any") return true;
    if (rule.kind == "word") return token == rule.value;
    if (rule.kind == "oneOf") {
        words = this.ruleValueList(rule.words);
        for (i = 0; i < words.count(); i = i + 1) {
            if (token == words[i]) return true;
        }
        return false;
    }
    if (rule.kind == "topic") return defined(context.topicSet[token]);
    if (rule.kind == "parentTopic") return defined(context.parentTopicSet[token]);
    return false;
}

matchRuleSequenceAt = func(tokens, pattern, tokenIndex, patternIndex, context) {
    if (patternIndex >= pattern.count()) return true;
    item = this.normalizeRuleItem(pattern[patternIndex]);

    if (defined(item.kind) && item.kind == "wildcard") {
        for (i = tokenIndex; i <= tokens.count(); i = i + 1) {
            if (this.matchRuleSequenceAt(tokens, pattern, i, patternIndex + 1, context)) return true;
        }
        return false;
    }

    if (defined(item.kind) && item.kind == "optional") {
        if (this.matchRuleSequenceAt(tokens, pattern, tokenIndex, patternIndex + 1, context)) return true;
        if (tokenIndex < tokens.count() && this.matchRuleItem(item.item, tokens[tokenIndex], context)) {
            return this.matchRuleSequenceAt(tokens, pattern, tokenIndex + 1, patternIndex + 1, context);
        }
        return false;
    }

    for (i = tokenIndex; i < tokens.count(); i = i + 1) {
        if (this.matchRuleItem(item, tokens[i], context)) {
            return this.matchRuleSequenceAt(tokens, pattern, i + 1, patternIndex + 1, context);
        }
    }
    return false;
}

matchRuleSequence = func(tokens, pattern, context) {
    if (!defined(pattern) || pattern == null) return true;
    if (pattern.count() == 0) return true;
    return this.matchRuleSequenceAt(tokens, pattern, 0, 0, context);
}

matchIntentRule = func(rule, inputProfile, topics, parentTopics, relationRequests) {
    if (!defined(rule) || !defined(rule.label)) return null;

    context = {
        topicSet: this.ruleWordSet(topics),
        parentTopicSet: this.ruleWordSet(parentTopics)
    };

    if (defined(rule.containsAny) && rule.containsAny != null) {
        ok = false;
        words = this.ruleValueList(rule.containsAny);
        for (i = 0; i < words.count(); i = i + 1) {
            if (defined(inputProfile.keywordWeights[words[i]]) || this.arrayContains(inputProfile.tokens, words[i])) ok = true;
        }
        if (!ok) return null;
    }

    if (defined(rule.containsAll) && rule.containsAll != null) {
        words = this.ruleValueList(rule.containsAll);
        for (i = 0; i < words.count(); i = i + 1) {
            if (!defined(inputProfile.keywordWeights[words[i]]) && !this.arrayContains(inputProfile.tokens, words[i])) return null;
        }
    }

    if (defined(rule.containsNone) && rule.containsNone != null) {
        words = this.ruleValueList(rule.containsNone);
        for (i = 0; i < words.count(); i = i + 1) {
            if (defined(inputProfile.keywordWeights[words[i]]) || this.arrayContains(inputProfile.tokens, words[i])) return null;
        }
    }

    if (defined(rule.sequence) && rule.sequence != null) {
        if (!this.matchRuleSequence(inputProfile.tokens, rule.sequence, context)) return null;
    }

    if (defined(rule.relationAny) && rule.relationAny != null) {
        relOk = false;
        rels = this.ruleValueList(rule.relationAny);
        for (i = 0; i < relationRequests.count(); i = i + 1) {
            for (j = 0; j < rels.count(); j = j + 1) {
                if (relationRequests[i].relation == rels[j]) relOk = true;
            }
        }
        if (!relOk) return null;
    }

    if (defined(rule.relationAll) && rule.relationAll != null) {
        rels = this.ruleValueList(rule.relationAll);
        for (i = 0; i < rels.count(); i = i + 1) {
            found = false;
            for (j = 0; j < relationRequests.count(); j = j + 1) {
                if (relationRequests[j].relation == rels[i]) found = true;
            }
            if (!found) return null;
        }
    }

    if (defined(rule.topicCountMin) && topics.count() < rule.topicCountMin) return null;
    if (defined(rule.topicCountMax) && topics.count() > rule.topicCountMax) return null;
    if (defined(rule.parentTopicCountMin) && parentTopics.count() < rule.parentTopicCountMin) return null;

    seqLen = defined(rule.sequence) && rule.sequence != null ? rule.sequence.count() : 0;
    relationLen = defined(rule.relationAny) && rule.relationAny != null ? this.ruleValueList(rule.relationAny).count() : 0;
    priority = defined(rule.priority) ? rule.priority : 0;
    score = priority + seqLen + relationLen;
    if (defined(rule.containsAll) && rule.containsAll != null) score = score + this.ruleValueList(rule.containsAll).count();
    if (defined(rule.containsAny) && rule.containsAny != null) score = score + 0.5;

    return {
        label: rule.label,
        score: score,
        priority: priority,
        rule: rule
    };
}

matchIntentRules = func(system, inputProfile, topics, parentTopics, relationRequests) {
    rules = [];
    if (!defined(system.config.intentRules) || system.config.intentRules == null) return rules;
    for (i = 0; i < system.config.intentRules.count(); i = i + 1) {
        match = this.matchIntentRule(system.config.intentRules[i], inputProfile, topics, parentTopics, relationRequests);
        if (defined(match)) rules.add(match);
    }
    rules = rules.sort(func(indexA, itemA, indexB, itemB) => itemB.score - itemA.score);
    return rules;
}

connectorSet = func(corpus) {
    rows = this.semantic.connectors(corpus, 20);
    set = {};
    for (i = 0; i < rows.count(); i = i + 1) set[rows[i].word] = true;
    return set;
}

pairRows = func(segmentRows) {
    rows = [];
    for (i = 0; i < segmentRows.count(); i = i + 1) {
        tokens = segmentRows[i].tokens;
        if (tokens.count() < 2) continue;
        left = tokens[0];
        right = tokens[tokens.count() - 1];
        bridgeTokens = [];
        for (j = 1; j < tokens.count() - 1; j = j + 1) bridgeTokens.add(tokens[j]);
        rows.add({
            left: left,
            right: right,
            bridge: this.joinTokens(bridgeTokens, bridgeTokens.count(), " "),
            bridgeTokens: bridgeTokens,
            text: this.cleanText(segmentRows[i].text),
            docIndex: segmentRows[i].docIndex,
            segmentIndex: segmentRows[i].segmentIndex
        });
    }
    return rows;
}

bridgeKind = func(bridgeRow, leftCounts) {
    rightAsLeft = 0;
    for (i = 0; i < bridgeRow.rightSet.count(); i = i + 1) {
        word = bridgeRow.rightSet[i];
        if (defined(leftCounts[word])) rightAsLeft = rightAsLeft + 1;
    }
    pairCount = bridgeRow.pairs.count();
    uniqueLeft = bridgeRow.leftSet.count();
    uniqueRight = bridgeRow.rightSet.count();
    subjectReuse = uniqueRight > 0 ? rightAsLeft / uniqueRight : 0;
    leftDiversity = pairCount > 0 ? uniqueLeft / pairCount : 0;
    rightDiversity = pairCount > 0 ? uniqueRight / pairCount : 0;

    if (subjectReuse >= 0.34) return "category_of";
    if (pairCount >= 2 && leftDiversity >= 0.75 && rightDiversity >= 0.5) return "capability_of";
    if (pairCount >= 2 && leftDiversity <= 0.5 && rightDiversity >= 0.5 && subjectReuse < 0.2) return "explain_topic";
    if (pairCount == 1 && bridgeRow.bridgeTokens.count() >= 1) return "attribute_of";
    return "related_to";
}

buildBridgeProfiles = func(pairRows) {
    profiles = {};
    leftCounts = {};
    rightCounts = {};

    for (i = 0; i < pairRows.count(); i = i + 1) {
        row = pairRows[i];
        if (!defined(leftCounts[row.left])) leftCounts[row.left] = 0;
        if (!defined(rightCounts[row.right])) rightCounts[row.right] = 0;
        leftCounts[row.left] = leftCounts[row.left] + 1;
        rightCounts[row.right] = rightCounts[row.right] + 1;

        key = row.bridge;
        if (!defined(profiles[key])) {
            profiles[key] = {
                bridge: row.bridge,
                bridgeTokens: row.bridgeTokens,
                pairs: [],
                leftSet: [],
                rightSet: []
            };
        }
        profiles[key].pairs.add(row);
        if (!this.arrayContains(profiles[key].leftSet, row.left)) profiles[key].leftSet.add(row.left);
        if (!this.arrayContains(profiles[key].rightSet, row.right)) profiles[key].rightSet.add(row.right);
    }

    rows = [];
    foreach(key in profiles.props) {
        profile = profiles[key];
        rows.add({
            bridge: profile.bridge,
            bridgeTokens: profile.bridgeTokens,
            pairs: profile.pairs,
            leftSet: profile.leftSet,
            rightSet: profile.rightSet,
            kind: this.bridgeKind(profile, leftCounts),
            pairCount: profile.pairs.count()
        });
    }
    return {
        bridgeProfiles: rows,
        leftCounts: leftCounts,
        rightCounts: rightCounts
    };
}

topicAnchorSet = func(pairRows) {
    set = {};
    for (i = 0; i < pairRows.count(); i = i + 1) {
        set[pairRows[i].left] = true;
        set[pairRows[i].right] = true;
    }
    return set;
}

topicSupportMap = func(pairRows) {
    support = {};
    for (i = 0; i < pairRows.count(); i = i + 1) {
        row = pairRows[i];
        if (!defined(support[row.left])) support[row.left] = {subjectCount: 0, objectCount: 0, pairCount: 0};
        if (!defined(support[row.right])) support[row.right] = {subjectCount: 0, objectCount: 0, pairCount: 0};
        support[row.left].subjectCount = support[row.left].subjectCount + 1;
        support[row.left].pairCount = support[row.left].pairCount + 1;
        support[row.right].objectCount = support[row.right].objectCount + 1;
        support[row.right].pairCount = support[row.right].pairCount + 1;
    }
    return support;
}

buildTopicRows = func(corpus, pairRows, config) {
    ranked = this.stats.rankedWords(corpus);
    anchors = this.topicAnchorSet(pairRows);
    support = this.topicSupportMap(pairRows);
    prelim = [];
    for (i = 0; i < ranked.count() && prelim.count() < config.vocabLimit * 2; i = i + 1) {
        row = ranked[i];
        if (!defined(anchors[row.word])) continue;
        prelim.add({word: row.word, count: row.count, ratio: row.ratio});
    }
    out = [];
    for (i = 0; i < prelim.count() && out.count() < config.vocabLimit; i = i + 1) {
        word = prelim[i].word;
        topicSupport = defined(support[word]) ? support[word] : {subjectCount: 0, objectCount: 0, pairCount: 0};
        out.add({
            word: word,
            count: prelim[i].count,
            ratio: prelim[i].ratio,
            subjectCount: topicSupport.subjectCount,
            objectCount: topicSupport.objectCount,
            pairCount: topicSupport.pairCount
        });
    }
    if (out.count() == 0) return prelim;
    return out;
}

buildSegmentProfiles = func(segmentRows, corpus, config) {
    rows = [];
    for (i = 0; i < segmentRows.count(); i = i + 1) {
        kw = this.stats.keywords(segmentRows[i].text, corpus, config.relationLimit);
        rows.add({
            docIndex: segmentRows[i].docIndex,
            segmentIndex: segmentRows[i].segmentIndex,
            text: this.cleanText(segmentRows[i].text),
            tokens: segmentRows[i].tokens,
            keywordWeights: this.keywordMap(kw)
        });
    }
    return rows;
}

buildInputProfile = func(system, text) {
    tokens = this.tokenize.uniqueTokens(text);
    keywordRows = this.stats.keywords(text, system.corpus, system.config.relationLimit);
    return {
        text: text,
        tokens: tokens,
        keywordRows: keywordRows,
        keywordWeights: this.keywordMap(keywordRows)
    };
}

tokenSimilarity = func(a, b, threshold) {
    if (a == b) return 1;
    sim = this.stats.similarity(a, b);
    return sim >= threshold ? sim : 0;
}

topicScore = func(inputProfile, topicWord, threshold) {
    score = 0;
    exact = false;
    maxFuzzy = 0;
    bestToken = topicWord;

    if (defined(inputProfile.keywordWeights[topicWord])) score = score + (1 + inputProfile.keywordWeights[topicWord]);

    for (i = 0; i < inputProfile.tokens.count(); i = i + 1) {
        tok = inputProfile.tokens[i];
        if (tok == topicWord) {
            exact = true;
            score = score + 2;
            bestToken = tok;
            continue;
        }
        sim = this.tokenSimilarity(tok, topicWord, threshold);
        if (sim > maxFuzzy) {
            maxFuzzy = sim;
            bestToken = tok;
        }
    }

    score = score + maxFuzzy;
    return {score: score, exact: exact, fuzzy: maxFuzzy, bestToken: bestToken};
}

topicSemanticBoost = func(system, topicRow, matchedCorpusWords) {
    boost = 0;
    boost = boost + (topicRow.subjectCount * 0.6) + (topicRow.objectCount * 0.25) + (topicRow.pairCount * 0.15);
    for (i = 0; i < system.pairRows.count(); i = i + 1) {
        row = system.pairRows[i];
        if (row.left != topicRow.word && row.right != topicRow.word) continue;
        other = row.left == topicRow.word ? row.right : row.left;
        if (this.arrayContains(matchedCorpusWords, other)) {
            if (row.left == topicRow.word) boost = boost + 1.5;
            else boost = boost + 0.5;
        }
    }
    return boost;
}

scoreTopics = func(system, inputProfile) {
    rows = [];
    for (i = 0; i < inputProfile.tokens.count(); i = i + 1) {
        token = inputProfile.tokens[i];
        best = null;
        for (j = 0; j < system.topicRows.count(); j = j + 1) {
            topic = system.topicRows[j];
            s = this.topicScore({tokens: [token], keywordWeights: inputProfile.keywordWeights}, topic.word, system.config.fuzzyThreshold);
            if (s.score <= 0) continue;
            row = {
                word: s.bestToken,
                corpusWord: topic.word,
                score: s.score,
                exact: s.exact,
                fuzzy: s.fuzzy,
                count: topic.count
            };
            if (!defined(best) || row.score > best.score) best = row;
        }
        if (defined(best)) rows.add(best);
    }

    matchedCorpusWords = [];
    for (i = 0; i < rows.count(); i = i + 1) {
        if (!this.arrayContains(matchedCorpusWords, rows[i].corpusWord)) matchedCorpusWords.add(rows[i].corpusWord);
    }

    rescored = [];
    for (i = 0; i < rows.count(); i = i + 1) {
        row = rows[i];
        topicRow = null;
        for (j = 0; j < system.topicRows.count(); j = j + 1) {
            if (system.topicRows[j].word == row.corpusWord) topicRow = system.topicRows[j];
        }
        semanticBoost = defined(topicRow) ? this.topicSemanticBoost(system, topicRow, matchedCorpusWords) : 0;
        connectorPenalty = defined(system.connectorWords[row.corpusWord]) ? 1.5 : 0;
        finalScore = row.score + semanticBoost - connectorPenalty;
        if (finalScore <= 0) continue;
        rescored.add({
            word: row.word,
            corpusWord: row.corpusWord,
            score: finalScore,
            lexicalScore: row.score,
            semanticScore: semanticBoost,
            exact: row.exact,
            fuzzy: row.fuzzy,
            count: row.count
        });
    }

    rescored = rescored.sort(func(indexA, itemA, indexB, itemB) => itemB.score - itemA.score);
    out = [];
    seen = {};
    for (i = 0; i < rescored.count() && out.count() < system.config.topicLimit; i = i + 1) {
        if (defined(seen[rescored[i].corpusWord])) continue;
        seen[rescored[i].corpusWord] = true;
        out.add({
            word: rescored[i].word,
            corpusWord: rescored[i].corpusWord,
            score: rescored[i].score,
            lexicalScore: rescored[i].lexicalScore,
            semanticScore: rescored[i].semanticScore,
            exact: rescored[i].exact,
            fuzzy: rescored[i].fuzzy,
            count: rescored[i].count
        });
    }
    return out;
}

filterNonTopicTokens = func(tokens, topics, threshold) {
    out = [];
    for (i = 0; i < tokens.count(); i = i + 1) {
        tok = tokens[i];
        matched = false;
        for (j = 0; j < topics.count(); j = j + 1) {
            if (tok == topics[j].word || tok == topics[j].corpusWord) matched = true;
            else if (this.stats.similarity(tok, topics[j].corpusWord) >= threshold) matched = true;
        }
        if (!matched) out.add(tok);
    }
    return out;
}

relationMatchRows = func(inputTokens, relationRows, threshold) {
    matches = [];
    for (i = 0; i < relationRows.count(); i = i + 1) {
        best = 0;
        for (j = 0; j < inputTokens.count(); j = j + 1) {
            sim = this.tokenSimilarity(inputTokens[j], relationRows[i].word, threshold);
            if (sim > best) best = sim;
        }
        if (best > 0) {
            matches.add({word: relationRows[i].word, relationScore: defined(relationRows[i].score) ? relationRows[i].score : 0, matchScore: best});
        }
    }
    return matches;
}

topTopicRelations = func(system, topicWord) {
    rows = [];
    for (i = 0; i < system.pairRows.count(); i = i + 1) {
        if (system.pairRows[i].left == topicWord || system.pairRows[i].right == topicWord) rows.add(system.pairRows[i]);
    }
    return rows;
}

categoryParentsFor = func(system, topicWord) {
    rows = [];
    for (i = 0; i < system.pairRows.count(); i = i + 1) {
        pair = system.pairRows[i];
        if (pair.left != topicWord) continue;
        profile = system.bridgeMap[pair.bridge];
        if (!defined(profile) || profile.kind != "category_of") continue;
        rows.add({
            word: pair.right,
            via: pair.bridge,
            text: pair.text
        });
    }
    return rows;
}

scoreParentTopics = func(system, topics) {
    rows = [];
    seen = {};

    for (i = 0; i < topics.count(); i = i + 1) {
        base = topics[i];
        frontier = [{
            topicWord: base.corpusWord,
            sourceTopic: base.word,
            sourceCorpusWord: base.corpusWord,
            score: base.score,
            depth: 0
        }];

        while (frontier.count() > 0) {
            current = frontier[0];
            nextFrontier = [];
            for (fi = 1; fi < frontier.count(); fi = fi + 1) nextFrontier.add(frontier[fi]);
            frontier = nextFrontier;
            if (current.depth >= system.config.parentDepth) continue;

            parents = this.categoryParentsFor(system, current.topicWord);
            for (j = 0; j < parents.count(); j = j + 1) {
                parent = parents[j];
                key = current.sourceCorpusWord + "->" + parent.word;
                if (defined(seen[key])) continue;
                seen[key] = true;

                depth = current.depth + 1;
                inheritedScore = current.score / (depth + 1);
                rows.add({
                    word: parent.word,
                    corpusWord: parent.word,
                    fromTopic: current.sourceTopic,
                    fromCorpusWord: current.sourceCorpusWord,
                    via: parent.via,
                    depth: depth,
                    score: inheritedScore,
                    evidenceText: parent.text
                });

                frontier.add({
                    topicWord: parent.word,
                    sourceTopic: current.sourceTopic,
                    sourceCorpusWord: current.sourceCorpusWord,
                    score: inheritedScore,
                    depth: depth
                });
            }
        }
    }

    rows = rows.sort(func(indexA, itemA, indexB, itemB) => itemB.score - itemA.score);
    out = [];
    seenWords = {};
    for (i = 0; i < rows.count() && out.count() < system.config.parentTopicLimit; i = i + 1) {
        if (defined(seenWords[rows[i].corpusWord])) continue;
        topicClash = false;
        for (j = 0; j < topics.count(); j = j + 1) {
            if (topics[j].corpusWord == rows[i].corpusWord) topicClash = true;
        }
        if (topicClash) continue;
        seenWords[rows[i].corpusWord] = true;
        out.add(rows[i]);
    }
    return out;
}

buildRelationRequests = func(system, inputProfile, topics) {
    if (topics.count() == 0) return [];
    nonTopicTokens = this.filterNonTopicTokens(inputProfile.tokens, topics, system.config.fuzzyThreshold);
    requests = [];

    selectedWords = [];
    for (i = 0; i < topics.count(); i = i + 1) selectedWords.add(topics[i].corpusWord);

    for (i = 0; i < system.bridgeProfiles.count(); i = i + 1) {
        profile = system.bridgeProfiles[i];
        bridgeRows = [];
        for (bi = 0; bi < profile.bridgeTokens.count(); bi = bi + 1) bridgeRows.add({word: profile.bridgeTokens[bi], score: 1});
        bridgeMatches = this.relationMatchRows(nonTopicTokens, bridgeRows, system.config.fuzzyThreshold);
        if (bridgeMatches.count() == 0) continue;

        for (j = 0; j < profile.pairs.count(); j = j + 1) {
            pair = profile.pairs[j];
            if (!this.arrayContains(selectedWords, pair.left) && !this.arrayContains(selectedWords, pair.right)) continue;
            topicWord = this.arrayContains(selectedWords, pair.left) ? pair.left : pair.right;
            topicLabel = topicWord;
            for (k = 0; k < topics.count(); k = k + 1) {
                if (topics[k].corpusWord == topicWord) topicLabel = topics[k].word;
            }
            requests.add({
                relation: profile.kind,
                topics: [topicLabel],
                score: bridgeMatches[0].matchScore + profile.pairCount + (this.arrayContains(selectedWords, pair.left) ? 0.5 : 0),
                evidence: [{word: profile.bridge, relationScore: profile.pairCount, matchScore: bridgeMatches[0].matchScore}]
            });
        }
    }

    if (requests.count() == 0 && topics.count() >= 2) {
        for (i = 0; i < system.pairRows.count(); i = i + 1) {
            pair = system.pairRows[i];
            if (!this.arrayContains(selectedWords, pair.left)) continue;
            if (!this.arrayContains(selectedWords, pair.right)) continue;
            profile = system.bridgeMap[pair.bridge];
            requests.add({
                relation: defined(profile) ? profile.kind : "related_to",
                topics: [pair.left],
                score: topics[0].score + topics[1].score + 1,
                evidence: [{word: pair.bridge, relationScore: 1, matchScore: 1}]
            });
        }
    }

    if (requests.count() == 0 && topics.count() >= 2) {
        requests.add({
            relation: "compare_topics",
            topics: [topics[0].word, topics[1].word],
            score: (topics[0].score + topics[1].score) * 0.5,
            evidence: []
        });
    }

    if (requests.count() == 0 && topics.count() == 1) {
        rels = this.topTopicRelations(system, topics[0].corpusWord);
        categoryPairs = [];
        explainPairs = [];
        for (i = 0; i < rels.count(); i = i + 1) {
            profile = system.bridgeMap[rels[i].bridge];
            if (defined(profile) && profile.kind == "category_of" && rels[i].left == topics[0].corpusWord) categoryPairs.add(rels[i]);
            if (defined(profile) && profile.kind == "explain_topic" && rels[i].left == topics[0].corpusWord) explainPairs.add(rels[i]);
        }
        if (categoryPairs.count() > 0) {
            requests.add({
                relation: "category_of",
                topics: [topics[0].word],
                score: topics[0].score,
                evidence: [{word: categoryPairs[0].bridge, relationScore: 1, matchScore: 1}]
            });
        } else if (explainPairs.count() > 0) {
            requests.add({
                relation: "explain_topic",
                topics: [topics[0].word],
                score: topics[0].score,
                evidence: [{word: explainPairs[0].bridge, relationScore: 1, matchScore: 1}]
            });
        } else {
            requests.add({
                relation: "related_to",
                topics: [topics[0].word],
                score: topics[0].score,
                evidence: []
            });
        }
    }

    requests = requests.sort(func(indexA, itemA, indexB, itemB) => itemB.score - itemA.score);
    return requests;
}

intentFromRelations = func(relationRequests) {
    if (relationRequests.count() == 0) return "explore";
    relation = relationRequests[0].relation;
    return relation;
}

intentFromRule = func(ruleMatches) {
    if (!defined(ruleMatches) || ruleMatches == null) return "";
    if (ruleMatches.count() == 0) return "";
    return ruleMatches[0].label;
}

segmentEvidenceScore = func(inputProfile, segmentRow, topicWords, threshold) {
    score = 0;
    overlap = [];

    foreach(word in inputProfile.keywordWeights.props) {
        if (defined(segmentRow.keywordWeights[word])) {
            score = score + inputProfile.keywordWeights[word] + segmentRow.keywordWeights[word];
            overlap.add(word);
        }
    }

    for (i = 0; i < inputProfile.tokens.count(); i = i + 1) {
        tok = inputProfile.tokens[i];
        for (j = 0; j < topicWords.count(); j = j + 1) {
            sim = this.tokenSimilarity(tok, topicWords[j], threshold);
            if (sim > 0) {
                score = score + sim;
                if (!this.arrayContains(overlap, tok)) overlap.add(tok);
            }
        }
    }

    return {score: score, overlap: overlap};
}

topEvidenceSegments = func(system, inputProfile, topics) {
    topicWords = [];
    for (i = 0; i < topics.count(); i = i + 1) topicWords.add(topics[i].word);

    rows = [];
    for (i = 0; i < system.segmentRows.count(); i = i + 1) {
        s = this.segmentEvidenceScore(inputProfile, system.segmentRows[i], topicWords, system.config.fuzzyThreshold);
        if (s.score <= 0) continue;
        rows.add({
            text: system.segmentRows[i].text,
            docIndex: system.segmentRows[i].docIndex,
            segmentIndex: system.segmentRows[i].segmentIndex,
            score: s.score,
            overlap: s.overlap
        });
    }
    rows = rows.sort(func(indexA, itemA, indexB, itemB) => itemB.score - itemA.score);
    out = [];
    for (i = 0; i < rows.count() && i < system.config.evidenceLimit; i = i + 1) out.add(rows[i]);
    return out;
}

parentEvidenceRows = func(parentTopics) {
    out = [];
    for (i = 0; i < parentTopics.count(); i = i + 1) {
        out.add({
            topic: parentTopics[i].word,
            fromTopic: parentTopics[i].fromTopic,
            via: parentTopics[i].via,
            depth: parentTopics[i].depth,
            score: parentTopics[i].score,
            text: parentTopics[i].evidenceText
        });
    }
    return out;
}

train = func(corpusInput, config) {
    cfg = defined(config) ? config : this.defaultConfig();
    docs = this.normalizeCorpusInput(corpusInput);
    corpus = this.stats.from(docs);
    sourceSegments = this.segmentRows(docs);
    pairRows = this.pairRows(sourceSegments);
    pairModel = this.buildBridgeProfiles(pairRows);
    topicRows = this.buildTopicRows(corpus, pairRows, cfg);
    segmentProfiles = this.buildSegmentProfiles(sourceSegments, corpus, cfg);
    bridgeMap = {};
    for (i = 0; i < pairModel.bridgeProfiles.count(); i = i + 1) bridgeMap[pairModel.bridgeProfiles[i].bridge] = pairModel.bridgeProfiles[i];

    return {
        config: cfg,
        docs: docs,
        corpus: corpus,
        connectorWords: this.connectorSet(corpus),
        pairRows: pairRows,
        bridgeProfiles: pairModel.bridgeProfiles,
        bridgeMap: bridgeMap,
        topicRows: topicRows,
        segmentRows: segmentProfiles
    };
}

analyze = func(system, inputText, limit) {
    inputProfile = this.buildInputProfile(system, inputText);
    topics = this.scoreTopics(system, inputProfile);
    parentTopics = this.scoreParentTopics(system, topics);
    relationRequests = this.buildRelationRequests(system, inputProfile, topics);
    ruleMatches = this.matchIntentRules(system, inputProfile, topics, parentTopics, relationRequests);
    evidence = this.topEvidenceSegments(system, inputProfile, topics);
    maxTopics = defined(limit) ? limit : system.config.topicLimit;
    ruleIntent = this.intentFromRule(ruleMatches);
    relationIntent = defined(system.config.intentLabels[this.intentFromRelations(relationRequests)]) ? system.config.intentLabels[this.intentFromRelations(relationRequests)] : "explore";
    finalIntent = ruleIntent != "" ? ruleIntent : relationIntent;

    outTopics = [];
    for (i = 0; i < topics.count() && i < maxTopics; i = i + 1) outTopics.add(topics[i]);

    return {
        input: inputText,
        topics: outTopics,
        parentTopics: parentTopics,
        relationsRequested: relationRequests,
        rulesMatched: ruleMatches,
        matchedRule: ruleMatches.count() > 0 ? ruleMatches[0] : null,
        intent: finalIntent,
        intentSource: ruleIntent != "" ? "rule" : "relation",
        evidence: {
            inputKeywords: inputProfile.keywordRows,
            matchingSegments: evidence,
            parentSegments: this.parentEvidenceRows(parentTopics)
        }
    };
}

responses = func(system, inputText, limit) {
    analysis = this.analyze(system, inputText, limit);
    out = [];
    rows = analysis.evidence.matchingSegments;
    for (i = 0; i < rows.count(); i = i + 1) {
        out.add({
            rank: i + 1,
            score: rows[i].score,
            intent: analysis.intent,
            response: rows[i].text,
            overlap: rows[i].overlap
        });
    }
    return out;
}
