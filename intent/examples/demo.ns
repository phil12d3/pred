intent = import("./intent.ns").intent;

showAnalysis = func(title, result) {
    printline(title);
    printline("Input: ", result.input);
    printline("Intent: ", result.intent);
    printline("Intent Source: ", result.intentSource);
    printline("Matched Rule: ", result.matchedRule);
    printline("Topics: ", result.topics);
    printline("Parent Topics: ", result.parentTopics);
    printline("Relations: ", result.relationsRequested);
    printline("");
}

coreCorpus = "
poodles are dogs
dogs are animals
cats are animals
poodles have curly coats
dogs can swim
birds can fly
";

coreSystem = intent.train(coreCorpus, intent.defaultConfig());

defineResult = intent.analyze(coreSystem, "what is a poodle", 3);
capabilityResult = intent.analyze(coreSystem, "can dogs swim", 3);
attributeResult = intent.analyze(coreSystem, "what do poodles have", 3);

compareCorpus = "
poodles are dogs
cats are animals
";

compareSystem = intent.train(compareCorpus, intent.defaultConfig());
compareResult = intent.analyze(compareSystem, "poodles cats", 3);

relatedCorpus = "
poodles dogs
";

relatedSystem = intent.train(relatedCorpus, intent.defaultConfig());
relatedResult = intent.analyze(relatedSystem, "poodles dogs", 3);

explainCorpus = "
poodles are known for curly coats
poodles are known for intelligence
poodles are known for elegance
";

explainSystem = intent.train(explainCorpus, intent.defaultConfig());
explainResult = intent.analyze(explainSystem, "poodles", 3);

exploreResult = intent.analyze(relatedSystem, "xylophone nebula", 3);

questionConfig = intent.defaultConfig();
questionRule = {
    label: "question",
    priority: 100,
    containsAny: ["what", "how", "why"],
    sequence: [
        {kind: "oneOf", words: ["what", "how", "why"]},
        {kind: "topic"}
    ]
};
questionConfig.intentRules = [questionRule];

questionSystem = intent.train(coreCorpus, questionConfig);
questionResult = intent.analyze(questionSystem, "what is a poodle", 3);

helpConfig = intent.defaultConfig();
helpRule = {
    label: "help",
    priority: 90,
    containsAny: ["help", "support"],
    sequence: [
        {kind: "oneOf", words: ["help", "support"]},
        {kind: "wildcard"},
        {kind: "topic"}
    ]
};
helpConfig.intentRules = [helpRule];

helpSystem = intent.train(coreCorpus, helpConfig);
helpResult = intent.analyze(helpSystem, "help me with poodles", 3);

printline("Intent labels: ", coreSystem.config.intentLabels);
printline("");

showAnalysis("Define example", defineResult);
showAnalysis("Capability example", capabilityResult);
showAnalysis("Attribute example", attributeResult);
showAnalysis("Compare example", compareResult);
showAnalysis("Relation example", relatedResult);
showAnalysis("Explain example", explainResult);
showAnalysis("Question example", questionResult);
showAnalysis("Help example", helpResult);
showAnalysis("Explore example", exploreResult);

printline("Evidence segments for define:");
for (i = 0; i < defineResult.evidence.matchingSegments.count(); i = i + 1) {
    row = defineResult.evidence.matchingSegments[i];
    printline("{i + 1}. score={row.score}  text={row.text}");
    printline("   overlap: {row.overlap}");
}

printline("");
printline("Inherited parent evidence for define:");
for (i = 0; i < defineResult.evidence.parentSegments.count(); i = i + 1) {
    row = defineResult.evidence.parentSegments[i];
    printline("{i + 1}. topic={row.topic} from={row.fromTopic} via={row.via} depth={row.depth} score={row.score}");
    printline("   text={row.text}");
}

printline("");
printline("Explain evidence segments:");
for (i = 0; i < explainResult.evidence.matchingSegments.count(); i = i + 1) {
    row = explainResult.evidence.matchingSegments[i];
    printline("{i + 1}. score={row.score}  text={row.text}");
    printline("   overlap: {row.overlap}");
}

printline("");
printline("Question rule:");
printline("Label: ", questionRule.label);
printline("Priority: ", questionRule.priority);
printline("Cue words: what, how, why");
printline("Sequence: cue word -> topic");

printline("");
printline("Help rule:");
printline("Label: ", helpRule.label);
printline("Priority: ", helpRule.priority);
printline("Cue words: help, support");
printline("Sequence: cue word -> wildcard -> topic");
