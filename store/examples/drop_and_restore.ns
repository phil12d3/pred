store = import("./store.ns").store;

s = store.create();
s = store.put(s, "history", {rows: 4});
s = store.put(s, "forecast", {A: 8});
s = store.put(s, "drift", {flagged: 1});

trimmed = store.drop(s, "history");
snapshot = store.snapshot(trimmed);
restored = store.restore(snapshot);

printline("After drop:");
for (i = 0; i < trimmed.entries.count(); i = i + 1) {
    entry = trimmed.entries[i];
    printline(i, " | ", entry.key, " | ", stringify(entry.value));
}

printline("");
printline("Restored entries:");
for (i = 0; i < restored.entries.count(); i = i + 1) {
    entry = restored.entries[i];
    printline(i, " | ", entry.key, " | ", stringify(entry.value));
}
