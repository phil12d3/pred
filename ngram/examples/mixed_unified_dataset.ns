pkg = import("./ngram.ns");
ng = pkg.ngram;

model = ng.train([
    "poodles are dogs",
    [1, 2, 3],
    ["hello there", "how are you", "not great", "sorry to hear that"]
], null, {
    order: 3,
    lowercase: true,
    seed: 17
});

textResult = ng.infer(model, "poodles are", {maxSteps: 4, seed: 17});
numberResult = ng.infer(model, [1, 2], {maxSteps: 2, seed: 17});
firstTurn = ng.infer(model, "hello there", {maxSteps: 6, seed: 17});
secondTurn = ng.infer(model, "not great", {state: firstTurn.state, maxSteps: 6});

printline("=== Mixed Unified Dataset ===");
printline("");
printline("text input = poodles are");
printline("text output = ", textResult.output);
printline("");
printline("number input = [1,2]");
printline("number output = ", stringify(numberResult.output));
printline("");
printline("dialogue input 1 = hello there");
printline("dialogue output 1 = ", firstTurn.output);
printline("dialogue input 2 = not great");
printline("dialogue output 2 = ", secondTurn.output);
