[test]
numeric_sequences_train_counts_and_probabilities = func(t) {
    pkg = import("./ngram.ns");
    model = pkg.ngram.train([[1, 2, 3], [1, 2, 4], [1, 2, 3]], 2, {unit: "items", addStopToken: false});

    rows = pkg.ngram.predictNext(model, [1, 2], 5);

    t.equal(model.order, 2, "model stores requested order");
    t.equal(rows.count(), 2, "predictNext returns both observed numeric continuations");
    t.equal(rows[0].value, 3, "most common numeric continuation ranks first");
    t.equal(rows[0].count, 2, "most common numeric continuation count is tracked");
    t.truthy(rows[0].probability > rows[1].probability, "probabilities reflect observed numeric frequency");
};

[test]
generation_uses_backoff_when_full_context_is_missing = func(t) {
    pkg = import("./ngram.ns");
    model = pkg.ngram.train([[1, 2, 3], [1, 2, 4]], 3, {unit: "items", addStopToken: false});

    rows = pkg.ngram.predictNext(model, [9, 1, 2], 5);

    t.equal(rows.count(), 2, "predictNext backs off to the longest known suffix context");
    t.equal(rows[0].order, 2, "backoff reports the matched context length");
};

[test]
character_generation_stops_on_stop_token = func(t) {
    pkg = import("./ngram.ns");
    model = pkg.ngram.train(["abba", "abca"], 2, {unit: "chars", stopToken: "<END>", seed: 7});

    result = pkg.ngram.generate(model, "ab", {maxSteps: 5, seed: 7});

    t.equal(result.reason, "stop_token", "character generation stops when the stop token is chosen");
    t.truthy(result.terminated, "generation marks stop-token termination");
    t.truthy(result.rendered == "abba" || result.rendered == "abca", "generated character text follows learned training paths");
};

[test]
token_mode_supports_text_sequences = func(t) {
    pkg = import("./ngram.ns");
    model = pkg.ngram.train(
        ["red blue stop", "red green stop", "red blue stop"],
        1,
        {unit: "tokens", stopToken: "stop", separator: " "}
    );

    rows = pkg.ngram.predictNext(model, "red", 5);
    result = pkg.ngram.generate(model, "red", {maxSteps: 4, seed: 5, separator: " "});

    t.equal(rows[0].value, "blue", "token mode learns word-level next-token frequencies");
    t.equal(result.reason, "stop_token", "token mode generation respects the configured stop token");
    t.truthy(result.rendered == "red blue" || result.rendered == "red green", "render joins generated token sequences back into text");
};

[test]
generate_returns_state_and_supports_continuation = func(t) {
    pkg = import("./ngram.ns");
    model = pkg.ngram.train(
        [
            "hello there stop",
            "how are you stop"
        ],
        1,
        {unit: "tokens", stopToken: "stop", separator: " ", seed: 11}
    );

    first = pkg.ngram.generate(model, "hello", {maxSteps: 4, seed: 11});
    second = pkg.ngram.generate(model, "how", {state: first.state, maxSteps: 4});
    third = pkg.ngram.resume(model, second.state, "hello", {maxSteps: 4});

    t.equal(first.reason, "stop_token", "first turn stops on the configured stop token");
    t.equal(first.state.kind, "ngram.state", "generate returns a serializable state object");
    t.equal(first.state.stopped, true, "state records whether generation stopped on the stop token");
    t.equal(first.state.history[first.state.history.count() - 1], "stop", "state history preserves the internal stop marker");
    t.equal(second.rendered, "how are you", "continued generation renders only the new visible turn");
    t.equal(second.reason, "stop_token", "continued generation can still terminate on the stop token");
    t.equal(third.rendered, "hello there", "resume alias continues from prior state with a new prompt");
};

[test]
dialogue_reply_uses_turn_boundaries_instead_of_raw_stream_continuation = func(t) {
    pkg = import("./ngram.ns");
    model = pkg.ngram.trainDialogue(
        [
            [
                {user: "hello there", assistant: "how are you"},
                {user: "not great", assistant: "sorry to hear that"}
            ],
            [
                {user: "hello there", assistant: "how are you"},
                {user: "i am great", assistant: "that is good"}
            ]
        ],
        3,
        {seed: 17}
    );

    first = pkg.ngram.reply(model, "hello there", null, {maxSteps: 6, seed: 17});
    second = pkg.ngram.reply(model, "not great", first.state, {maxSteps: 6});

    t.equal(first.rendered, "how are you", "reply generates only the assistant turn");
    t.equal(first.state.kind, "ngram.dialogue.state", "reply returns dialogue-specific state");
    t.equal(second.rendered, "sorry to hear that", "next user turn is interpreted after dialogue markers, not as raw token continuation");
    t.equal(second.reason, "stop_token", "dialogue replies still terminate on the stop token");
};

[test]
plain_and_dialogue_states_can_be_saved_and_loaded = func(t) {
    pkg = import("./ngram.ns");

    plainModel = pkg.ngram.train(
        ["red blue stop", "red green stop"],
        1,
        {unit: "tokens", stopToken: "stop", separator: " ", seed: 9}
    );
    plainResult = pkg.ngram.generate(plainModel, "red", {maxSteps: 4, seed: 9});
    plainPath = "./tmp/plain_state.bin";
    plainSaved = pkg.ngram.saveState(plainResult.state, plainPath);
    plainRestored = pkg.ngram.loadState(plainPath);

    dialogueModel = pkg.ngram.trainDialogue(
        [
            [
                {user: "hello there", assistant: "how are you"},
                {user: "not great", assistant: "sorry to hear that"}
            ]
        ],
        3,
        {seed: 17}
    );
    dialogueResult = pkg.ngram.reply(dialogueModel, "hello there", null, {maxSteps: 6, seed: 17});
    dialoguePath = "./tmp/dialogue_state.bin";
    dialogueSaved = pkg.ngram.saveState(dialogueResult.state, dialoguePath);
    dialogueRestored = pkg.ngram.loadState(dialoguePath);
    resumedDialogue = pkg.ngram.reply(dialogueModel, "not great", dialogueRestored, {maxSteps: 6});

    t.equal(plainSaved.kind, "ngram.saved_state", "saveState wraps plain continuation state");
    t.equal(plainRestored.kind, "ngram.state", "loadState restores plain continuation state");
    t.equal(plainRestored.history[plainRestored.history.count() - 1], "stop", "plain restored state preserves internal stop marker");
    t.equal(dialogueSaved.kind, "ngram.saved_state", "saveState wraps dialogue state");
    t.equal(dialogueRestored.kind, "ngram.dialogue.state", "loadState restores dialogue state");
    t.equal(resumedDialogue.rendered, "sorry to hear that", "restored dialogue state can continue a later reply");
};
