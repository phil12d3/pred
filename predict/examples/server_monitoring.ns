// Server monitoring example.
// Streams: cpu (%), memory (%), requestRate (req/s), errorRate (errors/s), status (ok/warning/critical).
// The system learns when high CPU + high request rate precedes a critical status.

prediction = import("./src/prediction.ns");

rows = [];
rows.add({cpu: 20, memory: 40, requestRate: 100, errorRate: 0, status: "ok"});
rows.add({cpu: 22, memory: 41, requestRate: 105, errorRate: 0, status: "ok"});
rows.add({cpu: 25, memory: 43, requestRate: 120, errorRate: 1, status: "ok"});
rows.add({cpu: 35, memory: 50, requestRate: 200, errorRate: 2, status: "ok"});
rows.add({cpu: 60, memory: 60, requestRate: 400, errorRate: 5, status: "warning"});
rows.add({cpu: 80, memory: 70, requestRate: 600, errorRate: 15, status: "warning"});
rows.add({cpu: 95, memory: 85, requestRate: 800, errorRate: 40, status: "critical"});
rows.add({cpu: 98, memory: 90, requestRate: 750, errorRate: 60, status: "critical"});
rows.add({cpu: 70, memory: 80, requestRate: 400, errorRate: 20, status: "warning"});
rows.add({cpu: 40, memory: 60, requestRate: 200, errorRate: 5, status: "ok"});
rows.add({cpu: 22, memory: 43, requestRate: 110, errorRate: 1, status: "ok"});
rows.add({cpu: 20, memory: 41, requestRate: 100, errorRate: 0, status: "ok"});
rows.add({cpu: 25, memory: 42, requestRate: 130, errorRate: 1, status: "ok"});
rows.add({cpu: 55, memory: 58, requestRate: 380, errorRate: 4, status: "warning"});
rows.add({cpu: 85, memory: 78, requestRate: 700, errorRate: 35, status: "critical"});

streamNames = ["cpu", "memory", "requestRate", "errorRate", "status"];

history = prediction.history.fromRows(streamNames, rows);
system = prediction.predictor.train(history, {
    feature: {lags: 2, rolling: 3, pattern: 2},
    tree: {maxDepth: 3, minSamples: 2}
});

current = prediction.history.window(history, 6);
forecastPredictions = prediction.predictor.predictAll(system, current);
forecastRow = prediction.predictor.rowFromPredictions(system, forecastPredictions);

printline("=== Server Monitoring Predictor ===");
printline("");
printline("Recent history:");
printline("idx | cpu | memory | requestRate | errorRate | status");
for (i = 0; i < current.rows.count(); i = i + 1) {
    row = current.rows[i];
    printline(i, " | ", row.cpu, " | ", row.memory, " | ", row.requestRate, " | ", row.errorRate, " | ", row.status);
}

printline("");
printline("Next state forecast:");
printline("stream | value | support | depth");
summary = prediction.explain.summarizePrediction(forecastPredictions);
for (i = 0; i < summary.count(); i = i + 1) {
    item = summary[i];
    p = forecastPredictions[item.stream];
    printline(item.stream, " | ", item.value, " | ", p.support, " | ", p.depth);
}

printline("");
printline("Counterfactual: what if request rate spikes to 900?");
influence = prediction.predictor.counterfactualInfluence(system, current, {requestRate: 900});
influenceRows = prediction.explain.summarizeInfluence(influence);
for (i = 0; i < influenceRows.count(); i = i + 1) {
    row = influenceRows[i];
    printline("- changing ", row.source, " from ", row.from, " to ", row.to, " most affected ", row.strongestTarget, " by ", row.strongestDelta);
}

printline("");
printline("Backtest (walk-forward):");
printline("stream | type | metric | value | folds");
bt = prediction.backtest.run(streamNames, rows, {
    feature: {lags: 2, rolling: 3, pattern: 2},
    tree: {maxDepth: 3, minSamples: 2}
}, 5, 0);
for (si = 0; si < streamNames.count(); si = si + 1) {
    sname = streamNames[si];
    s = bt.stats[sname];
    if (s.type == "numeric") {
        printline(sname, " | numeric | MAE | ", s.mae, " | ", s.folds);
    } else {
        printline(sname, " | categorical | accuracy | ", s.accuracy, " | ", s.folds);
    }
}
