// IoT machine sensor example.
// Streams: vibration (mm/s), temperature (C), pressure (bar), machineState (normal/warning/fault).
// The system learns that rising vibration and temperature precede fault states.

prediction = import("./src/prediction.ns");

rows = [];
rows.add({vibration: 1.2, temperature: 65,  pressure: 4.0, machineState: "normal"});
rows.add({vibration: 1.3, temperature: 66,  pressure: 4.0, machineState: "normal"});
rows.add({vibration: 1.4, temperature: 67,  pressure: 4.1, machineState: "normal"});
rows.add({vibration: 2.1, temperature: 70,  pressure: 4.2, machineState: "normal"});
rows.add({vibration: 3.5, temperature: 76,  pressure: 4.3, machineState: "warning"});
rows.add({vibration: 5.2, temperature: 84,  pressure: 4.5, machineState: "warning"});
rows.add({vibration: 7.8, temperature: 95,  pressure: 4.8, machineState: "fault"});
rows.add({vibration: 9.1, temperature: 102, pressure: 5.1, machineState: "fault"});
rows.add({vibration: 4.0, temperature: 85,  pressure: 4.4, machineState: "warning"});
rows.add({vibration: 2.0, temperature: 72,  pressure: 4.1, machineState: "normal"});
rows.add({vibration: 1.3, temperature: 66,  pressure: 4.0, machineState: "normal"});
rows.add({vibration: 1.2, temperature: 65,  pressure: 4.0, machineState: "normal"});
rows.add({vibration: 2.3, temperature: 71,  pressure: 4.2, machineState: "normal"});
rows.add({vibration: 4.8, temperature: 82,  pressure: 4.4, machineState: "warning"});
rows.add({vibration: 8.2, temperature: 98,  pressure: 4.9, machineState: "fault"});

streamNames = ["vibration", "temperature", "pressure", "machineState"];

history = prediction.history.fromRows(streamNames, rows);
system = prediction.predictor.train(history, {
    feature: {lags: 2, rolling: 3, pattern: 2},
    tree: {maxDepth: 3, minSamples: 2}
});

current = prediction.history.window(history, 6);
forecast = prediction.predictor.predictNextState(system, current);

printline("=== IoT Machine Sensor Predictor ===");
printline("");
printline("Recent history:");
printline("idx | vibration | temperature | pressure | machineState");
for (i = 0; i < current.rows.count(); i = i + 1) {
    row = current.rows[i];
    printline(i, " | ", row.vibration, " | ", row.temperature, " | ", row.pressure, " | ", row.machineState);
}

printline("");
printline("Next state forecast:");
printline("stream | value | support | depth");
summary = prediction.explain.summarizePrediction(forecast.predictions);
for (i = 0; i < summary.count(); i = i + 1) {
    item = summary[i];
    p = forecast.predictions[item.stream];
    printline(item.stream, " | ", item.value, " | ", p.support, " | ", p.depth);
}
printline("consistency | ", forecast.consistency.score);

printline("");
printline("Counterfactual: what if vibration spikes to 10?");
influence = prediction.predictor.counterfactualInfluence(system, current, {vibration: 10});
influenceRows = prediction.explain.summarizeInfluence(influence);
for (i = 0; i < influenceRows.count(); i = i + 1) {
    row = influenceRows[i];
    printline("- changing ", row.source, " from ", row.from, " to ", row.to, " most affected ", row.strongestTarget, " by ", row.strongestDelta);
}

printline("");
printline("Backtest (walk-forward):");
printline("stream | type | metric | value | folds");
bt = prediction.backtest.run(streamNames, rows, {
    feature: {lags: 2, rolling: 3, pattern: 2},
    tree: {maxDepth: 3, minSamples: 2}
}, 5, 0);
for (si = 0; si < streamNames.count(); si = si + 1) {
    sname = streamNames[si];
    s = bt.stats[sname];
    if (s.type == "numeric") {
        printline(sname, " | numeric | MAE | ", s.mae, " | ", s.folds);
    } else {
        printline(sname, " | categorical | accuracy | ", s.accuracy, " | ", s.folds);
    }
}
