[test]
extracts_lag_delta_and_state_features = func(t) {
    prediction = import("./src/prediction.ns");
    history = prediction.history.fromRows(["A", "C"], [
        {A: 1, C: "off"},
        {A: 3, C: "off"},
        {A: 8, C: "on"}
    ]);

    extracted = prediction.features.extractAt(history, 2, {lags: 2, rolling: 2, pattern: 2}, {});
    t.equal(extracted.values["A.current"], 8, "feature extractor records current numeric values");
    t.equal(extracted.values["A.lag.1"], 3, "feature extractor records lagged values");
    t.equal(extracted.values["A.delta.1"], 5, "feature extractor records deltas");
    t.equal(extracted.values["A.rolling.2"], 5.5, "feature extractor records rolling averages");
    t.equal(extracted.values["C.timeSinceChange"], 1, "feature extractor records time since state change");
};

[test]
predicts_next_values_for_each_stream = func(t) {
    prediction = import("./src/prediction.ns");
    rows = [];
    for (i = 0; i < 20; i = i + 1) {
        rows.add({A: i % 4, B: (i % 4) + 10});
    }
    history = prediction.history.fromRows(["A", "B"], rows);
    system = prediction.predictor.train(history, {feature: {lags: 2, rolling: 2, pattern: 2}, tree: {maxDepth: 4, minSamples: 1}});
    current = prediction.history.window(history, 5);
    predictions = prediction.predictor.predictAll(system, current);

    t.truthy(defined(predictions.A.value), "predictor returns a next value for A");
    t.truthy(defined(predictions.B.value), "predictor returns a next value for B");
    t.truthy(predictions.A.path.count() > 0, "predictor returns decision path explanations");
    t.truthy(predictions.A.support > 0, "predictor returns a support score for the predicted leaf");
};

[test]
predicts_a_next_state_and_cross_checks_it_against_counterfactuals = func(t) {
    prediction = import("./src/prediction.ns");
    rows = [];
    for (i = 0; i < 20; i = i + 1) {
        rows.add({A: i % 4, B: (i % 4) + 10, C: i % 2 == 0 ? "even" : "odd"});
    }
    history = prediction.history.fromRows(["A", "B", "C"], rows);
    system = prediction.predictor.train(history, {feature: {lags: 2, rolling: 2, pattern: 2}, tree: {maxDepth: 4, minSamples: 1}});
    forecast = prediction.predictor.predictNextState(system, prediction.history.window(history, 5));

    t.truthy(defined(forecast.row.A), "next-state prediction returns a row for A");
    t.truthy(defined(forecast.row.B), "next-state prediction returns a row for B");
    t.truthy(defined(forecast.consistency.score), "next-state prediction returns a consistency score");
    t.equal(forecast.consistency.report.count(), 3, "next-state consistency checks every source stream");
    t.equal(forecast.consistency.comparisons, 9, "next-state consistency compares every source against every target");
    t.truthy(forecast.consistency.score >= 0, "consistency score is non-negative");
};

[test]
reports_counterfactual_cross_stream_influence = func(t) {
    prediction = import("./src/prediction.ns");
    rows = [];
    for (i = 0; i < 30; i = i + 1) {
        a = i % 6;
        b = a > 3 ? 20 : 2;
        rows.add({A: a, B: b});
    }
    history = prediction.history.fromRows(["A", "B"], rows);
    system = prediction.predictor.train(history, {feature: {lags: 2, rolling: 2, pattern: 2}, tree: {maxDepth: 4, minSamples: 1}});
    current = prediction.history.window(history, 6);
    influence = prediction.predictor.counterfactualInfluence(system, current, {A: 5});

    t.equal(influence.report.count(), 2, "influence report contains one counterfactual per source stream");
    t.truthy(influence.report[0].effects.count() == 2, "each counterfactual records effects on every target stream");
};
