frameworkModule = import("./tests/framework.ns");
t = frameworkModule.create();

deleteFileIfPresent = func(path) {
    if (!defined(path) || path == "") return false;
    if (!exists(path)) return false;
    try {
        deleteFile(path);
        return true;
    } catch(ex) {
        printline("[tests] Failed to delete file {path}: " + (defined(ex.message) ? ex.message : stringify(ex)));
    }
    return false;
};

deleteFilesRecursively = func(path) {
    if (!defined(path) || path == "") return 0;
    if (!exists(path)) return 0;

    deletedCount = 0;
    try {
        info = directory(path);
        if (defined(info) && info != null) {
            if (defined(info.files)) {
                for (i = 0; i < info.files.count(); i = i + 1) {
                    file = info.files[i];
                    filename = defined(file.filename) ? file.filename : "";
                    if (filename == "") continue;
                    if (deleteFileIfPresent(path + "/" + filename)) deletedCount = deletedCount + 1;
                }
            }
            if (defined(info.directories)) {
                for (i = 0; i < info.directories.count(); i = i + 1) {
                    dir = info.directories[i];
                    dirName = defined(dir.name) ? dir.name : "";
                    if (dirName == "" || dirName == "." || dirName == "..") continue;
                    deletedCount = deletedCount + deleteFilesRecursively(path + "/" + dirName);
                }
            }
        }
    } catch(ex) {
        printline("[tests] Failed to inspect test artifact directory {path}: " + (defined(ex.message) ? ex.message : stringify(ex)));
    }
    return deletedCount;
};

cleanupTestArtifacts = func() {
    deleteFileIfPresent("./tmp/logger-test.log");
    deleteFilesRecursively("./tmp/system_config_tests");
};

collectTests = func(path) {
    results = [];
    info = directory(path);

    for (i = 0; i < info.files.count(); i = i + 1) {
        file = info.files[i];
        filename = defined(file.filename) ? file.filename : "";
        fullPath = path + "/" + filename;
        if (fullPath == "./tests/run_tests.ns") continue;
        if (fullPath == "./tests/framework.ns") continue;
        if (regex_test(filename, "tests\\.ns$")) {
            results.add(fullPath);
        }
    }

    for (i = 0; i < info.directories.count(); i = i + 1) {
        dir = info.directories[i];
        dirName = defined(dir.name) ? dir.name : "";
        if (dirName == "" || dirName == "." || dirName == "..") continue;
        nested = collectTests(path + "/" + dirName);
        for (j = 0; j < nested.count(); j = j + 1) {
            results.add(nested[j]);
        }
    }

    return results;
};

sortStrings = func(values) {
    if (!defined(values) || values.count() <= 1) return values;
    copy = [];
    for (i = 0; i < values.count(); i = i + 1) copy.add(values[i]);
    copy.sort(func(indexA, valueA, indexB, valueB) => valueA < valueB);
    return copy;
};

runAttributedTests = func(path, module) {
    testNames = membersWithAttribute(module, "test");
    if (!defined(testNames) || testNames.count() == 0) {
        t.fail("{path} has no [test] functions");
        return false;
    }

    testNames = sortStrings(testNames);
    for (ti = 0; ti < testNames.count(); ti = ti + 1) {
        name = testNames[ti];
        fn = module[name];
        if (!defined(fn) || type(fn).typename != "Function") {
            t.fail("{path}::{name} is marked [test] but is not a function");
            continue;
        }
        t.runCase(path, name, fn);
    }

    return true;
};

testFiles = sortStrings(collectTests("./tests"));

printline("Running Nova tests");
printline("");

cleanupTestArtifacts();

if (testFiles.count() == 0) {
    printline("No test files found.");
    exit(1);
}

for (i = 0; i < testFiles.count(); i = i + 1) {
    path = testFiles[i];
    t.beginFile(path);
    try {
        module = import(path);
        runAttributedTests(path, module);
    } catch (ex) {
        t.fileError(path, ex);
    }
    printline("");
}

ok = t.summary();
cleanupTestArtifacts();
if (!ok) exit(1);
