utils = import("./src/utils.ns");

topPathFactors = func(prediction, limit) {
    factors = [];
    maxItems = defined(limit) ? limit : 4;
    if (!defined(prediction.path)) return factors;
    for (i = 0; i < prediction.path.count() && i < maxItems; i = i + 1) {
        step = prediction.path[i];
        factors.add({
            feature: step.feature,
            condition: step.value + " " + (step.direction == "left" ? "<= " : "> ") + step.threshold,
            gain: step.gain
        });
    }
    return factors;
}

summarizePrediction = func(predictions) {
    rows = [];
    foreach(stream in predictions.props) {
        rows.add({
            stream: stream,
            value: predictions[stream].value,
            factors: this.topPathFactors(predictions[stream], 3)
        });
    }
    return rows;
}

summarizeInfluence = func(influence) {
    rows = [];
    for (i = 0; i < influence.report.count(); i = i + 1) {
        item = influence.report[i];
        strongestTarget = "none";
        strongestDelta = 0;
        for (j = 0; j < item.effects.count(); j = j + 1) {
            effect = item.effects[j];
            size = this.utils.abs(effect.delta);
            if (size > strongestDelta) {
                strongestDelta = size;
                strongestTarget = effect.target;
            }
        }
        rows.add({
            source: item.source,
            from: item.from,
            to: item.to,
            strongestTarget: strongestTarget,
            strongestDelta: strongestDelta,
            effects: item.effects
        });
    }
    return rows;
}
