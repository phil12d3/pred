[test]
vector_model_predicts_and_has_dimension_importance = func(t) {
    dt = import("./des-tree.ns");

    rows = [
        {dims: [0.1, 0.2, 0.9], target: "alpha"},
        {dims: [0.2, 0.1, 0.8], target: "alpha"},
        {dims: [0.9, 0.8, 0.2], target: "beta"},
        {dims: [0.8, 0.9, 0.1], target: "beta"}
    ];

    system = dt.vectors.train(rows, {maxDepth: 5, minSamples: 1});
    result = dt.vectors.predict(system, [0.85, 0.75, 0.15]);
    imp = dt.vectors.dimensionImportance(system);

    t.truthy(defined(result.value), "vector model returns prediction");
    t.truthy(result.support > 0, "vector model returns support");
    t.truthy(defined(imp), "vector model returns dimension importance map");
};
