// CART decision tree: binary splits, supports both classification and regression.
// Training rows have the shape: { features: { col: value, ... }, target: value }

utils = import("./src/utils.ns");

// ── impurity helpers ───────────────────────────────────────────────────────────

meanTarget = func(rows) {
    total = 0;
    count = 0;
    for (i = 0; i < rows.count(); i = i + 1) {
        if (this.utils.isNumber(rows[i].target)) {
            total = total + rows[i].target;
            count = count + 1;
        }
    }
    if (count == 0) return 0;
    return total / count;
}

majorityTarget = func(rows) {
    counts = {};
    bestValue = null;
    bestCount = -1;
    for (i = 0; i < rows.count(); i = i + 1) {
        key = this.utils.keyOf(rows[i].target);
        if (!defined(counts[key])) counts[key] = 0;
        counts[key] = counts[key] + 1;
        if (counts[key] > bestCount) {
            bestCount = counts[key];
            bestValue = rows[i].target;
        }
    }
    return {value: bestValue, count: bestCount};
}

targetKind = func(rows) {
    for (i = 0; i < rows.count(); i = i + 1) {
        if (!this.utils.isNumber(rows[i].target)) return "classification";
    }
    return "regression";
}

impurity = func(rows, kind) {
    if (rows.count() == 0) return 0;
    if (kind == "regression") {
        mean = this.meanTarget(rows);
        total = 0;
        for (i = 0; i < rows.count(); i = i + 1) {
            d = rows[i].target - mean;
            total = total + d * d;
        }
        return total / rows.count();
    }
    // Gini impurity for classification
    counts = {};
    for (i = 0; i < rows.count(); i = i + 1) {
        key = this.utils.keyOf(rows[i].target);
        if (!defined(counts[key])) counts[key] = 0;
        counts[key] = counts[key] + 1;
    }
    gini = 1;
    foreach(key in counts.props) {
        p = counts[key] / rows.count();
        gini = gini - p * p;
    }
    return gini;
}

classProbabilities = func(rows) {
    counts = {};
    for (i = 0; i < rows.count(); i = i + 1) {
        key = this.utils.keyOf(rows[i].target);
        if (!defined(counts[key])) counts[key] = {label: rows[i].target, n: 0};
        counts[key].n = counts[key].n + 1;
    }
    probs = {};
    total = rows.count();
    foreach(key in counts.props) {
        probs[key] = {label: counts[key].label, probability: counts[key].n / total, count: counts[key].n};
    }
    return probs;
}

// ── splitting ──────────────────────────────────────────────────────────────────

featureNames = func(rows) {
    names = [];
    seen = {};
    for (i = 0; i < rows.count(); i = i + 1) {
        foreach(name in rows[i].features.props) {
            if (defined(seen[name])) continue;
            seen[name] = true;
            names.add(name);
        }
    }
    return names;
}

thresholdsFor = func(rows, feature) {
    values = [];
    for (i = 0; i < rows.count(); i = i + 1) {
        value = this.utils.asNumber(rows[i].features[feature], 0);
        duplicate = false;
        for (j = 0; j < values.count(); j = j + 1) {
            if (values[j] == value) duplicate = true;
        }
        if (!duplicate) values.add(value);
    }
    values = values.sort(func(ai, av, bi, bv) => av - bv);
    thresholds = [];
    for (i = 0; i + 1 < values.count(); i = i + 1) {
        thresholds.add((values[i] + values[i + 1]) / 2);
    }
    return thresholds;
}

splitRows = func(rows, feature, threshold) {
    left = [];
    right = [];
    for (i = 0; i < rows.count(); i = i + 1) {
        value = this.utils.asNumber(rows[i].features[feature], 0);
        if (value <= threshold) left.add(rows[i]);
        else right.add(rows[i]);
    }
    return {left: left, right: right};
}

bestSplit = func(rows, kind) {
    base = this.impurity(rows, kind);
    names = this.featureNames(rows);
    best = {gain: 0, feature: "", threshold: 0, left: [], right: []};

    for (ni = 0; ni < names.count(); ni = ni + 1) {
        name = names[ni];
        thresholds = this.thresholdsFor(rows, name);
        for (ti = 0; ti < thresholds.count(); ti = ti + 1) {
            threshold = thresholds[ti];
            parts = this.splitRows(rows, name, threshold);
            if (parts.left.count() == 0 || parts.right.count() == 0) continue;
            weighted = (parts.left.count() * this.impurity(parts.left, kind) +
                        parts.right.count() * this.impurity(parts.right, kind)) / rows.count();
            gain = base - weighted;
            if (gain > best.gain) {
                best = {gain: gain, feature: name, threshold: threshold,
                        left: parts.left, right: parts.right};
            }
        }
    }
    return best;
}

// ── node builders ──────────────────────────────────────────────────────────────

leaf = func(rows, kind, depth) {
    prediction = kind == "regression" ? this.meanTarget(rows) : this.majorityTarget(rows).value;
    return {
        leaf: true,
        kind: kind,
        depth: depth,
        samples: rows.count(),
        prediction: prediction,
        probabilities: kind == "classification" ? this.classProbabilities(rows) : {}
    };
}

trainNode = func(rows, kind, depth, config) {
    if (rows.count() == 0) return this.leaf(rows, kind, depth);
    maxDepth  = defined(config.maxDepth)  ? config.maxDepth  : 6;
    minSamples = defined(config.minSamples) ? config.minSamples : 2;
    minGain   = defined(config.minGain)   ? config.minGain   : 0.00001;

    if (depth >= maxDepth || rows.count() <= minSamples) return this.leaf(rows, kind, depth);

    split = this.bestSplit(rows, kind);
    if (split.gain <= minGain) return this.leaf(rows, kind, depth);

    return {
        leaf: false,
        kind: kind,
        depth: depth,
        samples: rows.count(),
        prediction: kind == "regression" ? this.meanTarget(rows) : this.majorityTarget(rows).value,
        feature: split.feature,
        threshold: split.threshold,
        gain: split.gain,
        left:  this.trainNode(split.left,  kind, depth + 1, config),
        right: this.trainNode(split.right, kind, depth + 1, config)
    };
}

// ── public API ─────────────────────────────────────────────────────────────────

// Train a CART tree.
// config: { maxDepth, minSamples, minGain }
train = func(trainingRows, config) {
    kind = this.targetKind(trainingRows);
    cfg  = defined(config) ? config : {};
    return {
        kind: kind,
        root: this.trainNode(trainingRows, kind, 0, cfg)
    };
}

predictNode = func(node, features, path) {
    if (node.leaf) {
        return {value: node.prediction, path: path, samples: node.samples,
                depth: node.depth, probabilities: node.probabilities};
    }
    value     = this.utils.asNumber(features[node.feature], 0);
    direction = value <= node.threshold ? "left" : "right";
    path.add({feature: node.feature, value: value,
               threshold: node.threshold, direction: direction, gain: node.gain});
    return this.predictNode(direction == "left" ? node.left : node.right, features, path);
}

// Predict for a single features object.
predict = func(model, features) {
    return this.predictNode(model.root, features, []);
}

// Return a flat list of all leaf nodes (for inspection / coverage analysis).
leaves = func(node, acc) {
    out = defined(acc) ? acc : [];
    if (node.leaf) {
        out.add(node);
        return out;
    }
    this.leaves(node.left, out);
    this.leaves(node.right, out);
    return out;
}

// Count tree depth.
depth = func(node) {
    if (node.leaf) return node.depth;
    ld = this.depth(node.left);
    rd = this.depth(node.right);
    return ld > rd ? ld : rd;
}

// Accumulate gain contributions into totals object (mutates totals).
accumImportance = func(node, totals) {
    if (node.leaf) return;
    contrib = node.gain * node.samples;
    if (!defined(totals[node.feature])) totals[node.feature] = 0;
    totals[node.feature] = totals[node.feature] + contrib;
    this.accumImportance(node.left,  totals);
    this.accumImportance(node.right, totals);
}

// Feature importance: fraction of total gain * samples each feature contributed.
featureImportance = func(model) {
    totals = {};
    this.accumImportance(model.root, totals);
    grand = 0;
    foreach(f in totals.props) grand = grand + totals[f];
    result = {};
    if (grand > 0) {
        foreach(f in totals.props) result[f] = totals[f] / grand;
    }
    return result;
}
